<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_accounting_adjustment" model="ir.sequence">
        <field name="name">Clinic Accounting Adjustment</field>
        <field name="code">clinic.accounting.adjustment</field>
        <field name="prefix">ACC-ADJ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_accounting_close" model="ir.sequence">
        <field name="name">Clinic Accounting Close</field>
        <field name="code">clinic.accounting.close</field>
        <field name="prefix">ACC-CLOSE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_accounting_statement" model="ir.sequence">
        <field name="name">Clinic Accounting Statement</field>
        <field name="code">clinic.accounting.statement</field>
        <field name="prefix">ACC-RPT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
