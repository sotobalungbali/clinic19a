<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_accounting_close_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>ClinicOne Accounting Period Close Evidence</h2>

                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Reference:</strong> <span t-field="o.name"/><br/>
                        <strong>Period Type:</strong> <span t-field="o.period_type"/><br/>
                        <strong>Period:</strong>
                        <span t-field="o.date_from"/> - <span t-field="o.date_to"/>
                    </div>
                    <div class="col-6">
                        <strong>Company:</strong> <span t-field="o.company_id"/><br/>
                        <strong>Status:</strong> <span t-field="o.state"/><br/>
                        <strong>Last Preflight:</strong> <span t-field="o.last_preflight_at"/>
                    </div>
                </div>

                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Check</th>
                            <th>Severity</th>
                            <th>Status</th>
                            <th class="text-end">Records</th>
                            <th>Guidance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.check_ids" t-as="check">
                            <td><span t-field="check.title"/></td>
                            <td><span t-field="check.severity"/></td>
                            <td><span t-field="check.status"/></td>
                            <td class="text-end"><span t-field="check.record_count"/></td>
                            <td><span t-field="check.note"/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mt-4">
                    <div class="col-6">
                        <strong>Blocking Checks:</strong> <span t-field="o.blocking_count"/><br/>
                        <strong>Warnings:</strong> <span t-field="o.warning_count"/><br/>
                        <strong>Clear Checks:</strong> <span t-field="o.clear_count"/>
                    </div>
                    <div class="col-6">
                        <strong>Native Lock Before:</strong> <span t-field="o.native_lock_date_before"/><br/>
                        <strong>Native Lock After:</strong> <span t-field="o.native_lock_date_after"/><br/>
                        <strong>Closed By:</strong> <span t-field="o.closed_by_id"/><br/>
                        <strong>Closed At:</strong> <span t-field="o.closed_at"/>
                    </div>
                </div>

                <div t-if="o.notes" class="mt-3">
                    <strong>Management Notes</strong>
                    <p t-field="o.notes"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_accounting_close">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="clinic_accounting.report_accounting_close_document"/>
            </t>
        </t>
    </template>
</odoo>
