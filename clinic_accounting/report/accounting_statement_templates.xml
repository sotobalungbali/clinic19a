<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_accounting_statement_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>ClinicOne Accounting Statement</h2>

                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Reference:</strong> <span t-field="o.name"/><br/>
                        <strong>Statement:</strong> <span t-field="o.statement_type"/><br/>
                        <strong>Period:</strong>
                        <span t-field="o.date_from"/> - <span t-field="o.date_to"/>
                    </div>
                    <div class="col-6">
                        <strong>Company:</strong> <span t-field="o.company_id"/><br/>
                        <strong>Ledger:</strong> <span t-field="o.ledger_id"/><br/>
                        <strong>Status:</strong> <span t-field="o.state"/>
                    </div>
                </div>

                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Account / Journal / Source</th>
                            <th>Description</th>
                            <th class="text-end">Opening</th>
                            <th class="text-end">Debit</th>
                            <th class="text-end">Credit</th>
                            <th class="text-end">Balance</th>
                            <th class="text-end">Natural / Running</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td><span t-field="line.date"/></td>
                            <td>
                                <span t-if="line.account_id" t-field="line.account_id"/>
                                <span t-if="not line.account_id and line.journal_id" t-field="line.journal_id"/>
                                <span t-if="not line.account_id and not line.journal_id and line.source_type" t-field="line.source_type"/>
                            </td>
                            <td><span t-field="line.label"/></td>
                            <td class="text-end"><span t-field="line.opening_balance"/></td>
                            <td class="text-end"><span t-field="line.debit"/></td>
                            <td class="text-end"><span t-field="line.credit"/></td>
                            <td class="text-end"><span t-field="line.balance"/></td>
                            <td class="text-end">
                                <span t-if="line.line_kind == 'move_line'" t-field="line.running_balance"/>
                                <span t-if="line.line_kind != 'move_line'" t-field="line.natural_balance"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mt-4">
                    <div class="col-6"/>
                    <div class="col-6">
                        <table class="table table-sm">
                            <tr><th>Total Opening</th><td class="text-end"><span t-field="o.total_opening"/></td></tr>
                            <tr><th>Total Debit</th><td class="text-end"><span t-field="o.total_debit"/></td></tr>
                            <tr><th>Total Credit</th><td class="text-end"><span t-field="o.total_credit"/></td></tr>
                            <tr><th>Total Balance</th><td class="text-end"><span t-field="o.total_balance"/></td></tr>
                            <tr t-if="o.statement_type == 'profit_loss'">
                                <th>Net Result</th><td class="text-end"><span t-field="o.net_result"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div t-if="o.notes" class="mt-3">
                    <strong>Notes</strong>
                    <p t-field="o.notes"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_accounting_statement">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="clinic_accounting.report_accounting_statement_document"/>
            </t>
        </t>
    </template>
</odoo>
