<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone search views avoid fragile inherited custom-view XML IDs. -->
    <record id="view_account_move_clinic_accounting_search" model="ir.ui.view">
        <field name="name">account.move.search.clinic.accounting</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ref"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="branch_id"/>
                <field name="clinic_accounting_source"/>
                <filter name="posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="clinic_source" string="ClinicOne Sources" domain="[('clinic_accounting_source', '!=', 'other')]"/>
                <filter name="finance" string="Finance" domain="[('clinic_accounting_source', '=', 'finance')]"/>
                <filter name="adjustment" string="Adjustments" domain="[('clinic_accounting_source', '=', 'adjustment')]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_journal" string="Journal" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_source" string="Clinic Source" context="{'group_by': 'clinic_accounting_source'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_account_move_line_clinic_accounting_search" model="ir.ui.view">
        <field name="name">account.move.line.search.clinic.accounting</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <field name="date"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="branch_id"/>
                <field name="clinic_accounting_source"/>
                <filter name="posted" string="Posted" domain="[('move_id.state', '=', 'posted')]"/>
                <filter name="clinic_source" string="ClinicOne Sources" domain="[('clinic_accounting_source', '!=', 'other')]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_source" string="Clinic Source" context="{'group_by': 'clinic_accounting_source'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_clinic_accounting_journal_entries" model="ir.actions.act_window">
        <field name="name">Clinic Accounting Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'posted')]</field>
        <field name="search_view_id" ref="view_account_move_clinic_accounting_search"/>
    </record>

    <record id="action_clinic_accounting_clinic_entries" model="ir.actions.act_window">
        <field name="name">ClinicOne-Sourced Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('clinic_accounting_source', '!=', 'other')]</field>
        <field name="search_view_id" ref="view_account_move_clinic_accounting_search"/>
    </record>

    <record id="action_clinic_accounting_journal_items" model="ir.actions.act_window">
        <field name="name">Clinic Accounting Journal Items</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('move_id.state', '=', 'posted')]</field>
        <field name="search_view_id" ref="view_account_move_line_clinic_accounting_search"/>
    </record>
</odoo>
