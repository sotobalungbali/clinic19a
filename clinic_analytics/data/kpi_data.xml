<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="kpi_revenue_total" model="clinic.analytics.kpi">
        <field name="name">Revenue</field>
        <field name="code">REVENUE_TOTAL</field>
        <field name="sequence">10</field>
        <field name="family">financial</field>
        <field name="source_key">revenue_total</field>
        <field name="unit">amount</field>
        <field name="direction">higher</field>
        <field name="forecastable">True</field>
        <field name="state">active</field>
        <field name="report_definition_id" ref="clinic_reports.report_definition_fin_revenue"/>
        <field name="description">Posted/paid Clinic Billing revenue in the selected scope and period.</field>
        <field name="methodology" type="html"><p>Sum of <code>clinic.billing.invoice.amount_total</code> for Posted/Paid records. Branch scope follows the invoice patient contact branch.</p></field>
    </record>

    <record id="kpi_revenue_paid" model="clinic.analytics.kpi">
        <field name="name">Fully Paid Revenue</field>
        <field name="code">REVENUE_PAID</field>
        <field name="sequence">20</field>
        <field name="family">financial</field>
        <field name="source_key">revenue_paid</field>
        <field name="unit">amount</field>
        <field name="direction">higher</field>
        <field name="forecastable">True</field>
        <field name="state">active</field>
        <field name="report_definition_id" ref="clinic_reports.report_definition_fin_revenue"/>
    </record>

    <record id="kpi_booking_count" model="clinic.analytics.kpi">
