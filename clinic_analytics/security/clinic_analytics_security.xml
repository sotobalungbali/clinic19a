<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_analytics_user" model="res.groups">
        <field name="name">Clinic Analytics User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_analytics_analyst" model="res.groups">
        <field name="name">Clinic Analytics Analyst</field>
        <field name="implied_ids" eval="[(4, ref('clinic_analytics.group_analytics_user'))]"/>
    </record>

    <record id="group_analytics_manager" model="res.groups">
        <field name="name">Clinic Analytics Manager</field>
        <field name="implied_ids" eval="[(4, ref('clinic_analytics.group_analytics_analyst'))]"/>
    </record>

    <!--
        Regular analytics users are branch-scoped. Company-wide aggregates
        (branch_id = False) are deliberately excluded and remain Manager-only.
    -->
    <record id="rule_analytics_snapshot_branch" model="ir.rule">
        <field name="name">Analytics Snapshots: allowed branches</field>
        <field name="model_id" ref="model_clinic_analytics_snapshot"/>
        <field name="groups" eval="[(4, ref('clinic_analytics.group_analytics_user'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids), ('branch_id', 'in', user.allowed_branch_ids.ids)]</field>
    </record>
    <record id="rule_analytics_snapshot_manager" model="ir.rule">
        <field name="name">Analytics Snapshots Manager: companies</field>
        <field name="model_id" ref="model_clinic_analytics_snapshot"/>
        <field name="groups" eval="[(4, ref('clinic_analytics.group_analytics_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>

