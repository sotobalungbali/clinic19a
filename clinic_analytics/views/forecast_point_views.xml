<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_analytics_forecast_point_search" model="ir.ui.view">
        <field name="name">clinic.analytics.forecast.point.search</field>
        <field name="model">clinic.analytics.forecast.point</field>
        <field name="arch" type="xml">
            <search string="Forecast Points">
                <field name="forecast_id"/>
                <field name="kpi_id"/>
                <field name="branch_id"/>
                <field name="period_start"/>
                <filter name="actual" string="Historical" domain="[('point_type','=','actual')]"/>
                <filter name="forecast" string="Forecast" domain="[('point_type','=','forecast')]"/>
                <separator/>
                <filter name="group_kpi" string="KPI" context="{'group_by':'kpi_id'}"/>
                <filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/>
                <filter name="group_type" string="Point Type" context="{'group_by':'point_type'}"/>
            </search>
        </field>
    </record>

    <record id="view_analytics_forecast_point_list" model="ir.ui.view">
        <field name="name">clinic.analytics.forecast.point.list</field>
        <field name="model">clinic.analytics.forecast.point</field>
        <field name="arch" type="xml">
            <list decoration-info="point_type == 'forecast'">
                <field name="forecast_id"/>
                <field name="kpi_id"/>
                <field name="branch_id"/>
                <field name="point_type" widget="badge"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="actual_value"/>
                <field name="predicted_value"/>
                <field name="lower_bound"/>
                <field name="upper_bound"/>
                <button name="action_open_source" type="object" string="Source" icon="fa-external-link"
                        invisible="point_type != 'actual'"/>
            </list>
        </field>
    </record>

    <record id="view_analytics_forecast_point_form" model="ir.ui.view">
        <field name="name">clinic.analytics.forecast.point.form</field>
        <field name="model">clinic.analytics.forecast.point</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_source" type="object" string="Open Historical Source"
                            invisible="point_type != 'actual'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="forecast_id"/>
                            <field name="kpi_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="point_type" widget="badge"/>
                        </group>
                        <group>
                            <field name="period_start"/>
                            <field name="period_end"/>
                            <field name="actual_value"/>
                            <field name="predicted_value"/>
                            <field name="lower_bound"/>
                            <field name="upper_bound"/>
                            <field name="residual"/>
                        </group>
                    </group>
                    <group string="Source Lineage" groups="clinic_analytics.group_analytics_manager">
                        <field name="source_model"/>
                        <field name="source_domain_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_analytics_forecast_point_graph" model="ir.ui.view">
        <field name="name">clinic.analytics.forecast.point.graph</field>
        <field name="model">clinic.analytics.forecast.point</field>
        <field name="arch" type="xml">
            <graph string="Forecast Series" type="line">
                <field name="period_start" interval="month"/>
                <field name="kpi_id"/>
                <field name="actual_value" type="measure"/>
                <field name="predicted_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_analytics_forecast_point_pivot" model="ir.ui.view">
        <field name="name">clinic.analytics.forecast.point.pivot</field>
        <field name="model">clinic.analytics.forecast.point</field>
        <field name="arch" type="xml">
            <pivot string="Forecast Analysis">
                <field name="kpi_id" type="row"/>
                <field name="branch_id" type="row"/>
                <field name="period_start" type="col" interval="month"/>
                <field name="actual_value" type="measure"/>
                <field name="predicted_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_analytics_forecast_point" model="ir.actions.act_window">
        <field name="name">Forecast Analysis</field>
        <field name="res_model">clinic.analytics.forecast.point</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="search_view_id" ref="view_analytics_forecast_point_search"/>
    </record>
</odoo>

