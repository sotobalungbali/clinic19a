<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dashboard_board_form_analytics" model="ir.ui.view">
        <field name="name">clinic.dashboard.board.form.analytics</field>
        <field name="model">clinic.dashboard.board</field>
        <field name="inherit_id" ref="clinic_dashboard.view_dashboard_board_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_analytics_forecasts" type="object" class="oe_stat_button" icon="fa-line-chart"
                        groups="clinic_analytics.group_analytics_user">
                    <field name="analytics_forecast_count" widget="statinfo" string="Forecasts"/>
                </button>
                <button name="action_view_analytics_insights" type="object" class="oe_stat_button" icon="fa-lightbulb-o"
                        groups="clinic_analytics.group_analytics_user">
                    <field name="analytics_insight_count" widget="statinfo" string="Insights"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_report_definition_form_analytics" model="ir.ui.view">
        <field name="name">clinic.report.definition.form.analytics</field>
        <field name="model">clinic.report.definition</field>
        <field name="inherit_id" ref="clinic_reports.view_report_definition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_analytics_kpis" type="object" class="oe_stat_button" icon="fa-area-chart"
                        groups="clinic_analytics.group_analytics_user">
                    <field name="analytics_kpi_count" widget="statinfo" string="Analytics KPIs"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

