<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_analytics_kpi_search" model="ir.ui.view">
        <field name="name">clinic.analytics.kpi.search</field>
        <field name="model">clinic.analytics.kpi</field>
        <field name="arch" type="xml">
            <search string="Analytics KPIs">
                <field name="name"/>
                <field name="code"/>
                <field name="family"/>
                <field name="source_key"/>
                <field name="report_definition_id"/>
                <filter name="active_kpi" string="Active" domain="[('state','=','active')]"/>
                <filter name="forecastable" string="Forecastable" domain="[('forecastable','=',True)]"/>
                <separator/>
                <filter name="group_family" string="Family" context="{'group_by':'family'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                <filter name="group_unit" string="Unit" context="{'group_by':'unit'}"/>
            </search>
        </field>
    </record>

    <record id="view_analytics_kpi_list" model="ir.ui.view">
        <field name="name">clinic.analytics.kpi.list</field>
        <field name="model">clinic.analytics.kpi</field>
        <field name="arch" type="xml">
            <list default_order="sequence,code"
                  decoration-success="state == 'active'"
                  decoration-muted="state == 'retired'">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="family" widget="badge"/>
                <field name="unit"/>
                <field name="direction"/>
                <field name="forecastable"/>
                <field name="report_definition_id" optional="show"/>
                <field name="snapshot_line_count" optional="show"/>
                <field name="forecast_count" optional="show"/>
                <field name="state" widget="badge"/>
                <button name="action_view_snapshots" type="object" string="History" icon="fa-history"/>
                <button name="action_view_forecasts" type="object" string="Forecasts" icon="fa-line-chart"
                        invisible="not forecastable"/>
            </list>
        </field>
    </record>

    <record id="view_analytics_kpi_form" model="ir.ui.view">
        <field name="name">clinic.analytics.kpi.form</field>
        <field name="model">clinic.analytics.kpi</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            groups="clinic_analytics.group_analytics_manager"
                            invisible="state != 'draft'"/>
                    <button name="action_retire" type="object" string="Retire"
                            groups="clinic_analytics.group_analytics_manager"
                            invisible="state != 'active'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            groups="clinic_analytics.group_analytics_manager"
                            invisible="state != 'retired'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_snapshots" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="snapshot_line_count" widget="statinfo" string="Snapshots"/>
                        </button>
                        <button name="action_view_forecasts" type="object" class="oe_stat_button" icon="fa-line-chart"
                                invisible="not forecastable">
                            <field name="forecast_count" widget="statinfo" string="Forecasts"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <div><field name="code" class="oe_inline"/></div>
                    </div>

                    <div class="alert alert-info" role="alert">
                        KPI sources are fixed code-owned adapters. No arbitrary model, field, method, or domain is executed from this configuration.
                    </div>

                    <group>
                        <group string="KPI Identity">
                            <field name="family"/>
                            <field name="source_key"/>
                            <field name="unit"/>
                            <field name="direction"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Forecast Governance">
                            <field name="forecastable"/>
                            <field name="default_history_periods" invisible="not forecastable"/>
                            <field name="default_horizon_periods" invisible="not forecastable"/>
                            <field name="default_forecast_method" invisible="not forecastable"/>
                            <field name="report_definition_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Thresholds">
                            <group>
                                <group>
                                    <field name="has_target"/>
                                    <field name="target_value" invisible="not has_target"/>
                                </group>
                                <group>
                                    <field name="has_warning_threshold"/>
                                    <field name="warning_threshold" invisible="not has_warning_threshold"/>
                                    <field name="has_critical_threshold"/>
                                    <field name="critical_threshold" invisible="not has_critical_threshold"/>
                                </group>
                            </group>
                        </page>
                        <page string="Methodology">
                            <field name="description"/>
                            <field name="methodology"/>
                        </page>
                        <page string="Dashboard Lineage">
                            <field name="dashboard_board_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_analytics_kpi" model="ir.actions.act_window">
        <field name="name">KPI Catalog</field>
        <field name="res_model">clinic.analytics.kpi</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_analytics_kpi_search"/>
    </record>
</odoo>
