<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_analytics_snapshot_line_search" model="ir.ui.view">
        <field name="name">clinic.analytics.snapshot.line.search</field>
        <field name="model">clinic.analytics.snapshot.line</field>
        <field name="arch" type="xml">
            <search string="KPI Snapshot Lines">
                <field name="kpi_id"/>
                <field name="snapshot_id"/>
                <field name="company_id"/>
                <field name="branch_id"/>
                <field name="date_to"/>
                <filter name="warning" string="Warning" domain="[('status','=','warning')]"/>
                <filter name="critical" string="Critical" domain="[('status','=','critical')]"/>
                <separator/>
                <filter name="group_kpi" string="KPI" context="{'group_by':'kpi_id'}"/>
                <filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by':'date_to:month'}"/>
                <filter name="group_status" string="Signal" context="{'group_by':'status'}"/>
            </search>
        </field>
    </record>

    <record id="view_analytics_snapshot_line_list" model="ir.ui.view">
        <field name="name">clinic.analytics.snapshot.line.list</field>
        <field name="model">clinic.analytics.snapshot.line</field>
        <field name="arch" type="xml">
            <list default_order="date_to desc,kpi_sequence"
                  decoration-success="status == 'normal'"
                  decoration-warning="status == 'warning'"
                  decoration-danger="status == 'critical'">
                <field name="date_to"/>
                <field name="branch_id"/>
                <field name="kpi_id"/>
                <field name="display_value"/>
                <field name="trend_percent"/>
                <field name="source_count"/>
                <field name="status" widget="badge"/>
                <button name="action_open_source" type="object" string="Source" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_analytics_snapshot_line_form" model="ir.ui.view">
        <field name="name">clinic.analytics.snapshot.line.form</field>
        <field name="model">clinic.analytics.snapshot.line</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_source" type="object" string="Open Source Records" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="kpi_id"/></h1>
                    </div>
                    <group>
                        <group string="Period &amp; Scope">
                            <field name="snapshot_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Value">
                            <field name="display_value"/>
                            <field name="value"/>
                            <field name="previous_value"/>
                            <field name="trend_percent"/>
                            <field name="status" widget="badge"/>
                        </group>
                    </group>
                    <group string="Source Lineage">
                        <field name="source_model"/>
                        <field name="source_count"/>
                        <field name="source_domain_json" groups="clinic_analytics.group_analytics_manager"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_analytics_snapshot_line_graph" model="ir.ui.view">
        <field name="name">clinic.analytics.snapshot.line.graph</field>
        <field name="model">clinic.analytics.snapshot.line</field>
        <field name="arch" type="xml">
            <graph string="KPI Trend" type="line">
                <field name="date_to" interval="month"/>
                <field name="kpi_id"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_analytics_snapshot_line_pivot" model="ir.ui.view">
        <field name="name">clinic.analytics.snapshot.line.pivot</field>
        <field name="model">clinic.analytics.snapshot.line</field>
        <field name="arch" type="xml">
            <pivot string="KPI Analysis">
                <field name="kpi_id" type="row"/>
                <field name="branch_id" type="row"/>
                <field name="date_to" type="col" interval="month"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_analytics_snapshot_line" model="ir.actions.act_window">
        <field name="name">KPI Analysis</field>
        <field name="res_model">clinic.analytics.snapshot.line</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="search_view_id" ref="view_analytics_snapshot_line_search"/>
    </record>
</odoo>
