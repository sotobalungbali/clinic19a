<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_clinic_ap" model="ir.module.category">
        <field name="name">ClinicOne Accounts Payable</field>
        <field name="sequence">48</field>
    </record>
    <record id="privilege_clinic_ap" model="res.groups.privilege">
        <field name="name">ClinicOne Accounts Payable</field>
        <field name="category_id" ref="clinic_ap.module_category_clinic_ap"/>
        <field name="sequence">48</field>
    </record>
    <record id="group_clinic_ap_user" model="res.groups">
        <field name="name">AP User</field>
        <field name="privilege_id" ref="clinic_ap.privilege_clinic_ap"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_clinic_ap_accountant" model="res.groups">
        <field name="name">AP Accountant</field>
        <field name="privilege_id" ref="clinic_ap.privilege_clinic_ap"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_ap.group_clinic_ap_user'))]"/>
    </record>
    <record id="group_clinic_ap_manager" model="res.groups">
        <field name="name">AP Manager</field>
        <field name="privilege_id" ref="clinic_ap.privilege_clinic_ap"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_ap.group_clinic_ap_accountant'))]"/>
    </record>

    <record id="rule_clinic_ap_company" model="ir.rule">
        <field name="name">Clinic AP: allowed companies</field>
        <field name="model_id" ref="model_clinic_ap"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_ap.group_clinic_ap_user'))]"/>
    </record>
    <record id="rule_clinic_ap_line_company" model="ir.rule">
