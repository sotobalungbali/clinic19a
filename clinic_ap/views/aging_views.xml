<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_clinic_ap_aging_search" model="ir.ui.view"><field name="name">clinic.ap.aging.search</field><field name="model">clinic.ap.aging</field><field name="arch" type="xml"><search><field name="name"/><field name="as_of_date"/><field name="company_id"/><filter name="active" string="Active" domain="[('state','!=','archived')]"/><filter name="pinned" string="Pinned" domain="[('is_pinned','=',True)]"/><group><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/><filter name="group_date" string="As-of Month" context="{'group_by':'as_of_date:month'}"/></group></search></field></record>
  <record id="view_clinic_ap_aging_list" model="ir.ui.view"><field name="name">clinic.ap.aging.list</field><field name="model">clinic.ap.aging</field><field name="arch" type="xml"><list><field name="name"/><field name="as_of_date"/><field name="vendor_count"/><field name="invoice_count"/><field name="amount_outstanding" sum="Outstanding"/><field name="amount_overdue" sum="Overdue"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/><field name="is_pinned"/><field name="last_refreshed_at"/></list></field></record>
  <record id="view_clinic_ap_aging_form" model="ir.ui.view"><field name="name">clinic.ap.aging.form</field><field name="model">clinic.ap.aging</field><field name="arch" type="xml"><form string="AP Aging"><header><button name="action_refresh" type="object" string="Refresh Aging" class="btn-primary" invisible="state == 'archived'"/><button name="action_archive" type="object" string="Archive" invisible="state == 'archived'"/><field name="state" widget="statusbar" statusbar_visible="draft,generated,archived"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list"><field name="vendor_count" string="Vendors" widget="statinfo"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="as_of_date"/><field name="company_id" groups="base.group_multi_company"/><field name="currency_id" readonly="1"/><field name="include_refunds"/><field name="use_partner_grace"/><field name="grace_days_override" invisible="use_partner_grace"/></group><group><field name="is_pinned"/><field name="last_refreshed_at" readonly="1"/><field name="vendor_count" readonly="1"/><field name="invoice_count" readonly="1"/><field name="amount_outstanding" readonly="1"/><field name="amount_overdue" readonly="1"/></group></group><group string="Aging Buckets" col="5"><field name="amount_current" readonly="1"/><field name="amount_1_30" readonly="1"/><field name="amount_31_60" readonly="1"/><field name="amount_61_90" readonly="1"/><field name="amount_90_plus" readonly="1"/></group><field name="line_ids" readonly="1"><list><field name="vendor_id"/><field name="invoice_count"/><field name="amount_outstanding"/><field name="amount_overdue"/><field name="amount_current" optional="hide"/><field name="amount_1_30"/><field name="amount_31_60"/><field name="amount_61_90"/><field name="amount_90_plus"/><field name="max_days_overdue"/><field name="currency_id" column_invisible="True"/><button name="action_view_vendor_bills" type="object" icon="fa-file-text-o" string="Bills"/><button name="action_view_vendor" type="object" icon="fa-user" string="Vendor"/></list></field></sheet><chatter/></form></field></record>
  <record id="action_clinic_ap_aging" model="ir.actions.act_window"><field name="name">AP Aging</field><field name="res_model">clinic.ap.aging</field><field name="view_mode">list,form</field><field name="search_view_id" ref="clinic_ap.view_clinic_ap_aging_search"/></record>

  <record id="view_clinic_ap_aging_line_search" model="ir.ui.view"><field name="name">clinic.ap.aging.line.search</field><field name="model">clinic.ap.aging.line</field><field name="arch" type="xml"><search><field name="aging_id"/><field name="vendor_id"/><field name="as_of_date"/><filter name="overdue" string="Overdue" domain="[('amount_overdue','&gt;',0)]"/><group><filter name="group_vendor" string="Vendor" context="{'group_by':'vendor_id'}"/><filter name="group_aging" string="Aging Snapshot" context="{'group_by':'aging_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_ap_aging_line_list" model="ir.ui.view"><field name="name">clinic.ap.aging.line.list</field><field name="model">clinic.ap.aging.line</field><field name="arch" type="xml"><list decoration-danger="amount_overdue &gt; 0"><field name="aging_id"/><field name="vendor_id"/><field name="invoice_count"/><field name="amount_outstanding"/><field name="amount_overdue"/><field name="amount_current"/><field name="amount_1_30"/><field name="amount_31_60"/><field name="amount_61_90"/><field name="amount_90_plus"/><field name="max_days_overdue"/><field name="currency_id" column_invisible="True"/><button name="action_view_vendor_bills" type="object" icon="fa-file-text-o" string="Bills"/></list></field></record>
  <record id="view_clinic_ap_aging_line_form" model="ir.ui.view"><field name="name">clinic.ap.aging.line.form</field><field name="model">clinic.ap.aging.line</field><field name="arch" type="xml"><form><header><button name="action_view_vendor_bills" type="object" string="Open Vendor Bills"/><button name="action_view_vendor" type="object" string="Open Vendor"/></header><sheet><div class="oe_title"><h1><field name="vendor_id"/></h1></div><group><group><field name="aging_id"/><field name="as_of_date"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="invoice_count"/><field name="max_days_overdue"/><field name="amount_outstanding"/><field name="amount_overdue"/></group></group><group string="Buckets" col="5"><field name="amount_current"/><field name="amount_1_30"/><field name="amount_31_60"/><field name="amount_61_90"/><field name="amount_90_plus"/></group></sheet></form></field></record>
  <record id="action_clinic_ap_aging_line" model="ir.actions.act_window"><field name="name">AP Aging Lines</field><field name="res_model">clinic.ap.aging.line</field><field name="view_mode">list,form</field><field name="search_view_id" ref="clinic_ap.view_clinic_ap_aging_line_search"/><field name="context">{'create': False}</field></record>
</odoo>
