<odoo>
  <record id="view_clinic_ap_line_search" model="ir.ui.view"><field name="name">clinic.ap.line.search</field><field name="model">clinic.ap.line</field><field name="arch" type="xml"><search><field name="ap_id"/><field name="vendor_id"/><field name="product_id"/><field name="purchase_line_id"/><field name="stock_move_id"/><field name="billing_invoice_id"/><field name="patient_id"/><filter name="match_issue" string="Match Issues" domain="[('match_state','in',('qty_mismatch','price_mismatch','receipt_missing'))]"/><filter name="billing_linked" string="Billing Linked" domain="['|',('billing_invoice_id','!=',False),('billing_line_id','!=',False)]"/><group><filter name="group_ap" string="AP" context="{'group_by':'ap_id'}"/><filter name="group_vendor" string="Vendor" context="{'group_by':'vendor_id'}"/><filter name="group_match" string="Match" context="{'group_by':'match_state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
