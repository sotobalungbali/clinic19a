<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_clinic_cashflow_search" model="ir.ui.view"><field name="name">clinic.cashflow.search</field><field name="model">clinic.cashflow</field><field name="arch" type="xml"><search><field name="name"/><field name="as_of_date"/><field name="company_id"/><filter name="active" string="Active" domain="[('state','!=','archived')]"/><filter name="pinned" string="Pinned" domain="[('is_pinned','=',True)]"/><group><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/><filter name="group_date" string="As-of Month" context="{'group_by':'as_of_date:month'}"/></group></search></field></record>
  <record id="view_clinic_cashflow_list" model="ir.ui.view"><field name="name">clinic.cashflow.list</field><field name="model">clinic.cashflow</field><field name="arch" type="xml"><list><field name="name"/><field name="as_of_date"/><field name="horizon_days"/><field name="granularity"/><field name="starting_balance"/><field name="total_inflow"/><field name="total_outflow"/><field name="ending_balance"/><field name="currency_id" column_invisible="True"/><field name="is_pinned"/><field name="state" widget="badge"/></list></field></record>
  <record id="view_clinic_cashflow_form" model="ir.ui.view"><field name="name">clinic.cashflow.form</field><field name="model">clinic.cashflow</field><field name="arch" type="xml"><form><header><button name="action_refresh" type="object" string="Refresh Forecast" class="btn-primary" invisible="state == 'archived'"/><button name="action_archive" type="object" string="Archive" invisible="state == 'archived'"/><field name="state" widget="statusbar" statusbar_visible="draft,generated,archived"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_buckets" type="object" class="oe_stat_button" icon="fa-calendar"><field name="horizon_days" string="Horizon Days" widget="statinfo"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group string="Forecast Scope"><field name="as_of_date"/><field name="horizon_days"/><field name="granularity"/><field name="company_id" groups="base.group_multi_company"/><field name="currency_id" readonly="1"/><field name="is_pinned"/><field name="last_refreshed_at" readonly="1"/></group><group string="Sources"><field name="include_ap"/><field name="include_ap_refunds"/><field name="include_ar"/><field name="include_ar_refunds"/></group></group><group string="Liquidity"><field name="starting_balance"/><field name="total_inflow" readonly="1"/><field name="total_outflow" readonly="1"/><field name="total_net" readonly="1"/><field name="ending_balance" readonly="1"/></group><notebook><page string="Buckets"><field name="bucket_ids" readonly="1"><list><field name="date_from"/><field name="date_to"/><field name="label"/><field name="inflow_amount"/><field name="outflow_amount"/><field name="net_amount"/><field name="cumulative_balance"/><field name="currency_id" column_invisible="True"/><button name="action_view_details" type="object" icon="fa-list" string="Details"/></list></field></page><page string="Manual Adjustments"><field name="adjustment_ids"><list editable="bottom"><field name="date"/><field name="name"/><field name="direction"/><field name="amount"/><field name="res_model" optional="hide"/><field name="res_id" optional="hide"/><field name="notes"/><field name="currency_id" column_invisible="True"/></list></field></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_clinic_cashflow" model="ir.actions.act_window"><field name="name">Cashflow Forecasts</field><field name="res_model">clinic.cashflow</field><field name="view_mode">list,form</field><field name="search_view_id" ref="clinic_ap.view_clinic_cashflow_search"/></record>

  <record id="view_clinic_cashflow_bucket_search" model="ir.ui.view"><field name="name">clinic.cashflow.bucket.search</field><field name="model">clinic.cashflow.bucket</field><field name="arch" type="xml"><search><field name="cashflow_id"/><field name="label"/><field name="date_from"/><field name="date_to"/><group><filter name="group_cashflow" string="Forecast" context="{'group_by':'cashflow_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_cashflow_bucket_list" model="ir.ui.view"><field name="name">clinic.cashflow.bucket.list</field><field name="model">clinic.cashflow.bucket</field><field name="arch" type="xml"><list><field name="cashflow_id"/><field name="label"/><field name="date_from"/><field name="date_to"/><field name="inflow_amount"/><field name="outflow_amount"/><field name="net_amount"/><field name="cumulative_balance"/><field name="inflow_count"/><field name="outflow_count"/><field name="currency_id" column_invisible="True"/><button name="action_view_details" type="object" icon="fa-list" string="Details"/></list></field></record>
  <record id="view_clinic_cashflow_bucket_form" model="ir.ui.view"><field name="name">clinic.cashflow.bucket.form</field><field name="model">clinic.cashflow.bucket</field><field name="arch" type="xml"><form><header><button name="action_view_details" type="object" string="Open Details"/></header><sheet><div class="oe_title"><h1><field name="label"/></h1></div><group><group><field name="cashflow_id"/><field name="date_from"/><field name="date_to"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="inflow_amount"/><field name="outflow_amount"/><field name="net_amount"/><field name="cumulative_balance"/><field name="inflow_count"/><field name="outflow_count"/></group></group><field name="detail_ids" readonly="1"><list><field name="date_effective"/><field name="partner_id"/><field name="name"/><field name="source_type"/><field name="direction"/><field name="amount"/><field name="currency_id" column_invisible="True"/><button name="action_view_source" type="object" icon="fa-external-link" string="Source"/></list></field></sheet></form></field></record>
  <record id="action_clinic_cashflow_bucket" model="ir.actions.act_window"><field name="name">Cashflow Buckets</field><field name="res_model">clinic.cashflow.bucket</field><field name="view_mode">list,form</field><field name="search_view_id" ref="clinic_ap.view_clinic_cashflow_bucket_search"/><field name="context">{'create': False}</field></record>

  <record id="view_clinic_cashflow_detail_search" model="ir.ui.view"><field name="name">clinic.cashflow.detail.search</field><field name="model">clinic.cashflow.detail</field><field name="arch" type="xml"><search><field name="cashflow_id"/><field name="bucket_id"/><field name="partner_id"/><field name="source_type"/><field name="direction"/><filter name="inflow" string="Inflows" domain="[('direction','=','inflow')]"/><filter name="outflow" string="Outflows" domain="[('direction','=','outflow')]"/><group><filter name="group_bucket" string="Bucket" context="{'group_by':'bucket_id'}"/><filter name="group_source" string="Source" context="{'group_by':'source_type'}"/><filter name="group_direction" string="Direction" context="{'group_by':'direction'}"/><filter name="group_partner" string="Partner" context="{'group_by':'partner_id'}"/></group></search></field></record>
  <record id="view_clinic_cashflow_detail_list" model="ir.ui.view"><field name="name">clinic.cashflow.detail.list</field><field name="model">clinic.cashflow.detail</field><field name="arch" type="xml"><list><field name="cashflow_id"/><field name="bucket_id"/><field name="date_effective"/><field name="partner_id"/><field name="name"/><field name="source_type"/><field name="direction" widget="badge"/><field name="amount" sum="Amount"/><field name="currency_id" column_invisible="True"/><button name="action_view_source" type="object" icon="fa-external-link" string="Source"/></list></field></record>
  <record id="view_clinic_cashflow_detail_form" model="ir.ui.view"><field name="name">clinic.cashflow.detail.form</field><field name="model">clinic.cashflow.detail</field><field name="arch" type="xml"><form><header><button name="action_view_source" type="object" string="Open Source"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="cashflow_id"/><field name="bucket_id"/><field name="date_effective"/><field name="partner_id"/></group><group><field name="source_type"/><field name="direction"/><field name="amount"/><field name="currency_id" readonly="1"/><field name="move_id"/><field name="adjustment_id"/></group></group></sheet></form></field></record>
  <record id="action_clinic_cashflow_detail" model="ir.actions.act_window"><field name="name">Cashflow Details</field><field name="res_model">clinic.cashflow.detail</field><field name="view_mode">list,form</field><field name="search_view_id" ref="clinic_ap.view_clinic_cashflow_detail_search"/><field name="context">{'create': False}</field></record>

  <record id="view_clinic_cashflow_adjustment_search" model="ir.ui.view"><field name="name">clinic.cashflow.adjustment.search</field><field name="model">clinic.cashflow.adjustment</field><field name="arch" type="xml"><search><field name="cashflow_id"/><field name="name"/><field name="date"/><field name="direction"/><group><filter name="group_cashflow" string="Forecast" context="{'group_by':'cashflow_id'}"/><filter name="group_direction" string="Direction" context="{'group_by':'direction'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_cashflow_adjustment_list" model="ir.ui.view"><field name="name">clinic.cashflow.adjustment.list</field><field name="model">clinic.cashflow.adjustment</field><field name="arch" type="xml"><list editable="bottom"><field name="cashflow_id"/><field name="date"/><field name="name"/><field name="direction"/><field name="amount" sum="Amount"/><field name="currency_id" column_invisible="True"/><field name="notes"/></list></field></record>
  <record id="view_clinic_cashflow_adjustment_form" model="ir.ui.view"><field name="name">clinic.cashflow.adjustment.form</field><field name="model">clinic.cashflow.adjustment</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><field name="cashflow_id"/><field name="date"/><field name="direction"/><field name="amount"/><field name="currency_id" readonly="1"/><field name="res_model"/><field name="res_id"/><field name="notes"/></group></sheet></form></field></record>
  <record id="action_clinic_cashflow_adjustment" model="ir.actions.act_window"><field name="name">Cashflow Adjustments</field><field name="res_model">clinic.cashflow.adjustment</field><field name="view_mode">list,form</field><field name="search_view_id" ref="clinic_ap.view_clinic_cashflow_adjustment_search"/></record>
</odoo>
