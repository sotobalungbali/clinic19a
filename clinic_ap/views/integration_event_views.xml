<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_clinic_ap_event_search" model="ir.ui.view"><field name="name">clinic.ap.integration.event.search</field><field name="model">clinic.ap.integration.event</field><field name="arch" type="xml"><search><field name="event_key"/><field name="event_type"/><field name="ap_id"/><field name="state"/><filter name="pending" string="Pending" domain="[('state','=','pending')]"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><filter name="processed" string="Processed" domain="[('state','=','processed')]"/><group><filter name="group_type" string="Event Type" context="{'group_by':'event_type'}"/><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_ap_event_list" model="ir.ui.view"><field name="name">clinic.ap.integration.event.list</field><field name="model">clinic.ap.integration.event</field><field name="arch" type="xml"><list decoration-danger="state == 'failed'" decoration-success="state == 'processed'"><field name="create_date"/><field name="event_type"/><field name="event_key" optional="hide"/><field name="ap_id"/><field name="state" widget="badge"/><field name="attempt_count"/><field name="processed_at"/><field name="company_id" groups="base.group_multi_company"/><button name="action_mark_processed" type="object" icon="fa-check" string="Processed" invisible="state == 'processed'" groups="clinic_ap.group_clinic_ap_manager"/><button name="action_retry" type="object" icon="fa-repeat" string="Retry" invisible="state == 'processed'" groups="clinic_ap.group_clinic_ap_manager"/></list></field></record>
  <record id="view_clinic_ap_event_form" model="ir.ui.view"><field name="name">clinic.ap.integration.event.form</field><field name="model">clinic.ap.integration.event</field><field name="arch" type="xml"><form><header><button name="action_mark_processed" type="object" string="Mark Processed" invisible="state == 'processed'" groups="clinic_ap.group_clinic_ap_manager"/><button name="action_retry" type="object" string="Retry" invisible="state == 'processed'" groups="clinic_ap.group_clinic_ap_manager"/><field name="state" widget="statusbar" statusbar_visible="pending,failed,processed"/></header><sheet><div class="oe_title"><h1><field name="event_type"/></h1></div><group><group><field name="event_key" readonly="1"/><field name="ap_id"/><field name="company_id" groups="base.group_multi_company"/><field name="attempt_count" readonly="1"/></group><group><field name="create_date" readonly="1"/><field name="processed_at" readonly="1"/></group></group><group string="Payload"><field name="payload_json" widget="text" readonly="1"/></group><group string="Last Error"><field name="last_error" readonly="1"/></group></sheet></form></field></record>
  <record id="action_clinic_ap_event" model="ir.actions.act_window"><field name="name">AP Integration Events</field><field name="res_model">clinic.ap.integration.event</field><field name="view_mode">list,form</field><field name="search_view_id" ref="clinic_ap.view_clinic_ap_event_search"/><field name="context">{'create': False}</field></record>
</odoo>

