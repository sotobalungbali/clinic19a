<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ap_payment_term_search" model="ir.ui.view"><field name="name">account.payment.term.ap.search</field><field name="model">account.payment.term</field><field name="arch" type="xml"><search><field name="name"/><field name="ap_code"/><filter name="ap_active" string="AP Policy Active" domain="[('ap_active','=',True)]"/><filter name="eom" string="EOM Policy" domain="[('ap_eom_policy','!=','none')]"/><group><filter name="group_policy" string="Due Policy" context="{'group_by':'ap_eom_policy'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_ap_payment_term_list" model="ir.ui.view"><field name="name">account.payment.term.ap.list</field><field name="model">account.payment.term</field><field name="arch" type="xml"><list><field name="name"/><field name="ap_code"/><field name="ap_active"/><field name="ap_eom_policy"/><field name="ap_due_day"/><field name="ap_early_discount_percent"/><field name="ap_grace_days"/><field name="ap_late_fee_percent"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="view_ap_payment_term_form" model="ir.ui.view"><field name="name">account.payment.term.ap.form</field><field name="model">account.payment.term</field><field name="arch" type="xml"><form string="AP Payment Term Policy"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group string="AP Policy"><field name="ap_active"/><field name="ap_code"/><field name="company_id" groups="base.group_multi_company"/><field name="ap_eom_policy"/><field name="ap_due_day" invisible="ap_eom_policy != 'dom'"/></group><group string="Discount &amp; Late Policy"><field name="ap_early_discount_percent"/><field name="ap_early_discount_days"/><field name="ap_grace_days"/><field name="ap_late_fee_percent"/><field name="ap_late_fee_fixed"/><field name="ap_min_due_amount"/></group></group><separator string="Standard Odoo Term Lines"/><field name="line_ids"><list editable="bottom"><field name="value"/><field name="value_amount"/><field name="nb_days"/><field name="delay_type" optional="hide"/></list></field></sheet></form></field></record>
  <record id="action_ap_payment_terms" model="ir.actions.act_window"><field name="name">AP Payment Terms</field><field name="res_model">account.payment.term</field><field name="view_mode">list,form</field><field name="search_view_id" ref="clinic_ap.view_ap_payment_term_search"/><field name="domain">[('ap_active','=',True)]</field><field name="context">{'default_ap_active': True}</field></record>
</odoo>

