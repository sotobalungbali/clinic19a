<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_clinic_ar" model="ir.module.category">
    <field name="name">ClinicOne Finance</field>
    <field name="sequence">45</field>
  </record>

  <record id="privilege_clinic_ar" model="res.groups.privilege">
    <field name="name">ClinicOne Accounts Receivable</field>
    <field name="category_id" ref="clinic_ar.module_category_clinic_ar"/>
    <field name="sequence">45</field>
  </record>

  <record id="group_clinic_ar_user" model="res.groups">
    <field name="name">AR User</field>
    <field name="privilege_id" ref="clinic_ar.privilege_clinic_ar"/>
    <field name="sequence">10</field>
    <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
  </record>

  <record id="group_clinic_ar_manager" model="res.groups">
    <field name="name">AR Manager</field>
    <field name="privilege_id" ref="clinic_ar.privilege_clinic_ar"/>
    <field name="sequence">20</field>
    <field name="implied_ids" eval="[Command.link(ref('clinic_ar.group_clinic_ar_user'))]"/>
  </record>

  <record id="rule_ar_invoice_company" model="ir.rule">
    <field name="name">AR Invoice - Allowed Companies</field>
    <field name="model_id" ref="model_clinic_ar_invoice"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_ar.group_clinic_ar_user'))]"/>
  </record>
