<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_move_form_clinic_ar" model="ir.ui.view">
    <field name="name">account.move.form.clinic.ar</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button name="action_open_related_ar_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="ar_invoice_count == 0" groups="clinic_ar.group_clinic_ar_user"><field name="ar_invoice_count" string="Clinic AR" widget="statinfo"/></button><button name="action_open_related_ar_payment" type="object" class="oe_stat_button" icon="fa-money" invisible="ar_payment_count == 0" groups="clinic_ar.group_clinic_ar_user"><field name="ar_payment_count" string="AR Receipts" widget="statinfo"/></button><button name="action_ar_writeoff_small_residual" type="object" class="oe_stat_button" icon="fa-eraser" string="Write Off" invisible="ar_invoice_count == 0 or amount_residual == 0" groups="clinic_ar.group_clinic_ar_manager"/></xpath></field>
  </record>
</odoo>



