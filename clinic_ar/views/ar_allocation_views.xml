<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_clinic_ar_allocation_search" model="ir.ui.view"><field name="name">clinic.ar.allocation.search</field><field name="model">clinic.ar.allocation</field><field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="payment_id"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="done" string="Done" domain="[('state','=','done')]"/><group><filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_ar_allocation_list" model="ir.ui.view"><field name="name">clinic.ar.allocation.list</field><field name="model">clinic.ar.allocation</field><field name="arch" type="xml"><list decoration-success="state == 'done'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="partner_id"/><field name="payment_id"/><field name="available_credit"/><field name="allocated_amount"/><field name="credit_after_allocation"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
  <record id="view_clinic_ar_allocation_form" model="ir.ui.view"><field name="name">clinic.ar.allocation.form</field><field name="model">clinic.ar.allocation</field><field name="arch" type="xml"><form><header><button name="action_validate" string="Validate" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_allocate" string="Apply Reconciliation" type="object" class="btn-primary" invisible="state != 'validated'"/><button name="action_cancel" string="Cancel" type="object" invisible="state in ('done','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,validated,done,cancelled"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_payment" type="object" class="oe_stat_button" icon="fa-money"><field name="payment_id" string="Source Receipt" widget="statinfo"/></button></div><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="partner_id"/><field name="payment_id"/><field name="origin_ref"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="available_credit"/><field name="allocated_amount"/><field name="credit_after_allocation"/><field name="currency_id"/></group></group><field name="line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="invoice_id"/><field name="invoice_residual_snapshot"/><field name="apply_amount"/><field name="applied_amount"/><field name="result_residual"/><field name="status" widget="badge"/><field name="message" optional="show"/><button name="action_open_invoice" string="Invoice" type="object" icon="fa-external-link"/></list></field><group><field name="note"/></group></sheet><chatter/></form></field></record>
  <record id="action_clinic_ar_allocation" model="ir.actions.act_window"><field name="name">Credit Allocations</field><field name="res_model">clinic.ar.allocation</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_ar_allocation_search"/></record>
  <record id="view_clinic_ar_allocation_line_search" model="ir.ui.view"><field name="name">clinic.ar.allocation.line.search</field><field name="model">clinic.ar.allocation.line</field><field name="arch" type="xml"><search><field name="allocation_id"/><field name="invoice_id"/><field name="partner_id"/><filter name="applied" string="Applied" domain="[('status','=','applied')]"/><group><filter name="group_allocation" string="Allocation" context="{'group_by':'allocation_id'}"/><filter name="group_invoice" string="AR Invoice" context="{'group_by':'invoice_id'}"/><filter name="group_status" string="Status" context="{'group_by':'status'}"/></group></search></field></record>
  <record id="view_clinic_ar_allocation_line_list" model="ir.ui.view"><field name="name">clinic.ar.allocation.line.list</field><field name="model">clinic.ar.allocation.line</field><field name="arch" type="xml"><list><field name="allocation_id"/><field name="invoice_id"/><field name="invoice_residual_snapshot"/><field name="apply_amount"/><field name="applied_amount"/><field name="result_residual"/><field name="status" widget="badge"/><field name="message"/></list></field></record>
  <record id="view_clinic_ar_allocation_line_form" model="ir.ui.view"><field name="name">clinic.ar.allocation.line.form</field><field name="model">clinic.ar.allocation.line</field><field name="arch" type="xml"><form><sheet><group><group><field name="allocation_id"/><field name="invoice_id"/><field name="partner_id"/><field name="company_id"/></group><group><field name="invoice_residual_snapshot"/><field name="apply_amount"/><field name="applied_amount"/><field name="result_residual"/><field name="status"/><field name="message"/></group></group><button name="action_open_invoice" string="Open AR Invoice" type="object" class="btn-secondary"/></sheet></form></field></record>
  <record id="action_clinic_ar_allocation_line" model="ir.actions.act_window"><field name="name">AR Allocation Lines</field><field name="res_model">clinic.ar.allocation.line</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_ar_allocation_line_search"/></record>
</odoo>

