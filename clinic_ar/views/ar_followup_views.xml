<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_clinic_ar_followup_level_search" model="ir.ui.view"><field name="name">clinic.ar.followup.level.search</field><field name="model">clinic.ar.followup.level</field><field name="arch" type="xml"><search><field name="name"/><field name="reminder_type"/><filter name="active" string="Active" domain="[('active','=',True)]"/><group><filter name="group_channel" string="Channel" context="{'group_by':'reminder_type'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_ar_followup_level_list" model="ir.ui.view"><field name="name">clinic.ar.followup.level.list</field><field name="model">clinic.ar.followup.level</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="name"/><field name="delay_days"/><field name="reminder_type"/><field name="template_id" optional="show"/><field name="activity_type_id" optional="show"/><field name="active"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
  <record id="view_clinic_ar_followup_level_form" model="ir.ui.view"><field name="name">clinic.ar.followup.level.form</field><field name="model">clinic.ar.followup.level</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="sequence"/><field name="delay_days"/><field name="reminder_type"/><field name="active"/></group><group><field name="template_id" invisible="reminder_type != 'email'"/><field name="activity_type_id" invisible="reminder_type == 'email'"/><field name="company_id" groups="base.group_multi_company"/></group></group><field name="description"/></sheet></form></field></record>
  <record id="action_clinic_ar_followup_level" model="ir.actions.act_window"><field name="name">Follow-up Levels</field><field name="res_model">clinic.ar.followup.level</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_ar_followup_level_search"/></record>

  <record id="view_clinic_ar_followup_search" model="ir.ui.view"><field name="name">clinic.ar.followup.search</field><field name="model">clinic.ar.followup</field><field name="arch" type="xml"><search><field name="name"/><field name="invoice_id"/><field name="partner_id"/><field name="level_id"/><field name="user_id"/><filter name="scheduled" string="Scheduled" domain="[('state','=','scheduled')]"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><filter name="sent" string="Sent" domain="[('state','=','sent')]"/><group><filter name="group_level" string="Level" context="{'group_by':'level_id'}"/><filter name="group_channel" string="Channel" context="{'group_by':'reminder_type'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_user" string="Collector" context="{'group_by':'user_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_ar_followup_list" model="ir.ui.view"><field name="name">clinic.ar.followup.list</field><field name="model">clinic.ar.followup</field><field name="arch" type="xml"><list decoration-danger="state == 'failed'" decoration-success="state == 'sent'" decoration-muted="state in ('done','cancelled','skipped')"><field name="name"/><field name="scheduled_date"/><field name="invoice_id"/><field name="partner_id"/><field name="level_id"/><field name="reminder_type"/><field name="amount_residual_at_schedule"/><field name="user_id"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
  <record id="view_clinic_ar_followup_form" model="ir.ui.view"><field name="name">clinic.ar.followup.form</field><field name="model">clinic.ar.followup</field><field name="arch" type="xml"><form><header><button name="action_schedule" string="Schedule" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_send" string="Send / Queue" type="object" class="btn-primary" invisible="state not in ('scheduled','failed')"/><button name="action_skip" string="Skip" type="object" invisible="state not in ('draft','scheduled')"/><button name="action_done" string="Done" type="object" invisible="state in ('done','cancelled')"/><button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="draft,scheduled,sent,done,failed,cancelled"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o"><field name="invoice_id" string="AR Invoice" widget="statinfo"/></button></div><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="invoice_id"/><field name="partner_id"/><field name="patient_id"/><field name="level_id"/><field name="scheduled_date"/><field name="user_id"/></group><group><field name="reminder_type"/><field name="days_overdue_at_schedule"/><field name="amount_residual_at_schedule"/><field name="sent_date"/><field name="next_scheduled_date"/><field name="times_sent"/><field name="company_id" groups="base.group_multi_company"/></group></group><notebook><page string="Clinical Traceability"><group><field name="booking_id"/><field name="treatment_session_id"/><field name="membership_id"/></group></page><page string="Execution"><group><field name="template_id"/><field name="activity_type_id"/><field name="last_error"/></group></page><page string="Notes"><field name="note"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_clinic_ar_followup" model="ir.actions.act_window"><field name="name">AR Follow-ups</field><field name="res_model">clinic.ar.followup</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_ar_followup_search"/></record>
</odoo>



