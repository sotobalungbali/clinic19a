<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_clinic_ar_integration_event_search" model="ir.ui.view"><field name="name">clinic.ar.integration.event.search</field><field name="model">clinic.ar.integration.event</field><field name="arch" type="xml"><search><field name="name"/><field name="event_type"/><field name="model"/><filter name="pending" string="Pending" domain="[('state','=','pending')]"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><group><filter name="group_event" string="Event" context="{'group_by':'event_type'}"/><filter name="group_model" string="Model" context="{'group_by':'model'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_ar_integration_event_list" model="ir.ui.view"><field name="name">clinic.ar.integration.event.list</field><field name="model">clinic.ar.integration.event</field><field name="arch" type="xml"><list decoration-danger="state == 'failed'" decoration-success="state == 'done'"><field name="create_date"/><field name="event_type"/><field name="model"/><field name="res_id"/><field name="attempt_count"/><field name="next_attempt_at"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
  <record id="view_clinic_ar_integration_event_form" model="ir.ui.view"><field name="name">clinic.ar.integration.event.form</field><field name="model">clinic.ar.integration.event</field><field name="arch" type="xml"><form><header><button name="action_mark_done" string="Acknowledge" type="object" class="btn-primary" invisible="state in ('done','cancelled')"/><button name="action_retry" string="Retry" type="object" invisible="state not in ('failed','pending')"/><button name="action_cancel" string="Cancel" type="object" invisible="state in ('done','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="pending,processing,done,failed,cancelled"/></header><sheet><div class="oe_title"><h1><field name="event_type"/></h1></div><group><group><field name="name"/><field name="model"/><field name="res_id"/><field name="record_reference"/></group><group><field name="attempt_count"/><field name="next_attempt_at"/><field name="processed_at"/><field name="company_id"/></group></group><notebook><page string="Payload"><field name="payload_json" nolabel="1"/></page><page string="Error"><field name="last_error" nolabel="1"/></page></notebook></sheet></form></field></record>
  <record id="action_clinic_ar_integration_event" model="ir.actions.act_window"><field name="name">AR Integration Events</field><field name="res_model">clinic.ar.integration.event</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_ar_integration_event_search"/></record>
</odoo>



