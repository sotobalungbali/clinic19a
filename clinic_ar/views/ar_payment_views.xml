<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_clinic_ar_payment_search" model="ir.ui.view"><field name="name">clinic.ar.payment.search</field><field name="model">clinic.ar.payment</field><field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="invoice_id"/><field name="account_payment_id"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="posted" string="Posted" domain="[('state','=','posted')]"/><filter name="overpay" string="Open Credit" domain="[('is_overpay','=',True)]"/><group><filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/><filter name="group_method" string="Method" context="{'group_by':'method'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_ar_payment_list" model="ir.ui.view"><field name="name">clinic.ar.payment.list</field><field name="model">clinic.ar.payment</field><field name="arch" type="xml"><list decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="payment_date"/><field name="partner_id"/><field name="invoice_id"/><field name="method"/><field name="amount" sum="Receipts"/><field name="applied_amount" sum="Applied"/><field name="overpay_amount" sum="Open Credit"/><field name="account_payment_state" widget="badge" optional="show"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
  <record id="view_clinic_ar_payment_form" model="ir.ui.view"><field name="name">clinic.ar.payment.form</field><field name="model">clinic.ar.payment</field><field name="arch" type="xml"><form string="AR Receipt"><header><button name="action_post" string="Post &amp; Reconcile" type="object" class="btn-primary" invisible="state != 'draft'"/><button name="action_create_allocation" string="Allocate Open Credit" type="object" invisible="state != 'posted' or not is_overpay"/><button name="action_cancel" string="Cancel" type="object" invisible="state != 'posted'"/><button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'" groups="clinic_ar.group_clinic_ar_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,posted,cancelled"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_account_payment" type="object" class="oe_stat_button" icon="fa-bank" invisible="not account_payment_id"><field name="account_payment_id" string="Payment" widget="statinfo"/></button><button name="action_open_move" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_id"><field name="move_id" string="Journal Entry" widget="statinfo"/></button></div><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Receipt"><field name="invoice_id"/><field name="partner_id"/><field name="patient_id"/><field name="payment_date"/><field name="amount"/><field name="method"/><field name="journal_id"/><field name="communication"/></group><group string="Traceability"><field name="booking_id"/><field name="treatment_session_id"/><field name="membership_id"/><field name="billing_payment_id"/><field name="origin_ref"/><field name="company_id" groups="base.group_multi_company"/><field name="currency_id"/></group></group><group string="Settlement Snapshot"><field name="invoice_residual_snapshot"/><field name="applied_amount"/><field name="overpay_amount"/><field name="is_overpay"/><field name="account_payment_state"/></group><notebook><page string="Notes"><field name="note"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_clinic_ar_payment" model="ir.actions.act_window"><field name="name">AR Receipts</field><field name="res_model">clinic.ar.payment</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_ar_payment_search"/></record>
</odoo>

