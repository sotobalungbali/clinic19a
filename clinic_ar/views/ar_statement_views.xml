<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_clinic_ar_statement_search" model="ir.ui.view"><field name="name">clinic.ar.statement.search</field><field name="model">clinic.ar.statement</field><field name="arch" type="xml"><search><field name="name"/><field name="partner_id"/><field name="patient_id"/><filter name="generated" string="Generated" domain="[('state','=','generated')]"/><filter name="sent" string="Sent" domain="[('state','=','sent')]"/><group><filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_ar_statement_list" model="ir.ui.view"><field name="name">clinic.ar.statement.list</field><field name="model">clinic.ar.statement</field><field name="arch" type="xml"><list decoration-success="state == 'sent'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="statement_date"/><field name="partner_id"/><field name="date_from"/><field name="date_to"/><field name="closing_balance" sum="Closing"/><field name="overdue_balance" sum="Overdue"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
  <record id="view_clinic_ar_statement_form" model="ir.ui.view"><field name="name">clinic.ar.statement.form</field><field name="model">clinic.ar.statement</field><field name="arch" type="xml"><form><header><button name="action_generate" string="Generate / Refresh" type="object" class="btn-primary" invisible="state not in ('draft','generated')"/><button name="action_send" string="Mark Sent" type="object" class="btn-primary" invisible="state != 'generated'"/><button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/><button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'" groups="clinic_ar.group_clinic_ar_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,generated,sent,cancelled"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_customer" type="object" class="oe_stat_button" icon="fa-user"><field name="partner_id" string="Customer" widget="statinfo"/></button></div><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="partner_id"/><field name="patient_id"/><field name="statement_date"/><field name="date_from"/><field name="date_to"/><field name="include_paid"/></group><group><field name="opening_balance"/><field name="debit_total"/><field name="credit_total"/><field name="closing_balance"/><field name="overdue_balance"/><field name="sent_at"/><field name="company_id" groups="base.group_multi_company"/></group></group><field name="line_ids" readonly="1"><list><field name="document_date"/><field name="due_date"/><field name="reference"/><field name="description"/><field name="debit" sum="Debit"/><field name="credit" sum="Credit"/><field name="residual" sum="Residual"/><field name="is_overdue"/><button name="action_open_invoice" string="Invoice" type="object" icon="fa-external-link" invisible="not invoice_id"/></list></field><group><field name="note"/></group></sheet><chatter/></form></field></record>
  <record id="action_clinic_ar_statement" model="ir.actions.act_window"><field name="name">Customer Statements</field><field name="res_model">clinic.ar.statement</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_ar_statement_search"/></record>
  <record id="view_clinic_ar_statement_line_search" model="ir.ui.view"><field name="name">clinic.ar.statement.line.search</field><field name="model">clinic.ar.statement.line</field><field name="arch" type="xml"><search><field name="statement_id"/><field name="partner_id"/><field name="invoice_id"/><field name="reference"/><filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/><group><filter name="group_statement" string="Statement" context="{'group_by':'statement_id'}"/><filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search></field></record>
  <record id="view_clinic_ar_statement_line_list" model="ir.ui.view"><field name="name">clinic.ar.statement.line.list</field><field name="model">clinic.ar.statement.line</field><field name="arch" type="xml"><list decoration-danger="is_overdue"><field name="statement_id"/><field name="document_date"/><field name="due_date"/><field name="partner_id"/><field name="reference"/><field name="debit" sum="Debit"/><field name="credit" sum="Credit"/><field name="residual" sum="Residual"/><field name="is_overdue"/></list></field></record>
  <record id="view_clinic_ar_statement_line_form" model="ir.ui.view"><field name="name">clinic.ar.statement.line.form</field><field name="model">clinic.ar.statement.line</field><field name="arch" type="xml"><form><sheet><group><group><field name="statement_id"/><field name="partner_id"/><field name="invoice_id"/><field name="reference"/><field name="description"/></group><group><field name="document_date"/><field name="due_date"/><field name="debit"/><field name="credit"/><field name="residual"/><field name="is_overdue"/></group></group><button name="action_open_invoice" string="Open AR Invoice" type="object" class="btn-secondary" invisible="not invoice_id"/></sheet></form></field></record>
  <record id="action_clinic_ar_statement_line" model="ir.actions.act_window"><field name="name">AR Statement Lines</field><field name="res_model">clinic.ar.statement.line</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_ar_statement_line_search"/></record>
</odoo>

