<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Compatibility sequence consumed by clinic_encounter's legacy model. -->
    <record id="seq_clinic_audit_log" model="ir.sequence">
        <field name="name">Clinic Audit Legacy Log</field>
        <field name="code">clinic.audit.log</field>
        <field name="prefix">AUL/%(year)s/</field>
        <field name="padding">7</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_clinic_audit_event" model="ir.sequence">
        <field name="name">Clinic Audit Event</field>
        <field name="code">clinic.audit.event</field>
        <field name="prefix">AUE/%(year)s/</field>
        <field name="padding">8</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_clinic_audit_review" model="ir.sequence">
        <field name="name">Clinic Audit Review</field>
        <field name="code">clinic.audit.review</field>
        <field name="prefix">AUR/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_clinic_audit_verification" model="ir.sequence">
        <field name="name">Clinic Audit Verification</field>
        <field name="code">clinic.audit.verification</field>
        <field name="prefix">AUV/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
