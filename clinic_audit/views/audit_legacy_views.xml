<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_audit_legacy_log_search" model="ir.ui.view"><field name="name">clinic.audit.log.search.compliance</field><field name="model">clinic.audit.log</field><field name="arch" type="xml"><search string="Legacy Audit Logs"><field name="name"/><field name="ref_model"/><field name="ref_res_id"/><field name="user_id"/><field name="company_id"/><filter name="group_model" string="Model" context="{'group_by':'ref_model'}"/><filter name="group_category" string="Category" context="{'group_by':'category'}"/><filter name="group_day" string="Day" context="{'group_by':'date_event:day'}"/></search></field></record>
  <record id="view_audit_legacy_log_list" model="ir.ui.view"><field name="name">clinic.audit.log.list.compliance</field><field name="model">clinic.audit.log</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" default_order="date_event desc,id desc"><field name="date_event"/><field name="name"/><field name="category" widget="badge"/><field name="ref_model"/><field name="ref_display_name"/><field name="user_id"/><field name="company_id" groups="base.group_multi_company"/><field name="summary" optional="show"/></list></field></record>
  <record id="view_audit_legacy_log_form" model="ir.ui.view"><field name="name">clinic.audit.log.form.compliance</field><field name="model">clinic.audit.log</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_open_log" type="object" string="Open Legacy Log" class="btn-primary"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="date_event"/><field name="category"/><field name="user_id"/><field name="role"/><field name="reason_code"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="ref_model"/><field name="ref_res_id"/><field name="ref_display_name"/><field name="field_name"/></group></group><group string="Legacy Summary"><field name="summary"/><field name="note"/><field name="old_value_text"/><field name="new_value_text"/><field name="changes_json"/></group></sheet></form></field></record>
  <record id="action_audit_legacy_logs" model="ir.actions.act_window"><field name="name">Legacy Audit Logs</field><field name="res_model">clinic.audit.log</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_audit_legacy_log_search"/></record>

  <record id="view_audit_legacy_line_search" model="ir.ui.view"><field name="name">clinic.audit.log.line.search.compliance</field><field name="model">clinic.audit.log.line</field><field name="arch" type="xml"><search string="Legacy Audit Lines"><field name="log_id"/><field name="field_name"/><field name="company_id"/><filter name="group_field" string="Field" context="{'group_by':'field_name'}"/></search></field></record>
  <record id="view_audit_legacy_line_list" model="ir.ui.view"><field name="name">clinic.audit.log.line.list.compliance</field><field name="model">clinic.audit.log.line</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="log_id"/><field name="field_name"/><field name="field_label" optional="show"/><field name="field_type" optional="show"/><field name="change_kind"/><field name="before_short"/><field name="after_short"/><field name="delta_size" optional="show"/><button name="action_open_log" type="object" string="Open Log" icon="fa-external-link"/></list></field></record>
  <record id="view_audit_legacy_line_form" model="ir.ui.view"><field name="name">clinic.audit.log.line.form.compliance</field><field name="model">clinic.audit.log.line</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_open_log" type="object" string="Open Legacy Log" class="btn-primary"/></header><sheet><group><field name="log_id"/><field name="company_id" groups="base.group_multi_company"/><field name="field_name"/><field name="field_label"/><field name="field_type"/><field name="change_kind"/><field name="json_valid"/></group><group string="Before / After"><field name="before"/><field name="after"/></group></sheet></form></field></record>
  <record id="action_audit_legacy_lines" model="ir.actions.act_window"><field name="name">Legacy Audit Lines</field><field name="res_model">clinic.audit.log.line</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_audit_legacy_line_search"/></record>
</odoo>
