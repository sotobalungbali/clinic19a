<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_audit_policy_search" model="ir.ui.view"><field name="name">clinic.audit.policy.search</field><field name="model">clinic.audit.policy</field><field name="arch" type="xml"><search string="Audit Policies"><field name="name"/><field name="model_name"/><field name="company_id"/><field name="branch_id"/><filter name="active_state" string="Active Policies" domain="[('state','=','active')]"/><filter name="suspended" string="Suspended" domain="[('state','=','suspended')]"/><filter name="group_model" string="Model" context="{'group_by':'model_name'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></search></field></record>
  <record id="view_audit_policy_list" model="ir.ui.view"><field name="name">clinic.audit.policy.list</field><field name="model">clinic.audit.policy</field><field name="arch" type="xml"><list default_order="sequence,name" decoration-muted="state == 'suspended'"><field name="sequence" widget="handle"/><field name="name"/><field name="state" widget="badge"/><field name="model_name"/><field name="company_id" groups="base.group_multi_company"/><field name="branch_id" optional="show"/><field name="capture_mode"/><field name="severity" widget="badge"/><field name="audit_create"/><field name="audit_write"/><field name="audit_unlink"/></list></field></record>
  <record id="view_audit_policy_form" model="ir.ui.view"><field name="name">clinic.audit.policy.form</field><field name="model">clinic.audit.policy</field><field name="arch" type="xml"><form>
    <header><button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state == 'active'"/><button name="action_suspend" type="object" string="Suspend" invisible="state != 'active'"/><button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,suspended"/></header>
    <sheet><div class="oe_button_box" name="button_box"><button name="action_open_events" type="object" class="oe_stat_button" icon="fa-list"><span class="o_stat_text">Audit Events</span></button></div>
    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Scope"><field name="company_id" groups="base.group_multi_company"/><field name="branch_id"/><field name="model_id"/><field name="model_name" readonly="1"/><field name="sequence"/></group><group string="Capture"><field name="audit_create"/><field name="audit_write"/><field name="audit_unlink"/><field name="capture_mode"/><field name="severity"/><field name="auto_review_unlink"/></group></group>
    <notebook><page string="Field Policy"><group><field name="include_field_ids" widget="many2many_tags"/><field name="exclude_field_ids" widget="many2many_tags"/><field name="mask_field_ids" widget="many2many_tags"/></group></page><page string="Legacy Compatibility"><group><field name="trigger"/><field name="domain"/><field name="reason_required"/><field name="approval_required"/><field name="approver_ids" widget="many2many_tags"/><field name="notify_group_ids" widget="many2many_tags"/></group></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
  <record id="action_audit_policies" model="ir.actions.act_window"><field name="name">Audit Policies</field><field name="res_model">clinic.audit.policy</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_audit_policy_search"/></record>
</odoo>
