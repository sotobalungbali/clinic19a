<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_audit_review_tag_search" model="ir.ui.view"><field name="name">clinic.audit.review.tag.search</field><field name="model">clinic.audit.review.tag</field><field name="arch" type="xml"><search string="Review Tags"><field name="name"/><filter name="active" string="Active" domain="[('active','=',True)]"/></search></field></record>
  <record id="view_audit_review_tag_list" model="ir.ui.view"><field name="name">clinic.audit.review.tag.list</field><field name="model">clinic.audit.review.tag</field><field name="arch" type="xml"><list editable="bottom"><field name="name"/><field name="color" widget="color_picker"/><field name="active"/></list></field></record>
  <record id="view_audit_review_tag_form" model="ir.ui.view"><field name="name">clinic.audit.review.tag.form</field><field name="model">clinic.audit.review.tag</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="color" widget="color_picker"/><field name="active"/></group></sheet></form></field></record>
  <record id="action_audit_review_tags" model="ir.actions.act_window"><field name="name">Review Tags</field><field name="res_model">clinic.audit.review.tag</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_audit_review_tag_search"/></record>

  <record id="view_audit_review_line_search" model="ir.ui.view"><field name="name">clinic.audit.review.line.search</field><field name="model">clinic.audit.review.line</field><field name="arch" type="xml"><search string="Review Timeline"><field name="review_id"/><field name="user_id"/><field name="assignee_id"/><field name="action"/><field name="event_id"/><field name="log_id"/><field name="company_id"/><field name="branch_id"/><filter name="group_review" string="Review" context="{'group_by':'review_id'}"/><filter name="group_action" string="Action" context="{'group_by':'action'}"/></search></field></record>
  <record id="view_audit_review_line_list" model="ir.ui.view"><field name="name">clinic.audit.review.line.list</field><field name="model">clinic.audit.review.line</field><field name="arch" type="xml"><list default_order="date desc,id desc"><field name="date"/><field name="review_id"/><field name="action" widget="badge"/><field name="message"/><field name="user_id"/><field name="assignee_id" optional="show"/><field name="event_id" optional="show"/><button name="action_open_event" type="object" string="Open Event" invisible="not event_id"/><button name="action_open_log" type="object" string="Legacy Log" invisible="not log_id"/></list></field></record>
  <record id="view_audit_review_line_form" model="ir.ui.view"><field name="name">clinic.audit.review.line.form</field><field name="model">clinic.audit.review.line</field><field name="arch" type="xml"><form><header><button name="action_open_event" type="object" string="Open Event" class="btn-primary" invisible="not event_id"/><button name="action_open_log" type="object" string="Open Legacy Log" invisible="not log_id"/></header><sheet><group><group><field name="review_id"/><field name="date"/><field name="action"/><field name="user_id"/><field name="assignee_id"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="branch_id"/><field name="event_id"/><field name="log_id"/></group></group><field name="message"/><field name="attachment_ids" widget="many2many_binary"/></sheet></form></field></record>
  <record id="action_audit_review_lines" model="ir.actions.act_window"><field name="name">Review Timeline</field><field name="res_model">clinic.audit.review.line</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_audit_review_line_search"/></record>
</odoo>
