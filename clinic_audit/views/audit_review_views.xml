<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_audit_review_search" model="ir.ui.view"><field name="name">clinic.audit.review.search</field><field name="model">clinic.audit.review</field><field name="arch" type="xml"><search string="Compliance Reviews"><field name="name"/><field name="owner_id"/><field name="reviewer_id"/><field name="assignee_id"/><field name="company_id"/><field name="branch_id"/><field name="tag_ids"/><filter name="open" string="Open" domain="[('state','not in',['resolved','dismissed'])]"/><filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/><filter name="critical" string="Critical" domain="[('severity','=','critical')]"/><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_owner" string="Owner" context="{'group_by':'owner_id'}"/><filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/></search></field></record>
  <record id="view_audit_review_list" model="ir.ui.view"><field name="name">clinic.audit.review.list</field><field name="model">clinic.audit.review</field><field name="arch" type="xml"><list default_order="priority desc,due_date,id desc" decoration-danger="is_overdue or severity == 'critical'" decoration-warning="severity == 'high'"><field name="name"/><field name="state" widget="badge"/><field name="priority" widget="priority"/><field name="severity" widget="badge"/><field name="owner_id"/><field name="reviewer_id" optional="show"/><field name="branch_id" optional="show"/><field name="due_date"/><field name="event_count"/><field name="is_overdue" optional="show"/></list></field></record>
  <record id="view_audit_review_form" model="ir.ui.view"><field name="name">clinic.audit.review.form</field><field name="model">clinic.audit.review</field><field name="arch" type="xml"><form>
    <header><button name="action_start" type="object" string="Start Review" class="btn-primary" invisible="state not in ['draft','new','need_info']"/><button name="action_escalate" type="object" string="Escalate" invisible="state in ['resolved','dismissed','escalated']"/><button name="action_resolve" type="object" string="Resolve" invisible="state in ['resolved','dismissed']"/><button name="action_dismiss" type="object" string="Dismiss" invisible="state in ['resolved','dismissed']"/><button name="action_reopen" type="object" string="Reopen" invisible="state not in ['resolved','dismissed']"/><field name="state" widget="statusbar" statusbar_visible="draft,in_review,escalated,resolved,dismissed"/></header>
    <sheet><div class="oe_button_box" name="button_box"><button name="action_open_events" type="object" class="oe_stat_button" icon="fa-list"><field name="event_count" widget="statinfo" string="Events"/></button><button name="action_open_legacy_logs" type="object" class="oe_stat_button" icon="fa-history" groups="clinic_audit.group_audit_manager"><field name="log_count" widget="statinfo" string="Legacy Logs"/></button></div>
    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Governance"><field name="company_id" groups="base.group_multi_company"/><field name="branch_id"/><field name="severity"/><field name="priority" widget="priority"/><field name="category"/></group><group string="Assignment"><field name="owner_id"/><field name="reviewer_id"/><field name="assignee_id"/><field name="approver_id"/><field name="due_date"/><field name="is_overdue" readonly="1"/></group></group>
    <notebook><page string="Finding &amp; Resolution"><group><field name="finding"/><field name="root_cause"/><field name="corrective_action"/><field name="recommendation"/><field name="resolution"/></group></page>
      <page string="Evidence"><field name="event_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="date_event"/><field name="name"/><field name="action" widget="badge"/><field name="severity" widget="badge"/><field name="ref_model"/><field name="ref_display_name"/></list></field></page>
      <page string="Review Timeline"><field name="line_ids"><list editable="bottom"><field name="date"/><field name="action"/><field name="message"/><field name="user_id"/><field name="assignee_id" optional="show"/><field name="event_id" optional="show"/><field name="log_id" optional="hide"/><button name="action_open_event" type="object" string="Open Event" icon="fa-external-link" invisible="not event_id"/><button name="action_open_log" type="object" string="Legacy Log" icon="fa-history" invisible="not log_id"/></list></field></page>
      <page string="Legacy Evidence" groups="clinic_audit.group_audit_manager"><field name="log_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="date_event"/><field name="name"/><field name="category"/><field name="ref_model"/><field name="ref_display_name"/><field name="user_id"/></list></field></page>
      <page string="Additional"><group><field name="tag_ids" widget="many2many_tags"/><field name="policy_id"/><field name="attachment_ids" widget="many2many_binary"/><field name="opened_at"/><field name="closed_at"/><field name="duration_hours" readonly="1"/><field name="resolved_by_id" readonly="1"/><field name="resolved_at" readonly="1"/></group><field name="description"/></page>
    </notebook></sheet><chatter/></form></field></record>
  <record id="action_audit_reviews" model="ir.actions.act_window"><field name="name">Compliance Reviews</field><field name="res_model">clinic.audit.review</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_audit_review_search"/></record>
</odoo>
