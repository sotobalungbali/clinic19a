<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_audit_verification_search" model="ir.ui.view"><field name="name">clinic.audit.verification.search</field><field name="model">clinic.audit.verification</field><field name="arch" type="xml"><search string="Integrity Verification"><field name="name"/><field name="company_id"/><field name="branch_id"/><field name="run_by_id"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><filter name="passed" string="Passed" domain="[('state','=','passed')]"/><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/></search></field></record>
  <record id="view_audit_verification_list" model="ir.ui.view"><field name="name">clinic.audit.verification.list</field><field name="model">clinic.audit.verification</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" default_order="id desc" decoration-danger="state == 'failed'" decoration-success="state == 'passed'"><field name="name"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/><field name="branch_id"/><field name="checked_count"/><field name="failure_count"/><field name="run_by_id"/><field name="run_at"/></list></field></record>
  <record id="view_audit_verification_form" model="ir.ui.view"><field name="name">clinic.audit.verification.form</field><field name="model">clinic.audit.verification</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_run" type="object" string="Run Verification" class="btn-primary" groups="clinic_audit.group_audit_manager" invisible="state == 'running'"/><button name="action_open_failure" type="object" string="Open First Failure" invisible="not first_failure_event_id"/><field name="state" widget="statusbar" statusbar_visible="draft,running,passed,failed"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Scope"><field name="company_id" groups="base.group_multi_company"/><field name="branch_id"/><field name="date_from"/><field name="date_to"/><field name="single_event_id"/></group><group string="Result"><field name="checked_count"/><field name="failure_count"/><field name="first_failure_event_id"/><field name="run_by_id"/><field name="run_at"/></group></group><field name="result_summary"/></sheet></form></field></record>
  <record id="action_audit_verifications" model="ir.actions.act_window"><field name="name">Integrity Verification</field><field name="res_model">clinic.audit.verification</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_audit_verification_search"/><field name="context">{'create': False}</field></record>
</odoo>
