<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_clinic_billing_invoice_search" model="ir.ui.view">
        <field name="name">clinic.billing.invoice.search</field>
        <field name="model">clinic.billing.invoice</field>
        <field name="arch" type="xml">
            <search string="Clinic Billing">
                <field name="name"/>
                <field name="clinic_patient_id"/>
                <field name="patient_id"/>
                <field name="clinic_doctor_id"/>
                <field name="booking_id"/>
                <field name="encounter_id"/>
                <field name="care_plan_id"/>
                <field name="package_allocation_id"/>
                <field name="external_origin"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="paid" string="Paid" domain="[('state','=','paid')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue','=',True)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Patient" name="group_patient" context="{'group_by':'clinic_patient_id'}"/>
                    <filter string="Doctor" name="group_doctor" context="{'group_by':'clinic_doctor_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}"/>
                    <filter string="Invoice Month" name="group_month" context="{'group_by':'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_clinic_billing_invoice_list" model="ir.ui.view">
        <field name="name">clinic.billing.invoice.list</field>
        <field name="model">clinic.billing.invoice</field>
        <field name="arch" type="xml">
            <list string="Clinic Billing" decoration-success="state == 'paid'" decoration-danger="is_overdue and state not in ('paid','cancelled')" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="clinic_patient_id"/>
                <field name="clinic_doctor_id" optional="show"/>
                <field name="booking_id" optional="hide"/>
                <field name="encounter_id" optional="hide"/>
                <field name="amount_untaxed" sum="Untaxed"/>
                <field name="amount_tax" sum="Tax"/>
                <field name="amount_total" sum="Total"/>
                <field name="amount_residual" sum="Due"/>
                <field name="payment_state" widget="badge" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_billing_invoice_form" model="ir.ui.view">
        <field name="name">clinic.billing.invoice.form</field>
        <field name="model">clinic.billing.invoice</field>
        <field name="arch" type="xml">
            <form string="Clinic Billing Invoice">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'" groups="clinic_billing.group_clinic_billing_user"/>
                    <button name="action_generate_account_move" type="object" string="Generate Accounting Invoice" class="btn-primary" invisible="state not in ('draft','confirmed') or move_id" groups="clinic_billing.group_clinic_billing_manager"/>
                    <button name="action_sync_lines_to_account_move" type="object" string="Sync Accounting Lines" invisible="not move_id or move_state != 'draft'" groups="clinic_billing.group_clinic_billing_manager"/>
                    <button name="action_post_account_move" type="object" string="Post Accounting Invoice" class="btn-primary" invisible="not move_id or move_state == 'posted'" groups="clinic_billing.group_clinic_billing_manager"/>
                    <button name="action_register_split_payment" type="object" string="Register Payment" class="btn-primary" invisible="state not in ('posted','paid')" groups="clinic_billing.group_clinic_billing_cashier"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state not in ('confirmed','cancelled') or move_state == 'posted'" groups="clinic_billing.group_clinic_billing_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('paid','cancelled')" groups="clinic_billing.group_clinic_billing_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,posted,paid,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_account_move" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not move_id">
                            <field name="move_id" widget="statinfo" string="Accounting"/>
                        </button>
                        <button name="action_open_billing_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="billing_payments_count" widget="statinfo" string="Payments"/>
                        </button>
                        <button name="action_open_gateway_txs" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="gateway_tx_count" widget="statinfo" string="Gateway"/>
                        </button>
                        <button name="action_open_commissions" type="object" class="oe_stat_button" icon="fa-percent">
                            <field name="commissions_count" widget="statinfo" string="Commissions"/>
                        </button>
                        <button name="action_open_treatment_links" type="object" class="oe_stat_button" icon="fa-link">
                            <field name="treatment_line_count" widget="statinfo" string="Clinical Links"/>
                        </button>
                        <button name="action_open_emar_lines" type="object" class="oe_stat_button" icon="fa-medkit">
                            <field name="emar_line_count" widget="statinfo" string="eMAR"/>
                        </button>
                        <button name="action_open_package_lines" type="object" class="oe_stat_button" icon="fa-gift">
                            <field name="package_line_count" widget="statinfo" string="Package"/>
                        </button>
                        <button name="action_open_integration_events" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="integration_event_count" widget="statinfo" string="Events"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="PAID" bg_color="text-bg-success" invisible="state != 'paid'"/>
                    <widget name="web_ribbon" title="OVERDUE" bg_color="text-bg-danger" invisible="not is_overdue or state in ('paid','cancelled')"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>

                    <group>
                        <group string="Clinical Context">
                            <field name="clinic_patient_id" options="{'no_create_edit': True}" readonly="state not in ('draft','confirmed')"/>
                            <field name="patient_id" readonly="state not in ('draft','confirmed')"/>
                            <field name="clinic_doctor_id" readonly="state not in ('draft','confirmed')"/>
                            <field name="clinic_warehouse_id" readonly="state not in ('draft','confirmed')"/>
                            <field name="booking_id" readonly="state not in ('draft','confirmed')"/>
                            <field name="encounter_id" readonly="state not in ('draft','confirmed')"/>
                            <field name="care_plan_id" readonly="state not in ('draft','confirmed')"/>
                            <field name="package_allocation_id" readonly="state not in ('draft','confirmed')"/>
                            <field name="clinical_ref" readonly="state not in ('draft','confirmed')"/>
                        </group>
                        <group string="Billing &amp; Accounting">
                            <field name="invoice_date"/>
                            <field name="invoice_date_due"/>
                            <field name="pricelist_id"/>
                            <field name="payment_term_id"/>
                            <field name="fiscal_position_id"/>
                            <field name="journal_id"/>
                            <field name="external_origin"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <div class="d-flex gap-2 mb-3">
                        <button name="action_import_from_booking" type="object" string="Import Booking" class="btn btn-secondary" icon="fa-calendar" invisible="not booking_id or state not in ('draft','confirmed')"/>
                        <button name="action_import_from_care_plan" type="object" string="Import Care Plan" class="btn btn-secondary" icon="fa-list-alt" invisible="not care_plan_id or state not in ('draft','confirmed')"/>
                        <button name="action_import_from_emar" type="object" string="Import eMAR" class="btn btn-secondary" icon="fa-medkit" invisible="not clinic_patient_id or state not in ('draft','confirmed')"/>
                        <button name="action_compute_discounts_now" type="object" string="Recompute Discounts" class="btn btn-secondary" invisible="state not in ('draft','confirmed')"/>
                        <button name="action_apply_voucher_codes" type="object" string="Apply Vouchers" class="btn btn-secondary" invisible="state not in ('draft','confirmed')"/>
                        <button name="action_compute_commission_now" type="object" string="Compute Commission" class="btn btn-secondary" invisible="state == 'cancelled'"/>
                    </div>

                    <notebook>
                        <page string="Billing Lines" name="billing_lines">
                            <field name="line_ids" context="{'default_invoice_id': id}" readonly="move_state == 'posted'">
                                <list editable="bottom" string="Billing Lines">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type" column_invisible="True"/>
                                    <field name="product_id" required="not display_type"/>
                                    <field name="name"/>
                                    <field name="quantity" required="not display_type"/>
                                    <field name="product_uom_id" optional="show"/>
                                    <field name="unit_price" required="not display_type"/>
                                    <field name="discount_percent" optional="show"/>
                                    <field name="discount_amount" optional="hide"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="show"/>
                                    <field name="subtotal_excl_tax" sum="Subtotal"/>
                                    <field name="tax_amount" sum="Tax" optional="show"/>
                                    <field name="total_incl_tax" sum="Total"/>
                                    <field name="booking_id" optional="hide"/>
                                    <field name="care_plan_line_id" optional="hide"/>
                                    <field name="package_usage_id" optional="hide"/>
                                    <field name="emar_administration_id" optional="hide"/>
                                    <button name="action_open_clinical_source" type="object" icon="fa-external-link" title="Open Clinical Source"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                <field name="amount_residual"/>
                            </group>
                        </page>
                        <page string="Coverage &amp; Benefits">
                            <group>
                                <group string="Insurance">
                                    <field name="insurance_policy_number"/>
                                    <field name="insurance_coverage_percent"/>
                                    <field name="insurance_claim_state" widget="badge"/>
                                    <button name="action_new_insurance_claim" type="object" string="Prepare Claim" class="btn btn-secondary"/>
                                    <button name="action_open_insurance_claims" type="object" string="View Claims" class="btn btn-link"/>
                                </group>
                                <group string="Voucher / Membership">
                                    <field name="voucher_code"/>
                                    <field name="discount_note"/>
                                    <field name="membership_reference"/>
                                    <field name="membership_amount_used"/>
                                    <field name="commission_policy"/>
                                    <field name="commission_amount"/>
                                </group>
                            </group>
                        </page>
                        <page string="Accounting">
                            <group>
                                <field name="move_id" readonly="1"/>
                                <field name="move_state" widget="badge"/>
                                <field name="payment_state" widget="badge"/>
                                <field name="patient_outstanding_amount" readonly="1"/>
                                <field name="patient_last_payment_date" readonly="1"/>
                            </group>
                            <field name="move_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="amount_currency"/>
                                    <field name="reconciled"/>
                                </list>
                            </field>
                        </page>
                        <page string="Internal Notes">
                            <field name="note" placeholder="Internal billing notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_clinic_billing_invoice" model="ir.actions.act_window">
        <field name="name">Billing Documents</field>
        <field name="res_model">clinic.billing.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_billing_invoice_search"/>
    </record>

    <record id="view_clinic_billing_line_search" model="ir.ui.view">
        <field name="name">clinic.billing.line.search</field>
        <field name="model">clinic.billing.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="invoice_id"/>
                <field name="product_id"/>
                <field name="treatment_id"/>
                <field name="booking_id"/>
                <field name="encounter_id"/>
                <field name="care_plan_id"/>
                <field name="package_usage_id"/>
                <field name="emar_administration_id"/>
                <field name="provider_partner_id"/>
                <group>
                    <filter string="Invoice" context="{'group_by':'invoice_id'}" name="group_invoice_id"/>
                    <filter string="Product" context="{'group_by':'product_id'}" name="group_product_id"/>
                    <filter string="Provider" context="{'group_by':'provider_partner_id'}" name="group_provider_partner_id"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_clinic_billing_line_list" model="ir.ui.view">
        <field name="name">clinic.billing.line.list</field>
        <field name="model">clinic.billing.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="invoice_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="discount_percent"/>
                <field name="subtotal_excl_tax" sum="Subtotal"/>
                <field name="tax_amount" sum="Tax"/>
                <field name="total_incl_tax" sum="Total"/>
                <field name="provider_partner_id"/>
                <field name="performed_datetime"/>
                <button name="action_open_clinical_source" type="object" icon="fa-external-link"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_billing_line_form" model="ir.ui.view">
        <field name="name">clinic.billing.line.form</field>
        <field name="model">clinic.billing.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_clinical_source" type="object" class="oe_stat_button" icon="fa-external-link"><span>Clinical Source</span></button>
                        <button name="action_recompute_commission" type="object" class="oe_stat_button" icon="fa-percent"><span>Commission</span></button>
                    </div>
                    <group>
                        <group>
                            <field name="invoice_id"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                            <field name="unit_price"/>
                            <field name="discount_percent"/>
                            <field name="discount_amount"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Traceability">
                            <field name="treatment_id"/>
                            <field name="booking_id"/>
                            <field name="encounter_id"/>
                            <field name="care_plan_id"/>
                            <field name="care_plan_line_id"/>
                            <field name="package_usage_id"/>
                            <field name="emar_administration_id"/>
                            <field name="treatment_usage_id"/>
                            <field name="room_id"/>
                            <field name="device_id"/>
                            <field name="performed_datetime"/>
                            <field name="provider_partner_id"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <field name="subtotal_excl_tax"/>
                        <field name="tax_amount"/>
                        <field name="total_incl_tax"/>
                        <field name="commission_percent"/>
                        <field name="commission_amount"/>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_clinic_billing_line" model="ir.actions.act_window">
        <field name="name">Billing Lines</field>
        <field name="res_model">clinic.billing.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_billing_line_search"/>
    </record>
</odoo>



