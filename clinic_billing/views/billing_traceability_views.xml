<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="view_clinic_treatment_billing_link_search" model="ir.ui.view">
        <field name="name">clinic.treatment.billing.link.search</field>
        <field name="model">clinic.treatment.billing.link</field>
        <field name="arch" type="xml">
            <search>
                <field name="billing_line_id"/>
                <field name="invoice_id"/>
                <field name="patient_id"/>
                <field name="origin_model"/>
                <field name="origin_id"/>
                <field name="origin_name"/>
                <group><filter string="Company" context="{'group_by':'company_id'}" name="group_company_id"/></group>
            </search>
        </field>
    </record>
    <record id="view_clinic_treatment_billing_link_list" model="ir.ui.view">
        <field name="name">clinic.treatment.billing.link.list</field>
        <field name="model">clinic.treatment.billing.link</field>
        <field name="arch" type="xml">
            <list>
                <field name="billing_line_id" optional="show"/>
                <field name="invoice_id" optional="show"/>
                <field name="patient_id" optional="show"/>
                <field name="origin_model" optional="show"/>
                <field name="origin_id" optional="show"/>
                <field name="origin_name" optional="show"/>
                <field name="company_id" optional="show"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_treatment_billing_link_form" model="ir.ui.view">
        <field name="name">clinic.treatment.billing.link.form</field>
        <field name="model">clinic.treatment.billing.link</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_origin" type="object" string="Open Origin"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="billing_line_id"/></h1></div>
                    <group>
                        <group>
                            <field name="billing_line_id"/>
                            <field name="invoice_id"/>
                            <field name="patient_id"/>
                            <field name="origin_model"/>
                        </group>
                        <group>
                            <field name="origin_id"/>
                            <field name="origin_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_clinic_treatment_billing_link" model="ir.actions.act_window">
        <field name="name">Link</field>
        <field name="res_model">clinic.treatment.billing.link</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_treatment_billing_link_search"/>
    </record>

    <record id="view_clinic_billing_integration_event_search" model="ir.ui.view">
        <field name="name">clinic.billing.integration.event.search</field>
        <field name="model">clinic.billing.integration.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="event_type"/>
                <field name="invoice_id"/>
                <field name="payment_id"/>
                <field name="created_on"/>
                <field name="state"/>
                <field name="processed_on"/>
                <field name="retry_count"/>
                <filter name="active_state" string="Active States" domain="[('state','not in',('cancelled','canceled','failed','ignored'))]"/>
                <group><filter string="Status" context="{'group_by':'state'}" name="group_state"/></group>
            </search>
        </field>
    </record>
    <record id="view_clinic_billing_integration_event_list" model="ir.ui.view">
        <field name="name">clinic.billing.integration.event.list</field>
        <field name="model">clinic.billing.integration.event</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled','canceled','ignored')">
                <field name="name" optional="show"/>
                <field name="event_type" optional="show"/>
                <field name="invoice_id" optional="show"/>
                <field name="payment_id" optional="show"/>
                <field name="created_on" optional="show"/>
                <field name="state" optional="show"/>
                <field name="processed_on" optional="show"/>
                <field name="retry_count" optional="show"/>
                <field name="error_message" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="payload" optional="hide"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_billing_integration_event_form" model="ir.ui.view">
        <field name="name">clinic.billing.integration.event.form</field>
        <field name="model">clinic.billing.integration.event</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_processed" type="object" string="Mark Processed" class="btn-primary"/>
                    <button name="action_retry" type="object" string="Retry"/>
                    <button name="action_ignore" type="object" string="Ignore"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="event_type"/>
                            <field name="invoice_id"/>
                            <field name="payment_id"/>
                            <field name="created_on"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="processed_on"/>
                            <field name="retry_count"/>
                            <field name="error_message"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="payload" nolabel="1"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_clinic_billing_integration_event" model="ir.actions.act_window">
        <field name="name">Event</field>
        <field name="res_model">clinic.billing.integration.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_billing_integration_event_search"/>
    </record>
</odoo>



