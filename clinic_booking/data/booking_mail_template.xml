<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Default fallback required by BookingFeedbackLink._get_mail_template().
    The sending method supplies email_to explicitly from patient_id.email.
  -->
  <record id="booking_feedback_email_template" model="mail.template">
    <field name="name">Clinic Booking: Feedback Invitation</field>
    <field name="model_id" ref="model_booking_feedback_link"/>
    <field name="subject">We value your feedback — {{ object.booking_id.name or object.name }}</field>
    <field name="body_html" type="html">
      <div>
        <p>Hello <t t-out="object.patient_id.name or 'Patient'"/>,</p>
        <p>Thank you for visiting us. We would appreciate your feedback about your recent booking.</p>
        <p>
          <a t-att-href="object.access_url">Open feedback form</a>
        </p>
        <p t-if="object.doctor_id">Doctor: <t t-out="object.doctor_id.display_name"/></p>
        <p t-if="object.treatment_id">Treatment: <t t-out="object.treatment_id.display_name"/></p>
        <p>Thank you.</p>
      </div>
    </field>
    <field name="auto_delete" eval="True"/>
  </record>
</odoo>
