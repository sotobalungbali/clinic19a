

<odoo noupdate="1">
  <record id="sequence_booking" model="ir.sequence">
    <field name="name">Clinic Booking</field>
    <field name="code">booking.booking</field>
    <field name="prefix">BK/%(year)s/</field>
    <field name="padding">5</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="sequence_booking_feedback" model="ir.sequence">
    <field name="name">Booking Feedback Link</field>
    <field name="code">booking.feedback.link</field>
    <field name="prefix">FB/%(year)s/</field>
    <field name="padding">5</field>
    <field name="company_id" eval="False"/>
  </record>
</odoo>
