          <notebook>
            <page string="Channel">
              <field name="channel_ids"/>
            </page>
            <page string="Exception">
              <field name="exception_ids"/>
            </page>
            <page string="Notes &amp; Details">
              <field name="description"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
