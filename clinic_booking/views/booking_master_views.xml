<odoo>
  <record id="view_booking_tag_search" model="ir.ui.view">
    <field name="name">booking.tag.search</field>
    <field name="model">booking.tag</field>
    <field name="arch" type="xml">
      <search string="Search Tag">
        <field name="name"/>
        <field name="active"/>
        <field name="company_id"/>
        <field name="color"/>
        <group>
          <filter name="group_by_company_id" string="Company" context="{'group_by': 'company_id'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_booking_tag_list" model="ir.ui.view">
    <field name="name">booking.tag.list</field>
    <field name="model">booking.tag</field>
    <field name="arch" type="xml">
      <list string="Tag">
        <field name="name"/>
        <field name="color"/>
        <field name="active"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_booking_tag_form" model="ir.ui.view">
    <field name="name">booking.tag.form</field>
    <field name="model">booking.tag</field>
    <field name="arch" type="xml">
      <form string="Tag">
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="color"/>
            </group>
            <group>
              <field name="active"/>
              <field name="company_id"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_booking_channel_search" model="ir.ui.view">
    <field name="name">booking.channel.search</field>
    <field name="model">booking.channel</field>
    <field name="arch" type="xml">
      <search string="Search Channel">
        <field name="name"/>
        <field name="code"/>
        <field name="policy_id"/>
        <field name="active"/>
        <field name="company_id"/>
        <field name="channel_type"/>
        <group>
          <filter name="group_by_company_id" string="Company" context="{'group_by': 'company_id'}"/>
          <filter name="group_by_policy_id" string="Policy" context="{'group_by': 'policy_id'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_booking_channel_list" model="ir.ui.view">
    <field name="name">booking.channel.list</field>
    <field name="model">booking.channel</field>
    <field name="arch" type="xml">
      <list string="Channel">
        <field name="name"/>
        <field name="code"/>
        <field name="channel_type"/>
        <field name="active"/>
        <field name="sequence"/>
        <field name="color"/>
        <field name="is_online"/>
        <field name="website_published"/>
        <field name="website_route"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="view_booking_channel_form" model="ir.ui.view">
    <field name="name">booking.channel.form</field>
    <field name="model">booking.channel</field>
    <field name="arch" type="xml">
      <form string="Channel">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar">
              <field name="bookings_count" widget="statinfo" string="Bookings"/>
            </button>
          </div>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="channel_type"/>
              <field name="active"/>
              <field name="sequence"/>
              <field name="color"/>
              <field name="company_id"/>
              <field name="currency_id"/>
              <field name="is_online"/>
              <field name="website_published"/>
              <field name="website_route"/>
            </group>
            <group>
              <field name="policy_id"/>
              <field name="reminder_template_id"/>
              <field name="feedback_template_id"/>
              <field name="allow_prepaid_deposit"/>
              <field name="deposit_is_required"/>
              <field name="deposit_fixed_amount"/>
              <field name="deposit_percent"/>
              <field name="auto_create_appointment"/>
              <field name="lock_slot_on_confirm"/>
              <field name="bookings_count"/>
              <field name="last_booking_id"/>
            </group>
          </group>
          <notebook>
            <page string="Notes &amp; Details">
              <field name="description"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_booking_policy_search" model="ir.ui.view">
    <field name="name">booking.policy.search</field>
