

<odoo>
  <record id="action_booking_channel_list" model="ir.actions.act_window">
    <field name="name">Booking Channels</field>
    <field name="res_model">booking.channel</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_booking_channel_search"/>
  </record>

  <record id="action_booking_policy_list" model="ir.actions.act_window">
    <field name="name">Booking Policies</field>
    <field name="res_model">booking.policy</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_booking_policy_search"/>
  </record>

  <record id="action_booking_room_list" model="ir.actions.act_window">
    <field name="name">Booking Rooms</field>
    <field name="res_model">booking.room</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_booking_room_search"/>
  </record>

  <record id="action_booking_resource_list" model="ir.actions.act_window">
    <field name="name">Booking Resources</field>
    <field name="res_model">booking.resource</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_booking_resource_search"/>
  </record>

  <record id="action_booking_slot_list" model="ir.actions.act_window">
    <field name="name">Booking Slots</field>
    <field name="res_model">booking.slot</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_booking_slot_search"/>
  </record>

  <record id="action_booking_recurring_rule_list" model="ir.actions.act_window">
    <field name="name">Recurring Rules</field>
    <field name="res_model">booking.recurring.rule</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_booking_recurring_rule_search"/>
  </record>

  <record id="action_booking_feedback_link_list" model="ir.actions.act_window">
    <field name="name">Feedback Links</field>
    <field name="res_model">booking.feedback.link</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_booking_feedback_link_search"/>
  </record>

  <record id="action_booking_tag_list" model="ir.actions.act_window">
    <field name="name">Booking Tags</field>
    <field name="res_model">booking.tag</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_booking_tag_search"/>
  </record>

  <menuitem id="menu_clinic_booking_root" name="Clinic Booking" sequence="40" groups="base.group_user"/>
  <menuitem id="menu_clinic_booking_operations" name="Operations" parent="menu_clinic_booking_root" sequence="10"/>
  <menuitem id="menu_clinic_booking_schedule" name="Scheduling" parent="menu_clinic_booking_root" sequence="20"/>
  <menuitem id="menu_clinic_booking_configuration" name="Configuration" parent="menu_clinic_booking_root" sequence="90"/>

  <menuitem id="menu_booking_bookings" name="Bookings" parent="menu_clinic_booking_operations" action="action_booking_list" sequence="10"/>
  <menuitem id="menu_booking_feedback" name="Feedback Links" parent="menu_clinic_booking_operations" action="action_booking_feedback_link_list" sequence="30"/>

  <menuitem id="menu_booking_slots" name="Slots" parent="menu_clinic_booking_schedule" action="action_booking_slot_list" sequence="10"/>
  <menuitem id="menu_booking_recurring_rules" name="Recurring Rules" parent="menu_clinic_booking_schedule" action="action_booking_recurring_rule_list" sequence="20"/>

  <menuitem id="menu_booking_channels" name="Channels" parent="menu_clinic_booking_configuration" action="action_booking_channel_list" sequence="10"/>
  <menuitem id="menu_booking_policies" name="Policies" parent="menu_clinic_booking_configuration" action="action_booking_policy_list" sequence="20"/>
  <menuitem id="menu_booking_rooms" name="Rooms" parent="menu_clinic_booking_configuration" action="action_booking_room_list" sequence="30"/>
  <menuitem id="menu_booking_resources" name="Resources" parent="menu_clinic_booking_configuration" action="action_booking_resource_list" sequence="40"/>
  <menuitem id="menu_booking_tags" name="Tags" parent="menu_clinic_booking_configuration" action="action_booking_tag_list" sequence="50"/>
</odoo>
