  <record id="view_booking_slot_form" model="ir.ui.view">
    <field name="name">booking.slot.form</field>
    <field name="model">booking.slot</field>
    <field name="arch" type="xml">
      <form string="Slot">
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-calendar">
              <field name="bookings_count" widget="statinfo" string="Bookings"/>
            </button>
          </div>
          <div class="oe_title">
            <button name="action_new_booking" type="object" string="New Booking" class="btn btn-secondary"/>
          </div>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="active"/>
              <field name="sequence"/>
              <field name="color"/>
              <field name="company_id"/>
              <field name="currency_id"/>
              <field name="doctor_id"/>
              <field name="room_id"/>
              <field name="treatment_id"/>
              <field name="channel_id"/>
              <field name="policy_id"/>
            </group>
            <group>
              <field name="weekday"/>
              <field name="hour_from"/>
              <field name="hour_to"/>
              <field name="duration_minutes"/>
              <field name="date_start"/>
              <field name="date_end"/>
              <field name="capacity"/>
              <field name="buffer_before_minutes"/>
              <field name="buffer_after_minutes"/>
              <field name="recurring_rule_id"/>
              <field name="bookings_count"/>
              <field name="last_booking_id"/>
            </group>
          </group>
          <notebook>
            <page string="Resource">
              <field name="resource_ids"/>
            </page>
            <page string="Notes &amp; Details">
              <field name="description"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
