<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        HARD GATE 10:
        UI groups never replace record-level protection. Branch data remains
        constrained by explicit record rules and model guardrails.
    -->
    <record id="group_branch_user" model="res.groups">
        <field name="name">Clinic Branch User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_branch_manager" model="res.groups">
        <field name="name">Clinic Branch Manager</field>
        <field name="implied_ids" eval="[(4, ref('clinic_branch.group_branch_user'))]"/>
    </record>

    <record id="rule_branch_internal_scope" model="ir.rule">
        <field name="name">Clinic Branch: allowed branch scope</field>
        <field name="model_id" ref="model_clinic_branch"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('id', 'in', user.allowed_branch_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_branch_manager_all" model="ir.rule">
        <field name="name">Clinic Branch Manager: company scope</field>
        <field name="model_id" ref="model_clinic_branch"/>
        <field name="groups" eval="[(4, ref('clinic_branch.group_branch_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_branch_location_internal_scope" model="ir.rule">
        <field name="name">Clinic Branch Location: allowed branch scope</field>
        <field name="model_id" ref="model_clinic_branch_location"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('branch_id', 'in', user.allowed_branch_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_branch_location_manager_all" model="ir.rule">
        <field name="name">Clinic Branch Location Manager: company scope</field>
        <field name="model_id" ref="model_clinic_branch_location"/>
        <field name="groups" eval="[(4, ref('clinic_branch.group_branch_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
