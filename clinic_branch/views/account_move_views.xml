<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_clinic_branch" model="ir.ui.view">
        <field name="name">account.move.form.clinic.branch</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="branch_id" groups="clinic_branch.group_branch_user"/>
            </xpath>
        </field>
    </record>
</odoo>
