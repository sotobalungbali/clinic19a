<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_clinic_branch" model="ir.ui.view">
        <field name="name">hr.employee.form.clinic.branch</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="branch_id" groups="clinic_branch.group_branch_user"/>
                <field name="branch_location_id" groups="clinic_branch.group_branch_user"/>
            </xpath>
        </field>
    </record>
</odoo>
