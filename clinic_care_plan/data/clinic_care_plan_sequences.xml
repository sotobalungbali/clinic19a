<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_clinic_care_plan" model="ir.sequence">
        <field name="name">Care Plan</field>
        <field name="code">clinic.care.plan</field>
        <field name="prefix">CP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_clinic_care_protocol" model="ir.sequence">
        <field name="name">Care Protocol</field>
        <field name="code">clinic.care.protocol</field>
        <field name="prefix">CPR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
