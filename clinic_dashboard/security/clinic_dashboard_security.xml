<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dashboard" model="ir.module.category">
        <field name="name">ClinicOne Dashboard</field>
        <field name="sequence">67</field>
    </record>

    <record id="privilege_dashboard" model="res.groups.privilege">
        <field name="name">ClinicOne Dashboard</field>
        <field name="category_id" ref="clinic_dashboard.module_category_dashboard"/>
        <field name="sequence">67</field>
    </record>

    <record id="group_dashboard_user" model="res.groups">
        <field name="name">Dashboard User</field>
        <field name="privilege_id" ref="clinic_dashboard.privilege_dashboard"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('clinic_reports.group_reports_user'))
        ]"/>
    </record>

    <record id="group_dashboard_analyst" model="res.groups">
        <field name="name">Dashboard Analyst</field>
        <field name="privilege_id" ref="clinic_dashboard.privilege_dashboard"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_dashboard.group_dashboard_user')),
            Command.link(ref('clinic_reports.group_reports_analyst'))
        ]"/>
    </record>

    <record id="group_dashboard_manager" model="res.groups">
        <field name="name">Dashboard Manager</field>
        <field name="privilege_id" ref="clinic_dashboard.privilege_dashboard"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_dashboard.group_dashboard_analyst')),
            Command.link(ref('clinic_reports.group_reports_manager'))
        ]"/>
    </record>

    <record id="rule_dashboard_board_company" model="ir.rule">
        <field name="name">Dashboard Board: allowed companies</field>
        <field name="model_id" ref="model_clinic_dashboard_board"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_dashboard.group_dashboard_user'))]"/>
    </record>

    <record id="rule_dashboard_widget_company" model="ir.rule">
        <field name="name">Dashboard Widget: allowed companies</field>
        <field name="model_id" ref="model_clinic_dashboard_widget"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_dashboard.group_dashboard_user'))]"/>
    </record>

    <record id="rule_dashboard_snapshot_company" model="ir.rule">
        <field name="name">Dashboard Snapshot: allowed companies</field>
        <field name="model_id" ref="model_clinic_dashboard_snapshot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_dashboard.group_dashboard_user'))]"/>
    </record>

    <record id="rule_dashboard_snapshot_line_company" model="ir.rule">
        <field name="name">Dashboard Snapshot KPI: allowed companies</field>
        <field name="model_id" ref="model_clinic_dashboard_snapshot_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_dashboard.group_dashboard_user'))]"/>
    </record>
</odoo>

