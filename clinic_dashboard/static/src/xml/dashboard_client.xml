<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="clinic_dashboard.ClientAction" owl="1">
        <div class="o_clinic_dashboard h-100 overflow-auto">
            <div class="o_clinic_dashboard_toolbar sticky-top">
                <div class="container-fluid py-3">
                    <div class="d-flex flex-wrap align-items-end gap-3">
                        <div class="flex-grow-1">
                            <label class="form-label mb-1">Dashboard</label>
                            <select class="form-select"
                                    t-att-value="state.selectedBoardId || ''"
                                    t-on-change="onBoardChange">
                                <t t-foreach="state.boards" t-as="board" t-key="board.id">
                                    <option t-att-value="board.id"
                                            t-att-selected="board.id === state.selectedBoardId">
                                        <t t-esc="board.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div>
                            <label class="form-label mb-1">Date From</label>
                            <input type="date"
                                   class="form-control"
                                   t-model="state.dateFrom"/>
                        </div>

                        <div>
                            <label class="form-label mb-1">Date To</label>
                            <input type="date"
                                   class="form-control"
                                   t-model="state.dateTo"/>
                        </div>

                        <div>
                            <label class="form-label mb-1">Branch</label>
                            <select class="form-select" t-model="state.branchId">
                                <option value="">All / Company Scope</option>
                                <t t-foreach="state.branches" t-as="branch" t-key="branch.id">
                                    <option t-att-value="branch.id">
                                        <t t-esc="branch.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <button class="btn btn-secondary"
                                t-on-click="applyScope"
                                t-att-disabled="state.loading">
                            Apply Scope
                        </button>

                        <button class="btn btn-primary"
                                t-on-click="refreshDashboard"
                                t-att-disabled="state.loading || !state.canRefresh">
                            <i class="fa fa-refresh me-1"/> Refresh
                        </button>

                        <button class="btn btn-outline-secondary"
                                t-on-click="openSnapshots">
                            <i class="fa fa-history me-1"/> History
                        </button>

                        <button class="btn btn-outline-secondary"
                                t-if="state.canManage"
                                t-on-click="openBoard">
                            <i class="fa fa-cog me-1"/> Configure
                        </button>
                    </div>
                </div>
            </div>

            <div class="container-fluid py-4">
                <div t-if="state.error" class="alert alert-danger">
                    <strong>Dashboard Error:</strong>
                    <t t-esc="state.error"/>
                </div>

                <div t-if="state.loading" class="o_clinic_dashboard_loading">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                    <span class="ms-2">Loading ClinicOne dashboard...</span>
                </div>

                <t t-if="state.payload">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                        <div>
                            <h2 class="mb-1">
                                <t t-esc="state.payload.board.name"/>
                            </h2>
                            <div class="text-muted">
                                <t t-esc="state.payload.scope.company"/>
                                <span class="mx-2">•</span>
                                <t t-esc="state.payload.scope.branch"/>
                                <span class="mx-2">•</span>
                                <t t-esc="state.payload.scope.date_from"/>
                                -
                                <t t-esc="state.payload.scope.date_to"/>
                            </div>
                            <div class="text-muted mt-1">
                                <t t-esc="state.payload.board.description"/>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge text-bg-danger p-2">
                                Critical:
                                <t t-esc="state.payload.snapshot.critical_count"/>
                            </span>
                            <span class="badge text-bg-warning p-2">
                                Warning:
                                <t t-esc="state.payload.snapshot.warning_count"/>
                            </span>
                            <span class="badge text-bg-secondary p-2">
                                Missing:
                                <t t-esc="state.payload.snapshot.no_data_count"/>
                            </span>
                        </div>
                    </div>

                    <div t-if="!state.payload.snapshot.id"
                         class="alert alert-info">
                        No Dashboard Snapshot exists for this exact scope.
                        <t t-if="state.canRefresh">
                            Click <strong>Refresh</strong> to consume existing
                            Clinic Reports and generate missing Report Runs when configured.
                        </t>
                    </div>

                    <div class="row g-3">
                        <t t-foreach="state.payload.cards" t-as="card" t-key="card.id">
                            <div t-att-class="'col-12 col-md-' + card.column_span">
                                <div t-att-class="'o_clinic_dashboard_card card h-100 ' + this.statusClass(card)">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div class="o_clinic_dashboard_card_title">
                                                    <i t-att-class="'fa ' + card.icon + ' me-2'"/>
                                                    <t t-esc="card.name"/>
                                                </div>
                                                <div class="text-muted small mt-1">
                                                    <t t-esc="card.metric_code"/>
                                                </div>
                                            </div>
                                            <span class="badge rounded-pill"
                                                  t-att-class="card.status === 'critical' ? 'text-bg-danger' : card.status === 'warning' ? 'text-bg-warning' : card.status === 'normal' ? 'text-bg-success' : 'text-bg-secondary'">
                                                <t t-esc="card.status_label"/>
                                            </span>
                                        </div>

                                        <div class="o_clinic_dashboard_value mt-3">
                                            <t t-esc="card.display_value"/>
                                        </div>

                                        <div t-if="card.has_trend"
                                             class="mt-2"
                                             t-att-class="this.trendClass(card)">
                                            <i t-if="card.trend_direction === 'up'" class="fa fa-arrow-up me-1"/>
                                            <i t-if="card.trend_direction === 'down'" class="fa fa-arrow-down me-1"/>
                                            <i t-if="card.trend_direction === 'flat'" class="fa fa-minus me-1"/>
                                            <t t-esc="card.trend_display"/>
                                            vs previous comparable period
                                        </div>

                                        <div t-if="card.has_target" class="mt-3">
                                            <div class="d-flex justify-content-between small text-muted">
                                                <span>Target <t t-esc="card.target_value"/></span>
                                                <span><t t-esc="card.target_progress_display"/></span>
                                            </div>
                                            <div class="progress mt-1">
                                                <div class="progress-bar"
                                                     role="progressbar"
                                                     t-att-style="'width:' + card.target_progress_capped + '%'"/>
                                            </div>
                                        </div>

                                        <div t-if="card.note" class="small text-muted mt-3">
                                            <t t-esc="card.note"/>
                                        </div>
                                    </div>

                                    <div class="card-footer bg-transparent d-flex gap-2">
                                        <button t-if="card.report_run_id"
                                                class="btn btn-sm btn-outline-primary"
                                                t-on-click="() => this.openReport(card)">
                                            Open Report
                                        </button>
                                        <button t-if="card.metric_id"
                                                class="btn btn-sm btn-outline-secondary"
                                                t-on-click="() => this.openMetric(card)">
                                            Metric
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <div t-if="state.payload.snapshot.generated_at"
                         class="text-muted small mt-4 text-end">
                        Snapshot generated:
                        <t t-esc="state.payload.snapshot.generated_at"/>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
