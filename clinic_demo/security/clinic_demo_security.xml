<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_clinic_demo" model="ir.module.category">
        <field name="name">ClinicOne Demo Dataset</field>
        <field name="sequence">95</field>
    </record>

    <record id="privilege_clinic_demo" model="res.groups.privilege">
        <field name="name">ClinicOne Demo Dataset</field>
        <field name="category_id" ref="clinic_demo.module_category_clinic_demo"/>
        <field name="sequence">95</field>
    </record>

    <record id="group_demo_viewer" model="res.groups">
        <field name="name">Demo Dataset Viewer</field>
        <field name="privilege_id" ref="clinic_demo.privilege_clinic_demo"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_demo_operator" model="res.groups">
        <field name="name">Demo Dataset Operator</field>
        <field name="privilege_id" ref="clinic_demo.privilege_clinic_demo"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_demo.group_demo_viewer')),
            Command.link(ref('clinic_branch.group_branch_manager'))
        ]"/>
    </record>

    <record id="group_demo_manager" model="res.groups">
        <field name="name">Demo Dataset Manager</field>
        <field name="privilege_id" ref="clinic_demo.privilege_clinic_demo"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_demo.group_demo_operator'))]"/>
    </record>

    <!-- Global company scope protects every persistent Demo Dataset record.
         Group ACLs below control operation rights; UI visibility is never authorization. -->
    <record id="rule_demo_run_company_scope" model="ir.rule">
        <field name="name">Demo Runs: company scope</field>
        <field name="model_id" ref="model_clinic_demo_run"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_demo_reference_company_scope" model="ir.rule">
        <field name="name">Demo References: company scope</field>
        <field name="model_id" ref="model_clinic_demo_reference"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_demo_checkpoint_company_scope" model="ir.rule">
        <field name="name">Demo Checkpoints: company scope</field>
        <field name="model_id" ref="model_clinic_demo_checkpoint"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_demo_log_company_scope" model="ir.rule">
        <field name="name">Demo Logs: company scope</field>
        <field name="model_id" ref="model_clinic_demo_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_demo_validation_company_scope" model="ir.rule">
        <field name="name">Demo Validation Results: company scope</field>
        <field name="model_id" ref="model_clinic_demo_validation_result"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
