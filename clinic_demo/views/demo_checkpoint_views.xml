<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_demo_checkpoint_search" model="ir.ui.view">
        <field name="name">clinic.demo.checkpoint.search</field>
        <field name="model">clinic.demo.checkpoint</field>
        <field name="arch" type="xml">
            <search string="Generation Checkpoints">
                <field name="checkpoint_key"/>
                <field name="run_id"/>
                <field name="phase_key"/>
                <field name="generator_key"/>
                <field name="scenario_key"/>
                <field name="state"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="running" string="Running" domain="[('state','=','running')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <group>
                    <filter name="group_run" string="Demo Run" context="{'group_by':'run_id'}"/>
                    <filter name="group_phase" string="Phase" context="{'group_by':'phase_key'}"/>
                    <filter name="group_generator" string="Generator" context="{'group_by':'generator_key'}"/>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_clinic_demo_checkpoint_list" model="ir.ui.view">
        <field name="name">clinic.demo.checkpoint.list</field>
        <field name="model">clinic.demo.checkpoint</field>
        <field name="arch" type="xml">
            <list string="Generation Checkpoints" create="false" delete="false"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state == 'running'">
                <field name="sequence"/>
                <field name="run_id"/>
                <field name="checkpoint_key"/>
                <field name="phase_key"/>
                <field name="generator_key"/>
                <field name="scenario_key"/>
                <field name="state"/>
                <field name="attempt_count"/>
                <field name="created_count" sum="Created" optional="show"/>
                <field name="reused_count" sum="Reused" optional="show"/>
                <field name="updated_count" sum="Updated" optional="hide"/>
                <field name="skipped_count" sum="Skipped" optional="hide"/>
                <field name="warning_count" sum="Warnings" optional="show"/>
                <field name="error_count" sum="Errors" optional="show"/>
                <field name="started_at" optional="hide"/>
                <field name="completed_at" optional="hide"/>
                <button name="action_open_run" string="Run" type="object" icon="fa-arrow-up"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_demo_checkpoint_form" model="ir.ui.view">
        <field name="name">clinic.demo.checkpoint.form</field>
        <field name="model">clinic.demo.checkpoint</field>
        <field name="arch" type="xml">
            <form string="Generation Checkpoint" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_run" string="Open Demo Run" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,running,done,failed,skipped"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="checkpoint_key"/>
                        <h1><field name="checkpoint_key" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Execution Identity">
                            <field name="run_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="phase_key" readonly="1"/>
                            <field name="generator_key" readonly="1"/>
                            <field name="scenario_key" readonly="1"/>
                            <field name="sequence" readonly="1"/>
                        </group>
                        <group string="Attempt">
                            <field name="attempt_count" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                            <field name="source_fingerprint" readonly="1"/>
                        </group>
                    </group>
                    <group string="Counters" col="6">
                        <field name="created_count" readonly="1"/>
                        <field name="reused_count" readonly="1"/>
                        <field name="updated_count" readonly="1"/>
                        <field name="skipped_count" readonly="1"/>
                        <field name="warning_count" readonly="1"/>
                        <field name="error_count" readonly="1"/>
                    </group>
                    <group string="Failure Detail" invisible="state != 'failed'">
                        <field name="error_summary" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clinic_demo_checkpoint" model="ir.actions.act_window">
        <field name="name">Generation Checkpoints</field>
        <field name="res_model">clinic.demo.checkpoint</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_demo_checkpoint_search"/>
    </record>
</odoo>
























