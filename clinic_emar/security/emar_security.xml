<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_emar_user" model="res.groups">
        <field name="name">eMAR User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_emar_prescriber" model="res.groups">
        <field name="name">eMAR Prescriber</field>
        <field name="implied_ids" eval="[(4, ref('clinic_emar.group_emar_user'))]"/>
    </record>
    <record id="group_emar_nurse" model="res.groups">
        <field name="name">eMAR Medication Administrator</field>
        <field name="implied_ids" eval="[(4, ref('clinic_emar.group_emar_user'))]"/>
    </record>
    <record id="group_emar_manager" model="res.groups">
        <field name="name">eMAR Manager / Pharmacist</field>
        <field name="implied_ids" eval="[(4, ref('clinic_emar.group_emar_prescriber')), (4, ref('clinic_emar.group_emar_nurse'))]"/>
    </record>
</odoo>

