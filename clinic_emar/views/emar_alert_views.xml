<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_emar_alert_search" model="ir.ui.view"><field name="name">clinic.emar.alert.search</field><field name="model">clinic.emar.alert</field><field name="arch" type="xml"><search string="eMAR Alerts"><field name="headline"/><field name="patient_id"/><field name="doctor_id"/><field name="product_id"/><field name="alert_type"/><field name="severity"/>
        <filter name="open" string="Open / Acknowledged" domain="[('state','in',('open','ack'))]"/><filter name="critical" string="Critical" domain="[('severity','=','critical')]"/><filter name="high" string="High+" domain="[('severity','in',('high','critical'))]"/><filter name="snoozed" string="Snoozed" domain="[('snooze_until','!=',False)]"/>
        <separator/><filter name="group_type" string="Type" context="{'group_by':'alert_type'}"/><filter name="group_severity" string="Severity" context="{'group_by':'severity'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
    </search></field></record>
    <record id="view_emar_alert_list" model="ir.ui.view"><field name="name">clinic.emar.alert.list</field><field name="model">clinic.emar.alert</field><field name="arch" type="xml"><list string="eMAR Alerts" create="false" decoration-danger="severity == 'critical'" decoration-warning="severity == 'high'" decoration-muted="state in ('resolved','dismissed')">
        <field name="detected_on"/><field name="headline"/><field name="patient_id"/><field name="product_id"/><field name="alert_type" widget="badge"/><field name="severity" widget="badge"/><field name="occurrence_count"/><field name="assigned_user_id" optional="show"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company" optional="hide"/>
    </list></field></record>
    <record id="view_emar_alert_form" model="ir.ui.view"><field name="name">clinic.emar.alert.form</field><field name="model">clinic.emar.alert</field><field name="arch" type="xml"><form string="Medication Safety Alert" create="false">
        <header><button name="action_acknowledge" type="object" string="Acknowledge" class="btn-primary" invisible="state != 'open'"/><button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state not in ('open','ack')"/><button name="action_dismiss" type="object" string="Dismiss" invisible="state not in ('open','ack')"/><button name="action_reopen" type="object" string="Reopen" invisible="state not in ('resolved','dismissed')"/><button name="action_snooze" type="object" string="Snooze 30m" invisible="state not in ('open','ack')"/><field name="state" widget="statusbar" statusbar_visible="open,ack,resolved,dismissed"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button name="action_open_related" type="object" class="oe_stat_button" icon="fa-external-link"><span class="o_stat_text">Source Record</span></button></div><widget name="web_ribbon" text="CRITICAL" bg_color="text-bg-danger" invisible="severity != 'critical'"/><div class="oe_title"><h1><field name="headline"/></h1></div>
        <group><group string="Classification"><field name="alert_type"/><field name="severity"/><field name="occurrence_count"/><field name="first_seen_on"/><field name="last_seen_on"/><field name="snooze_until"/><field name="is_snoozed"/></group><group string="Clinical Context"><field name="patient_id"/><field name="doctor_id"/><field name="product_id"/><field name="lot_id"/><field name="prescription_id"/><field name="order_id"/><field name="schedule_id"/><field name="administration_id"/><field name="line_id"/></group></group>
        <notebook><page string="Clinical Alert"><field name="description"/><field name="recommendation"/></page><page string="Ownership"><group><field name="responsible_user_id"/><field name="assigned_user_id"/><field name="assigned_team_id"/><field name="acknowledged_on"/><field name="resolved_on"/><field name="dismissed_on"/></group></page><page string="Traceability"><group><field name="source_model"/><field name="source_ref"/><field name="source_key"/><field name="digest" readonly="1"/><field name="company_id" groups="base.group_multi_company"/></group></page></notebook>
        </sheet><chatter/>
    </form></field></record>
    <record id="action_emar_alerts" model="ir.actions.act_window"><field name="name">Medication Safety Alerts</field><field name="res_model">clinic.emar.alert</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_emar_alert_search"/><field name="context">{'create': False}</field></record>
</odoo>

