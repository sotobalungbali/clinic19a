<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_emar_medication_line_search" model="ir.ui.view">
        <field name="name">clinic.emar.medication.line.search</field><field name="model">clinic.emar.medication.line</field>
        <field name="arch" type="xml"><search string="Medication Lines"><field name="product_id"/><field name="patient_id"/><field name="doctor_id"/><field name="order_id"/><field name="prescription_id"/><field name="profile_id"/>
            <filter name="prn" string="PRN" domain="[('is_prn','=',True)]"/><filter name="billable" string="Billable" domain="[('is_billable','=',True)]"/><filter name="active" string="Active" domain="[('active','=',True)]"/>
            <separator/><filter name="group_product" string="Medication" context="{'group_by':'product_id'}"/><filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/><filter name="group_doctor" string="Doctor" context="{'group_by':'doctor_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
        </search></field>
    </record>
    <record id="view_emar_medication_line_list" model="ir.ui.view"><field name="name">clinic.emar.medication.line.list</field><field name="model">clinic.emar.medication.line</field><field name="arch" type="xml"><list string="Medication Lines">
        <field name="product_id"/><field name="patient_id"/><field name="doctor_id"/><field name="order_id" optional="show"/><field name="prescription_id" optional="show"/><field name="dose"/><field name="dose_uom_id"/><field name="route"/><field name="frequency"/><field name="quantity"/><field name="product_uom_id"/><field name="price_subtotal" optional="hide"/><field name="active" optional="hide"/><button name="action_open_medication_profile" type="object" icon="fa-external-link" title="Medication Profile"/>
    </list></field></record>
    <record id="view_emar_medication_line_form" model="ir.ui.view"><field name="name">clinic.emar.medication.line.form</field><field name="model">clinic.emar.medication.line</field><field name="arch" type="xml"><form string="Medication Line"><header><button name="action_open_medication_profile" type="object" string="Medication Profile" class="btn-secondary"/></header><sheet>
        <div class="oe_title"><h1><field name="product_id"/></h1></div><group><group string="Clinical Context"><field name="order_id"/><field name="prescription_id"/><field name="patient_id"/><field name="doctor_id"/><field name="profile_id"/></group><group string="Dose / SIG"><field name="dosage"/><field name="dose"/><field name="dose_uom_id"/><field name="route"/><field name="frequency"/><field name="duration_count"/><field name="duration_unit"/><field name="is_prn"/><field name="instructions"/></group></group>
        <notebook><page string="Inventory"><group><field name="quantity"/><field name="product_uom_id"/><field name="requested_lot_ids" widget="many2many_tags"/><field name="is_substitutable"/></group></page><page string="Billing"><group><field name="is_billable"/><field name="price_unit"/><field name="discount_percent"/><field name="price_subtotal" readonly="1"/><field name="currency_id" invisible="1"/></group></page><page string="Notes"><field name="notes"/></page><page string="Company"><field name="company_id" groups="base.group_multi_company"/></page></notebook>
    </sheet><chatter/></form></field></record>
    <record id="action_emar_medication_lines" model="ir.actions.act_window"><field name="name">Medication Lines</field><field name="res_model">clinic.emar.medication.line</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_emar_medication_line_search"/><field name="context">{'create': False}</field></record>
</odoo>

