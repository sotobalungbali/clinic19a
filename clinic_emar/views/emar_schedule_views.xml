<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_emar_schedule_search" model="ir.ui.view">
        <field name="name">clinic.emar.schedule.search</field><field name="model">clinic.emar.schedule</field>
        <field name="arch" type="xml"><search string="Medication Schedules"><field name="name"/><field name="patient_id"/><field name="doctor_id"/><field name="product_id"/><field name="order_id"/><field name="planned_datetime"/>
            <filter name="due" string="Due" domain="[('state','=','due')]"/><filter name="missed" string="Missed" domain="[('state','=','missed')]"/><filter name="open" string="Open" domain="[('state','in',('draft','scheduled','due'))]"/>
            <separator/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_product" string="Medication" context="{'group_by':'product_id'}"/><filter name="group_day" string="Planned Day" context="{'group_by':'planned_datetime:day'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
        </search></field>
    </record>
    <record id="view_emar_schedule_list" model="ir.ui.view"><field name="name">clinic.emar.schedule.list</field><field name="model">clinic.emar.schedule</field><field name="arch" type="xml"><list string="Medication Schedules" decoration-danger="state == 'missed' or is_overdue" decoration-warning="state == 'due'" decoration-success="state == 'administered'">
        <field name="planned_datetime"/><field name="patient_id"/><field name="product_id"/><field name="dose_qty"/><field name="route"/><field name="assigned_employee_id" optional="show"/><field name="window_start" optional="hide"/><field name="window_end" optional="hide"/><field name="is_overdue" optional="show"/><field name="state" widget="badge"/><button name="action_administer" type="object" string="Administer" icon="fa-medkit" invisible="state not in ('draft','scheduled','due')"/><button name="action_open_reschedule_wizard" type="object" icon="fa-calendar" title="Reschedule" invisible="state not in ('draft','scheduled','due')"/>
    </list></field></record>
    <record id="view_emar_schedule_form" model="ir.ui.view"><field name="name">clinic.emar.schedule.form</field><field name="model">clinic.emar.schedule</field><field name="arch" type="xml"><form string="Medication Schedule"><header>
        <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state not in ('draft','missed')"/><button name="action_mark_due" type="object" string="Mark Due" class="btn-secondary" invisible="state != 'scheduled'"/><button name="action_administer" type="object" string="Create Administration" class="btn-primary" invisible="state not in ('draft','scheduled','due')" groups="clinic_emar.group_emar_nurse"/><button name="action_open_reschedule_wizard" type="object" string="Reschedule" invisible="state not in ('draft','scheduled','due')" groups="clinic_emar.group_emar_nurse"/><button name="action_mark_missed" type="object" string="Mark Missed" invisible="state not in ('scheduled','due')" groups="clinic_emar.group_emar_nurse"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('administered','cancelled')" groups="clinic_emar.group_emar_nurse"/><field name="state" widget="statusbar" statusbar_visible="draft,scheduled,due,administered,missed,cancelled"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button name="action_view_administrations" type="object" class="oe_stat_button" icon="fa-medkit"><field name="administration_count" widget="statinfo" string="Administrations"/></button></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
        <group><group string="Clinical Context"><field name="order_id"/><field name="prescription_id" readonly="1"/><field name="line_id"/><field name="patient_id" readonly="1"/><field name="doctor_id" readonly="1"/><field name="product_id"/></group><group string="Timing"><field name="planned_datetime"/><field name="window_before_min"/><field name="window_after_min"/><field name="window_start" readonly="1"/><field name="window_end" readonly="1"/><field name="is_due"/><field name="is_overdue"/></group></group>
        <notebook><page string="Dose"><group><field name="dose_qty"/><field name="dose_uom_id"/><field name="dosage"/><field name="route"/><field name="notes"/></group></page><page string="Assignment"><group><field name="assigned_user_id"/><field name="assigned_employee_id"/><field name="assigned_role"/><field name="room_session_id"/><field name="location_note"/></group></page><page string="Reschedule History"><group><field name="reschedule_origin_id"/><field name="reschedule_reason"/><field name="cancel_reason"/></group></page><page string="Company"><field name="company_id" groups="base.group_multi_company"/></page></notebook></sheet><chatter/>
    </form></field></record>
    <record id="view_emar_schedule_calendar" model="ir.ui.view"><field name="name">clinic.emar.schedule.calendar</field><field name="model">clinic.emar.schedule</field><field name="arch" type="xml"><calendar string="eMAR Schedule" date_start="planned_datetime" color="patient_id" mode="week"><field name="product_id"/><field name="patient_id"/><field name="state"/></calendar></field></record>
    <record id="action_emar_schedules" model="ir.actions.act_window"><field name="name">Administration Schedule</field><field name="res_model">clinic.emar.schedule</field><field name="view_mode">list,calendar,form</field><field name="search_view_id" ref="view_emar_schedule_search"/></record>
</odoo>
