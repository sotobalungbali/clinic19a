<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_feedback_request" model="ir.sequence">
        <field name="name">Clinic Feedback Request</field>
        <field name="code">clinic.feedback.request</field>
        <field name="prefix">FBR/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_feedback_response" model="ir.sequence">
        <field name="name">Clinic Patient Feedback</field>
        <field name="code">clinic.feedback</field>
        <field name="prefix">FB/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_feedback_escalation" model="ir.sequence">
        <field name="name">Clinic Feedback Escalation</field>
        <field name="code">clinic.feedback.escalation</field>
        <field name="prefix">FBE/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
