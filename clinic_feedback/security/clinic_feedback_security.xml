<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_feedback" model="ir.module.category">
        <field name="name">ClinicOne Feedback</field>
        <field name="sequence">65</field>
    </record>

    <record id="privilege_feedback" model="res.groups.privilege">
        <field name="name">ClinicOne Feedback</field>
        <field name="category_id" ref="clinic_feedback.module_category_feedback"/>
        <field name="sequence">65</field>
    </record>

    <record id="group_feedback_user" model="res.groups">
        <field name="name">Feedback User</field>
        <field name="privilege_id" ref="clinic_feedback.privilege_feedback"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_feedback_coordinator" model="res.groups">
        <field name="name">Feedback Coordinator</field>
        <field name="privilege_id" ref="clinic_feedback.privilege_feedback"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_feedback.group_feedback_user'))]"/>
    </record>

    <record id="group_feedback_reviewer" model="res.groups">
        <field name="name">Feedback Reviewer</field>
        <field name="privilege_id" ref="clinic_feedback.privilege_feedback"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_feedback.group_feedback_coordinator'))]"/>
    </record>

    <record id="group_feedback_manager" model="res.groups">
        <field name="name">Feedback Manager</field>
        <field name="privilege_id" ref="clinic_feedback.privilege_feedback"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_feedback.group_feedback_reviewer'))]"/>
    </record>

    <record id="rule_feedback_survey_company" model="ir.rule">
        <field name="name">Feedback Survey: allowed companies</field>
        <field name="model_id" ref="model_clinic_feedback_survey"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_feedback.group_feedback_user'))]"/>
    </record>

    <record id="rule_feedback_question_company" model="ir.rule">
        <field name="name">Feedback Question: allowed companies</field>
        <field name="model_id" ref="model_clinic_feedback_question"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_feedback.group_feedback_user'))]"/>
    </record>

    <record id="rule_feedback_request_company" model="ir.rule">
        <field name="name">Feedback Request: allowed companies</field>
        <field name="model_id" ref="model_clinic_feedback_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_feedback.group_feedback_user'))]"/>
    </record>

    <record id="rule_feedback_response_company" model="ir.rule">
        <field name="name">Feedback Response: allowed companies</field>
        <field name="model_id" ref="model_clinic_feedback"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_feedback.group_feedback_user'))]"/>
    </record>

    <record id="rule_feedback_answer_company" model="ir.rule">
        <field name="name">Feedback Answer: allowed companies</field>
        <field name="model_id" ref="model_clinic_feedback_answer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_feedback.group_feedback_user'))]"/>
    </record>

    <record id="rule_feedback_escalation_company" model="ir.rule">
        <field name="name">Feedback Escalation: allowed companies</field>
        <field name="model_id" ref="model_clinic_feedback_escalation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_feedback.group_feedback_user'))]"/>
    </record>
</odoo>
