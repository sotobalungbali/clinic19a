<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_clinic_finance" model="ir.module.category">
        <field name="name">ClinicOne Finance</field>
        <field name="sequence">60</field>
    </record>
    <record id="privilege_clinic_finance" model="res.groups.privilege">
        <field name="name">ClinicOne Finance</field>
        <field name="category_id" ref="clinic_finance.module_category_clinic_finance"/>
        <field name="sequence">60</field>
    </record>

    <record id="group_clinic_finance_user" model="res.groups">
        <field name="name">Finance User</field>
        <field name="privilege_id" ref="clinic_finance.privilege_clinic_finance"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_clinic_finance_cashier" model="res.groups">
        <field name="name">Finance Cashier</field>
        <field name="privilege_id" ref="clinic_finance.privilege_clinic_finance"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_finance.group_clinic_finance_user')),
            Command.link(ref('account.group_account_user'))
        ]"/>
    </record>
    <record id="group_clinic_finance_approver" model="res.groups">
        <field name="name">Finance Approver</field>
        <field name="privilege_id" ref="clinic_finance.privilege_clinic_finance"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_finance.group_clinic_finance_cashier'))]"/>
    </record>
    <record id="group_clinic_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="privilege_id" ref="clinic_finance.privilege_clinic_finance"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_finance.group_clinic_finance_approver'))]"/>
    </record>

    <record id="rule_finance_category_company" model="ir.rule">
        <field name="name">Finance Category: allowed companies</field>
        <field name="model_id" ref="model_clinic_finance_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_user'))]"/>
    </record>
    <record id="rule_finance_account_company" model="ir.rule">
        <field name="name">Finance Account: allowed companies</field>
        <field name="model_id" ref="model_clinic_finance_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_user'))]"/>
    </record>
    <record id="rule_finance_transaction_company" model="ir.rule">
        <field name="name">Finance Transaction: allowed companies</field>
        <field name="model_id" ref="model_clinic_finance_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_user'))]"/>
    </record>
    <record id="rule_finance_transfer_company" model="ir.rule">
        <field name="name">Finance Transfer: allowed companies</field>
        <field name="model_id" ref="model_clinic_finance_transfer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_user'))]"/>
    </record>
    <record id="rule_finance_request_own" model="ir.rule">
        <field name="name">Fund Request: own requests</field>
        <field name="model_id" ref="model_clinic_finance_fund_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('requested_by_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_user'))]"/>
    </record>
    <record id="rule_finance_request_cashier_company" model="ir.rule">
        <field name="name">Fund Request: cashier company scope</field>
        <field name="model_id" ref="model_clinic_finance_fund_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_cashier'))]"/>
    </record>
    <record id="rule_finance_session_company" model="ir.rule">
        <field name="name">Cash Session: allowed companies</field>
        <field name="model_id" ref="model_clinic_finance_cash_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_user'))]"/>
    </record>
    <record id="rule_finance_count_company" model="ir.rule">
        <field name="name">Cash Count: allowed companies</field>
        <field name="model_id" ref="model_clinic_finance_cash_count_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_user'))]"/>
    </record>
    <record id="rule_finance_position_company" model="ir.rule">
        <field name="name">Treasury Position: allowed companies</field>
        <field name="model_id" ref="model_clinic_finance_position"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_user'))]"/>
    </record>
    <record id="rule_finance_position_line_company" model="ir.rule">
        <field name="name">Treasury Position Line: allowed companies</field>
        <field name="model_id" ref="model_clinic_finance_position_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_finance.group_clinic_finance_user'))]"/>
    </record>
</odoo>
