<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_finance_account_search" model="ir.ui.view">
    <field name="name">clinic.finance.account.search</field><field name="model">clinic.finance.account</field>
    <field name="arch" type="xml"><search>
      <field name="name"/><field name="code"/><field name="journal_id"/><field name="custodian_user_id"/><field name="branch_id"/>
      <filter name="active_state" string="Active" domain="[('state','=','active')]"/>
      <filter name="cash" string="Cash" domain="[('journal_type','=','cash')]"/>
      <filter name="bank" string="Bank" domain="[('journal_type','=','bank')]"/>
      <filter name="low_balance" string="Low Balance" domain="[('low_balance','=',True)]"/>
      <group>
        <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
        <filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/>
        <filter name="group_type" string="Journal Type" context="{'group_by':'journal_type'}"/>
        <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
      </group>
    </search></field>
  </record>
  <record id="view_finance_account_list" model="ir.ui.view">
    <field name="name">clinic.finance.account.list</field><field name="model">clinic.finance.account</field>
    <field name="arch" type="xml"><list decoration-danger="low_balance" decoration-warning="cash_ceiling_exceeded" decoration-muted="state == 'closed'">
      <field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="journal_id"/>
      <field name="journal_type"/><field name="branch_id"/><field name="custodian_user_id"/>
      <field name="book_balance" sum="Book Balance"/><field name="minimum_balance"/><field name="state" widget="badge"/>
      <field name="company_id" groups="base.group_multi_company"/>
    </list></field>
  </record>
  <record id="view_finance_account_form" model="ir.ui.view">
    <field name="name">clinic.finance.account.form</field><field name="model">clinic.finance.account</field>
    <field name="arch" type="xml"><form>
      <header>
        <button name="action_activate" type="object" string="Activate" class="btn-primary" groups="clinic_finance.group_clinic_finance_manager" invisible="state == 'active'"/>
        <button name="action_suspend" type="object" string="Suspend" groups="clinic_finance.group_clinic_finance_manager" invisible="state != 'active'"/>
        <button name="action_close" type="object" string="Close" groups="clinic_finance.group_clinic_finance_manager" invisible="state == 'closed'"/>
        <field name="state" widget="statusbar" statusbar_visible="active,suspended,closed"/>
      </header>
      <sheet>
        <div class="oe_button_box" name="button_box">
          <button name="action_view_transactions" type="object" class="oe_stat_button" icon="fa-exchange"><field name="transaction_count" widget="statinfo" string="Transactions"/></button>
          <button name="action_view_sessions" type="object" class="oe_stat_button" icon="fa-money" invisible="journal_type != 'cash'"><field name="open_session_count" widget="statinfo" string="Open Sessions"/></button>
          <button name="action_open_journal" type="object" class="oe_stat_button" icon="fa-book"><div class="o_stat_info"><span class="o_stat_text">Journal</span></div></button>
        </div>
        <div class="oe_title"><label for="name"/><h1><field name="name"/></h1><div><field name="code" class="oe_inline"/></div></div>
        <div class="alert alert-warning" role="alert" invisible="not low_balance">Book balance is below the configured minimum balance.</div>
        <div class="alert alert-warning" role="alert" invisible="not cash_ceiling_exceeded">Cash balance exceeds the configured operational cash ceiling.</div>
        <group>
          <group string="Operating Account">
            <field name="journal_id" options="{'no_create_edit':True}"/><field name="journal_type" readonly="1"/>
            <field name="liquidity_account_id" readonly="1"/><field name="custodian_user_id"/><field name="active" invisible="1"/>
          </group>
          <group string="Scope &amp; Balance">
            <field name="company_id" groups="base.group_multi_company"/><field name="branch_id"/>
            <field name="currency_id" invisible="1"/><field name="book_balance" readonly="1"/>
            <field name="minimum_balance"/><field name="maximum_cash_balance" invisible="journal_type != 'cash'"/>
          </group>
        </group>
        <div class="d-flex gap-2 my-3">
          <button name="action_new_receipt" type="object" string="New Receipt" class="btn btn-primary" groups="clinic_finance.group_clinic_finance_cashier" invisible="state != 'active'"/>
          <button name="action_new_disbursement" type="object" string="New Disbursement" class="btn btn-secondary" groups="clinic_finance.group_clinic_finance_cashier" invisible="state != 'active'"/>
          <button name="action_view_journal_entries" type="object" string="View Journal Entries" class="btn btn-secondary"/>
        </div>
        <notebook><page string="Notes"><field name="notes"/></page></notebook>
      </sheet><chatter/>
    </form></field>
  </record>
  <record id="action_finance_account" model="ir.actions.act_window">
    <field name="name">Finance Accounts</field><field name="res_model">clinic.finance.account</field>
    <field name="view_mode">list,form</field><field name="search_view_id" ref="view_finance_account_search"/>
  </record>
</odoo>
