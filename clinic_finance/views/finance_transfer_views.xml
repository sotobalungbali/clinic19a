<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_finance_transfer_search" model="ir.ui.view">
    <field name="name">clinic.finance.transfer.search</field><field name="model">clinic.finance.transfer</field>
    <field name="arch" type="xml"><search>
      <field name="name"/><field name="source_account_id"/><field name="destination_account_id"/><field name="reference"/>
      <filter name="to_approve" string="To Approve" domain="[('state','=','submitted')]"/><filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
      <group><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_month" string="Month" context="{'group_by':'transfer_date:month'}"/></group>
    </search></field>
  </record>
  <record id="view_finance_transfer_list" model="ir.ui.view">
    <field name="name">clinic.finance.transfer.list</field><field name="model">clinic.finance.transfer</field>
    <field name="arch" type="xml"><list decoration-info="state == 'submitted'" decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'">
      <field name="name"/><field name="transfer_date"/><field name="source_account_id"/><field name="destination_account_id"/><field name="amount" sum="Total"/><field name="general_journal_id" optional="show"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/>
    </list></field>
  </record>
  <record id="view_finance_transfer_form" model="ir.ui.view">
    <field name="name">clinic.finance.transfer.form</field><field name="model">clinic.finance.transfer</field>
    <field name="arch" type="xml"><form>
      <header>
        <button name="action_submit" type="object" string="Submit" class="btn-primary" groups="clinic_finance.group_clinic_finance_cashier" invisible="state != 'draft'"/>
        <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="clinic_finance.group_clinic_finance_approver" invisible="state != 'submitted'"/>
        <button name="action_post" type="object" string="Post Transfer" class="btn-primary" groups="clinic_finance.group_clinic_finance_cashier" invisible="state != 'approved'"/>
        <button name="action_cancel" type="object" string="Cancel" groups="clinic_finance.group_clinic_finance_manager" invisible="state in ('posted','cancelled')"/>
        <button name="action_reset_to_draft" type="object" string="Reset to Draft" groups="clinic_finance.group_clinic_finance_manager" invisible="state not in ('submitted','approved','cancelled')"/>
        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,posted,cancelled"/>
      </header><sheet>
        <div class="oe_button_box" name="button_box">
          <button name="action_open_move" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_id"><div class="o_stat_info"><span class="o_stat_text">Journal Entry</span></div></button>
          <button name="action_open_source_account" type="object" class="oe_stat_button" icon="fa-arrow-circle-left"><div class="o_stat_info"><span class="o_stat_text">Source</span></div></button>
          <button name="action_open_destination_account" type="object" class="oe_stat_button" icon="fa-arrow-circle-right"><div class="o_stat_info"><span class="o_stat_text">Destination</span></div></button>
        </div>
        <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
        <group>
          <group string="Transfer"><field name="transfer_date" readonly="state != 'draft'"/><field name="source_account_id" readonly="state != 'draft'"/><field name="source_branch_id" readonly="1"/><field name="destination_account_id" readonly="state != 'draft'"/><field name="destination_branch_id" readonly="1"/><field name="amount" readonly="state != 'draft'"/></group>
          <group string="Accounting"><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="general_journal_id" readonly="state != 'draft'"/><field name="approval_required" readonly="1"/><field name="move_id" readonly="1"/><field name="reference"/></group>
        </group>
        <notebook><page string="Approval"><group><field name="submitted_by_id" readonly="1"/><field name="approved_by_id" readonly="1"/><field name="posted_by_id" readonly="1"/></group></page><page string="Notes"><field name="note"/></page></notebook>
      </sheet><chatter/>
    </form></field>
  </record>
  <record id="action_finance_transfer" model="ir.actions.act_window">
    <field name="name">Internal Transfers</field><field name="res_model">clinic.finance.transfer</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_finance_transfer_search"/>
  </record>
</odoo>
