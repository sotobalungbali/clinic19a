<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Integration is model/API-based; no fragile inherited custom ClinicOne view anchor. -->
  <record id="action_finance_odoo_journals" model="ir.actions.act_window">
    <field name="name">Odoo Cash &amp; Bank Journals</field>
    <field name="res_model">account.journal</field><field name="view_mode">list,form</field>
    <field name="domain">[('type','in',('cash','bank','credit'))]</field>
  </record>
  <record id="action_finance_account_moves" model="ir.actions.act_window">
    <field name="name">Finance Journal Entries</field>
    <field name="res_model">account.move</field><field name="view_mode">list,form</field>
    <field name="domain">['|',('clinic_finance_transaction_id','!=',False),('clinic_finance_transfer_id','!=',False)]</field>
  </record>
</odoo>
