        <field name="name">Clinical Imaging Series</field><field name="code">clinical.imaging.series</field><field name="prefix">SER/%(year)s/</field><field name="padding">5</field>
    </record>
    <record id="seq_clinical_imaging_image" model="ir.sequence">
