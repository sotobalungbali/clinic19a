<odoo noupdate="1">
    <record id="seq_clinical_imaging" model="ir.sequence">
        <field name="name">Clinical Imaging</field><field name="code">clinical.imaging</field><field name="prefix">IMG/%(year)s/</field><field name="padding">5</field>
    </record>
    <record id="seq_clinical_imaging_request" model="ir.sequence">
        <field name="name">Clinical Imaging Request</field><field name="code">clinical.imaging.request</field><field name="prefix">IMR/%(year)s/</field><field name="padding">5</field>
    </record>
    <record id="seq_clinical_imaging_study" model="ir.sequence">
        <field name="name">Clinical Imaging Study</field><field name="code">clinical.imaging.study</field><field name="prefix">STD/%(year)s/</field><field name="padding">5</field>
