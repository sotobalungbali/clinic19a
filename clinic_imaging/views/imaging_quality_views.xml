                <field name="active"/>
                <field name="appointment_id"/>
            </list>
        </field>
    </record>

    <record id="view_clinical_imaging_encounter_screening_form" model="ir.ui.view">
        <field name="name">clinical.imaging.encounter.screening.form</field>
        <field name="model">clinical.imaging.encounter.screening</field>
        <field name="arch" type="xml">
        <form string="Encounter Imaging Screening">
            <header>
                <button name="action_verify" type="object" string="Verify" class="oe_highlight"/>
                <button name="action_cancel" type="object" string="Cancel"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_attachments" type="object" class="oe_stat_button" icon="fa-external-link">
                        <div class="o_stat_info"><span class="o_stat_text">Attachments</span></div>
                    </button>
                </div>
                <group>
                    <group string="Identity">
                            <field name="name"/>
                    </group>
                    <group string="Context &amp; Governance">
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="encounter_id"/>
                            <field name="patient_id"/>
                            <field name="appointment_id"/>
                            <field name="treatment_id"/>
                            <field name="consent_id"/>
                            <field name="performed_by_id"/>
                            <field name="verified_by_id"/>
                    </group>
                </group>
                <notebook>
                    <page string="Operational Details">
                        <group>
                            <group>
                                <field name="height_cm"/>
                                <field name="weight_kg"/>
                                <field name="bmi"/>
                                <field name="systolic_bp"/>
                                <field name="diastolic_bp"/>
                                <field name="heart_rate_bpm"/>
                                <field name="temperature_c"/>
                                <field name="spo2_percent"/>
                                <field name="pregnancy_status"/>
                                <field name="lmp_date"/>
                                <field name="pregnancy_test_done"/>
                                <field name="pregnancy_test_result"/>
                                <field name="contrast_allergy"/>
                                <field name="premed_required"/>
                                <field name="premed_given"/>
                            </group>
                            <group>
                                <field name="egfr_value"/>
                                <field name="egfr_date"/>
                                <field name="egfr_method"/>
                                <field name="renal_risk"/>
                                <field name="has_metal_implants"/>
                                <field name="has_pacemaker"/>
                                <field name="has_cochlear_implant"/>
                                <field name="implant_description"/>
                                <field name="iv_access"/>
                                <field name="fasting_hours"/>
                                <field name="sedation_plan"/>
                                <field name="attachment_count"/>
                                <field name="performed_datetime"/>
                                <field name="verified_datetime"/>
                            </group>
                        </group>
                    </page>
                    <page string="Clinical Content &amp; Evidence">
                        <group>
                            <field name="premed_protocol"/>
                            <field name="sedation_notes"/>
                            <field name="notes"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
        </field>
    </record>

