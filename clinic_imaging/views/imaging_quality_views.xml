<odoo>
    <record id="view_clinical_imaging_kpi_snapshot_search" model="ir.ui.view">
        <field name="name">clinical.imaging.kpi.snapshot.search</field>
        <field name="model">clinical.imaging.kpi.snapshot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active"/>
                <field name="period"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="currency_id"/>
                <group>
                    <filter name="group_company_id" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_clinical_imaging_kpi_snapshot_list" model="ir.ui.view">
        <field name="name">clinical.imaging.kpi.snapshot.list</field>
        <field name="model">clinical.imaging.kpi.snapshot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="active"/>
                <field name="period"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="currency_id"/>
            </list>
        </field>
    </record>

    <record id="view_clinical_imaging_kpi_snapshot_form" model="ir.ui.view">
        <field name="name">clinical.imaging.kpi.snapshot.form</field>
        <field name="model">clinical.imaging.kpi.snapshot</field>
        <field name="arch" type="xml">
        <form string="Clinical Imaging KPI Snapshot">
            <header>
                <button name="action_recompute" type="object" string="Recompute" class="oe_highlight"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_results_finalized" type="object" class="oe_stat_button" icon="fa-external-link">
                        <div class="o_stat_info"><span class="o_stat_text">Finalized Results</span></div>
                    </button>
                    <button name="action_open_studies" type="object" class="oe_stat_button" icon="fa-external-link">
                        <div class="o_stat_info"><span class="o_stat_text">Studies</span></div>
                    </button>
                    <button name="action_open_series" type="object" class="oe_stat_button" icon="fa-external-link">
                        <div class="o_stat_info"><span class="o_stat_text">Series</span></div>
                    </button>
                    <button name="action_open_device_downtime" type="object" class="oe_stat_button" icon="fa-external-link">
                        <div class="o_stat_info"><span class="o_stat_text">Device Downtime</span></div>
                    </button>
                </div>
                <group>
                    <group string="Identity">
                            <field name="name"/>
                    </group>
                    <group string="Context &amp; Governance">
                            <field name="active"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                    </group>
                </group>
                <notebook>
                    <page string="Operational Details">
                        <group>
                            <group>
                                <field name="period"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="request_count"/>
                                <field name="request_cancelled"/>
                                <field name="imaging_count"/>
                                <field name="study_count"/>
                                <field name="series_count"/>
                                <field name="image_count"/>
                                <field name="result_created"/>
                                <field name="result_final"/>
                                <field name="backlog_open_requests"/>
                                <field name="backlog_pending_reports"/>
                                <field name="tat_order_to_acq_avg_h"/>
                            </group>
                            <group>
                                <field name="tat_acq_to_sign_avg_h"/>
                                <field name="tat_total_order_to_sign_avg_h"/>
                                <field name="device_count"/>
                                <field name="device_downtime_h"/>
                                <field name="device_uptime_ratio"/>
                                <field name="device_qc_due"/>
                                <field name="device_qc_overdue"/>
                                <field name="avg_ctdi_vol_mgy"/>
                                <field name="avg_dlp_mgy_cm"/>
                                <field name="total_dap_gy_cm2"/>
                                <field name="total_fluoro_time_min"/>
                                <field name="invoice_count"/>
                                <field name="invoice_amount_total"/>
                                <field name="avg_days_to_invoice"/>
                            </group>
                        </group>
                    </page>
                    <page string="Related Records">
                        <group>
                            <field name="modality_line_ids"/>
                            <field name="device_line_ids"/>
                            <field name="radiologist_line_ids"/>
                        </group>
                    </page>
                    <page string="Clinical Content &amp; Evidence">
                        <group>
                            <field name="notes"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
            <chatter/>
        </form>
        </field>
    </record>

