    <record id="incident_category_clinical_adverse" model="clinic.incident.category">
        <field name="name">Clinical Adverse Event</field>
        <field name="code">CLINICAL-AE</field>
        <field name="incident_type">clinical_adverse</field>
        <field name="default_severity">high</field>
        <field name="requires_investigation" eval="True"/>
        <field name="requires_capa" eval="True"/>
        <field name="requires_regulatory_review" eval="True"/>
        <field name="triage_target_hours">4</field>
        <field name="investigation_target_hours">72</field>
        <field name="action_plan_target_hours">120</field>
    </record>

