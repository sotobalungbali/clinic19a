<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_incident" model="ir.sequence">
        <field name="name">Clinic Incident</field>
        <field name="code">clinic.incident</field>
        <field name="prefix">INC/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_incident_investigation" model="ir.sequence">
        <field name="name">Clinic Incident Investigation</field>
        <field name="code">clinic.incident.investigation</field>
        <field name="prefix">INVEST/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
