<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incident_category_search" model="ir.ui.view">
        <field name="name">clinic.incident.category.search</field>
        <field name="model">clinic.incident.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="incident_type"/>
                <field name="default_severity"/>
                <field name="company_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="requires_investigation" string="Requires Investigation"
                        domain="[('requires_investigation','=',True)]"/>
                <filter name="requires_capa" string="Requires CAPA"
                        domain="[('requires_capa','=',True)]"/>
                <filter name="regulatory" string="Regulatory Review"
                        domain="[('requires_regulatory_review','=',True)]"/>
                <group>
                    <filter name="group_type" string="Incident Type" context="{'group_by':'incident_type'}"/>
                    <filter name="group_severity" string="Default Severity" context="{'group_by':'default_severity'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_incident_category_list" model="ir.ui.view">
        <field name="name">clinic.incident.category.list</field>
        <field name="model">clinic.incident.category</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="incident_type" widget="badge"/>
                <field name="default_severity" widget="badge"/>
                <field name="requires_investigation"/>
                <field name="requires_capa"/>
                <field name="requires_regulatory_review"/>
                <field name="triage_target_hours"/>
                <field name="investigation_target_hours"/>
                <field name="action_plan_target_hours"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_incident_category_form" model="ir.ui.view">
        <field name="name">clinic.incident.category.form</field>
        <field name="model">clinic.incident.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <div class="text-muted"><field name="code"/></div>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="incident_type"/>
                            <field name="default_severity"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Compliance Requirements">
                            <field name="requires_investigation"/>
                            <field name="requires_capa"/>
                            <field name="requires_regulatory_review"/>
                        </group>
                    </group>

                    <group string="Default Response Targets">
                        <group>
                            <field name="triage_target_hours"/>
                            <field name="investigation_target_hours"/>
                            <field name="action_plan_target_hours"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Response Guidance">
                            <field name="response_guidance"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_incident_category" model="ir.actions.act_window">
        <field name="name">Incident Categories</field>
        <field name="res_model">clinic.incident.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_incident_category_search"/>
    </record>
</odoo>
