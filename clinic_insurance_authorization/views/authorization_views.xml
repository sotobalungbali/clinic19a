<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_authorization_search" model="ir.ui.view">
        <field name="name">clinic.insurance.authorization.search</field>
        <field name="model">clinic.insurance.authorization</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="authorization_code"/>
                <field name="external_reference"/>
                <field name="patient_id"/>
                <field name="policy_id"/>
                <field name="insurer_partner_id"/>
                <field name="plan_id"/>
                <field name="company_id"/>
                <filter name="needs_submission" string="Draft / Prepared" domain="[('state','in',('draft','prepared'))]"/>
                <filter name="payer_pending" string="Payer Pending" domain="[('state','in',('submitted','pending'))]"/>
                <filter name="approved" string="Approved" domain="[('state','in',('approved','partial'))]"/>
                <filter name="currently_valid" string="Currently Valid" domain="[('currently_valid','=',True)]"/>
                <filter name="eligibility_attention" string="Eligibility Attention" domain="[('eligibility_ok','=',False),('state','in',('draft','prepared','submitted','pending'))]"/>
                <filter name="authorization_required" string="Authorization Required" domain="[('authorization_required','=',True)]"/>
                <group>
                    <filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/>
                    <filter name="group_insurer" string="Insurer" context="{'group_by':'insurer_partner_id'}"/>
                    <filter name="group_policy" string="Policy" context="{'group_by':'policy_id'}"/>
                    <filter name="group_source" string="Source" context="{'group_by':'source_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_month" string="Service Month" context="{'group_by':'service_date:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_insurance_authorization_list" model="ir.ui.view">
        <field name="name">clinic.insurance.authorization.list</field>
        <field name="model">clinic.insurance.authorization</field>
        <field name="arch" type="xml">
            <list decoration-info="state in ('submitted','pending')" decoration-success="state in ('approved','partial')" decoration-danger="state == 'rejected'" decoration-muted="state in ('expired','cancelled')">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="insurer_partner_id"/>
                <field name="policy_id"/>
                <field name="source_type" widget="badge"/>
                <field name="service_date"/>
                <field name="requested_amount" sum="Requested"/>
                <field name="approved_amount" sum="Approved"/>
                <field name="insurer_payable_amount" sum="Payer"/>
                <field name="authorization_code"/>
                <field name="valid_to"/>
                <field name="claim_count"/>
                <field name="eligibility_ok"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currently_valid" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_authorization_form" model="ir.ui.view">
        <field name="name">clinic.insurance.authorization.form</field>
        <field name="model">clinic.insurance.authorization</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prepare" type="object" string="Prepare" class="btn-primary"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state not in ('draft','prepared')"/>
                    <button name="action_submit" type="object" string="Submit to Payer" class="btn-primary"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state != 'prepared'"/>
                    <button name="action_mark_pending" type="object" string="Mark Payer Pending"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state != 'submitted'"/>
                    <button name="action_approve" type="object" string="Approve / Partially Approve" class="btn-primary"
                            groups="clinic_insurance_authorization.group_clinic_insurance_adjudicator"
                            invisible="state not in ('submitted','pending')"/>
                    <button name="action_reject" type="object" string="Reject"
                            groups="clinic_insurance_authorization.group_clinic_insurance_adjudicator"
                            invisible="state not in ('submitted','pending')"/>
                    <button name="action_create_claim" type="object" string="Create Insurance Claim" class="btn-primary"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state not in ('approved','partial')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state in ('rejected','expired','cancelled')"/>
                    <button name="action_print_authorization" type="object" string="Print Authorization"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,prepared,submitted,pending,approved,partial,rejected,expired,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_policy" type="object" class="oe_stat_button" icon="fa-id-card">
                            <div class="o_stat_info"><span class="o_stat_text">Policy</span></div>
                        </button>
                        <button name="action_open_patient" type="object" class="oe_stat_button" icon="fa-user">
                            <div class="o_stat_info"><span class="o_stat_text">Patient</span></div>
                        </button>
                        <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="claim_count" widget="statinfo" string="Claims"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <div class="alert alert-warning" role="alert" invisible="eligibility_ok or state not in ('draft','prepared','submitted','pending')">
                        A current Eligible verification is not available for this Policy.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="not currently_valid">
                        This Authorization is approved and currently within its validity window.
                    </div>

                    <group>
                        <group string="Patient &amp; Payer">
                            <field name="patient_id" readonly="state not in ('draft','prepared')"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="policy_id" readonly="state not in ('draft','prepared')"/>
                            <field name="insurer_partner_id" readonly="1"/>
                            <field name="plan_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state not in ('draft','prepared')"/>
                            <field name="branch_id" readonly="state not in ('draft','prepared')"/>
                        </group>
                        <group string="Request &amp; Decision">
                            <field name="request_date"/>
                            <field name="service_date" readonly="state not in ('draft','prepared')"/>
                            <field name="submission_channel"/>
                            <field name="external_reference"/>
                            <field name="authorization_code"/>
                            <field name="valid_from" readonly="1"/>
                            <field name="valid_to" readonly="1"/>
                            <field name="authorization_required" readonly="1"/>
                            <field name="eligibility_ok" readonly="1"/>
                        </group>
                    </group>

                    <div class="d-flex gap-2 my-3">
                        <button name="action_open_source" type="object" string="Open Source Record" class="btn btn-secondary" invisible="source_type == 'manual'"/>
                    </div>

                    <notebook>
                        <page string="Requested Services">
                            <field name="line_ids" readonly="state in ('approved','partial','rejected','expired','cancelled')">
                                <list editable="bottom" decoration-success="approved_amount &gt;= requested_amount and approved_amount &gt; 0" decoration-warning="approved_amount &gt; 0 and approved_amount &lt; requested_amount">
                                    <field name="sequence" widget="handle"/>
                                    <field name="treatment_id" optional="show"/>
                                    <field name="treatment_catalog_id" optional="hide"/>
                                    <field name="procedure_catalog_id" optional="show"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="requested_amount" readonly="1" sum="Requested"/>
                                    <field name="benefit_rule_id" optional="show"/>
                                    <field name="authorization_required"/>
                                    <field name="coverage_percent"/>
                                    <field name="copay_percent"/>
                                    <field name="deductible_amount"/>
                                    <field name="approved_quantity"/>
                                    <field name="approved_amount" sum="Approved"/>
                                    <field name="insurer_payable_amount" readonly="1" sum="Payer"/>
                                    <field name="patient_responsibility_amount" readonly="1" sum="Patient"/>
                                    <button name="action_apply_benefit_rule" type="object" string="Apply Rule" icon="fa-refresh" invisible="state not in ('draft','prepared','submitted','pending')"/>
                                    <button name="action_open_authorization" type="object" string="Header" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>

                        <page string="Source Links">
                            <group>
                                <field name="source_type"/>
                                <field name="booking_id" invisible="source_type != 'booking'"/>
                                <field name="appointment_id" invisible="source_type != 'appointment'"/>
                                <field name="encounter_id" invisible="source_type != 'encounter'"/>
                                <field name="treatment_id" invisible="source_type != 'treatment'"/>
                                <field name="billing_invoice_id" invisible="source_type != 'billing'"/>
                            </group>
                        </page>

                        <page string="Clinical / Payer Notes">
                            <field name="request_reason"/>
                            <field name="diagnosis_summary"/>
                            <field name="clinical_note"/>
                            <field name="rejection_reason"/>
                            <field name="note"/>
                        </page>

                        <page string="Evidence">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>

                        <page string="Audit">
                            <group>
                                <field name="submitted_at" readonly="1"/>
                                <field name="decided_at" readonly="1"/>
                                <field name="decided_by_id" readonly="1"/>
                                <field name="requested_amount" readonly="1"/>
                                <field name="approved_amount" readonly="1"/>
                                <field name="insurer_payable_amount" readonly="1"/>
                                <field name="patient_responsibility_amount" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_insurance_authorization_line_search" model="ir.ui.view">
        <field name="name">clinic.insurance.authorization.line.search</field>
        <field name="model">clinic.insurance.authorization.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="authorization_id"/>
                <field name="treatment_id"/>
                <field name="procedure_catalog_id"/>
                <field name="product_id"/>
                <field name="benefit_rule_id"/>
                <filter name="preauth_required" string="Authorization Required" domain="[('authorization_required','=',True)]"/>
                <filter name="approved_value" string="Approved Value" domain="[('approved_amount','&gt;',0)]"/>
                <group>
                    <filter name="group_authorization" string="Authorization" context="{'group_by':'authorization_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_product" string="Product" context="{'group_by':'product_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_insurance_authorization_line_list" model="ir.ui.view">
        <field name="name">clinic.insurance.authorization.line.list</field>
        <field name="model">clinic.insurance.authorization.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="authorization_id"/>
                <field name="state" widget="badge"/>
                <field name="description"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="requested_amount" sum="Requested"/>
                <field name="coverage_percent"/>
                <field name="copay_percent"/>
                <field name="approved_quantity"/>
                <field name="approved_amount" sum="Approved"/>
                <field name="insurer_payable_amount" sum="Payer"/>
                <field name="patient_responsibility_amount" sum="Patient"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_apply_benefit_rule" type="object" string="Apply Rule" icon="fa-refresh" invisible="state not in ('draft','prepared','submitted','pending')"/>
                <button name="action_open_authorization" type="object" string="Open Authorization" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_authorization_line_form" model="ir.ui.view">
        <field name="name">clinic.insurance.authorization.line.form</field>
        <field name="model">clinic.insurance.authorization.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Requested Service">
                            <field name="authorization_id"/>
                            <field name="state" readonly="1"/>
                            <field name="treatment_id"/>
                            <field name="treatment_catalog_id"/>
                            <field name="procedure_catalog_id"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="requested_amount_snapshot"/>
                            <field name="requested_amount" readonly="1"/>
                        </group>
                        <group string="Coverage / Decision">
                            <field name="benefit_rule_id"/>
                            <field name="authorization_required"/>
                            <field name="coverage_percent"/>
                            <field name="copay_percent"/>
                            <field name="deductible_amount"/>
                            <field name="maximum_insurer_amount"/>
                            <field name="maximum_quantity"/>
                            <field name="approved_quantity"/>
                            <field name="approved_amount"/>
                            <field name="insurer_payable_amount" readonly="1"/>
                            <field name="patient_responsibility_amount" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <field name="decision_note"/>
                    <div class="d-flex gap-2">
                        <button name="action_apply_benefit_rule" type="object" string="Apply Benefit Rule" class="btn-primary" invisible="state not in ('draft','prepared','submitted','pending')"/>
                        <button name="action_open_authorization" type="object" string="Open Authorization" class="btn-secondary"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clinic_insurance_authorization" model="ir.actions.act_window">
        <field name="name">Insurance Pre-Authorizations</field>
        <field name="res_model">clinic.insurance.authorization</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_insurance_authorization_search"/>
    </record>

    <record id="action_clinic_insurance_authorization_from_patient" model="ir.actions.act_window">
        <field name="name">Patient Insurance Authorizations</field>
        <field name="res_model">clinic.insurance.authorization</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_insurance_authorization_search"/>
    </record>

    <record id="action_insurance_authorization_line" model="ir.actions.act_window">
        <field name="name">Authorization Service Lines</field>
        <field name="res_model">clinic.insurance.authorization.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_insurance_authorization_line_search"/>
    </record>
</odoo>

