<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_eligibility_search" model="ir.ui.view">
        <field name="name">clinic.insurance.eligibility.check.search</field>
        <field name="model">clinic.insurance.eligibility.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="policy_id"/>
                <field name="patient_id"/>
                <field name="insurer_partner_id"/>
                <field name="external_reference"/>
                <field name="company_id"/>
                <filter name="eligible" string="Eligible" domain="[('state','=','eligible')]"/>
                <filter name="ineligible" string="Ineligible" domain="[('state','=','ineligible')]"/>
                <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
                <group>
                    <filter name="group_policy" string="Policy" context="{'group_by':'policy_id'}"/>
                    <filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/>
                    <filter name="group_insurer" string="Insurer" context="{'group_by':'insurer_partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_insurance_eligibility_list" model="ir.ui.view">
        <field name="name">clinic.insurance.eligibility.check.list</field>
        <field name="model">clinic.insurance.eligibility.check</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'eligible'" decoration-danger="state == 'ineligible'" decoration-warning="state in ('pending','error')" decoration-muted="state in ('expired','cancelled')">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="policy_id"/>
                <field name="insurer_partner_id"/>
                <field name="verification_method"/>
                <field name="external_reference"/>
                <field name="checked_at"/>
                <field name="valid_until"/>
                <field name="response_code"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_eligibility_form" model="ir.ui.view">
        <field name="name">clinic.insurance.eligibility.check.form</field>
        <field name="model">clinic.insurance.eligibility.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check_internal" type="object" string="Run Internal Check" class="btn-primary"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state not in ('draft','error')"/>
                    <button name="action_mark_pending" type="object" string="Send / Mark Pending"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_eligible" type="object" string="Mark Eligible" class="btn-primary"
                            groups="clinic_insurance_authorization.group_clinic_insurance_adjudicator"
                            invisible="state not in ('pending','draft','error')"/>
                    <button name="action_mark_ineligible" type="object" string="Mark Ineligible"
                            groups="clinic_insurance_authorization.group_clinic_insurance_adjudicator"
                            invisible="state not in ('pending','draft','error')"/>
                    <button name="action_mark_error" type="object" string="Mark Error"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state in ('eligible','ineligible','expired','cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state in ('eligible','ineligible','expired','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,eligible,ineligible,error,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_policy" type="object" class="oe_stat_button" icon="fa-id-card">
                            <div class="o_stat_info"><span class="o_stat_text">Policy</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Coverage Identity">
                            <field name="policy_id" readonly="state != 'draft'"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="insurer_partner_id" readonly="1"/>
                            <field name="plan_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="branch_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Verification">
                            <field name="verification_method"/>
                            <field name="external_reference"/>
                            <field name="requested_at" readonly="1"/>
                            <field name="checked_at" readonly="1"/>
                            <field name="valid_until" readonly="state in ('eligible','expired')"/>
                            <field name="response_code"/>
                            <field name="coverage_status_text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payer Response"><field name="response_message"/></page>
                        <page string="Error"><field name="error_message"/></page>
                        <page string="Evidence"><field name="attachment_ids" widget="many2many_binary"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_insurance_eligibility" model="ir.actions.act_window">
        <field name="name">Eligibility Checks</field>
        <field name="res_model">clinic.insurance.eligibility.check</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_insurance_eligibility_search"/>
    </record>
</odoo>

