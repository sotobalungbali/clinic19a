<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_insurance_policy_search" model="ir.ui.view">
        <field name="name">clinic.insurance.policy.search</field>
        <field name="model">clinic.insurance.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="policy_number"/>
                <field name="member_number"/>
                <field name="patient_id"/>
                <field name="insurer_partner_id"/>
                <field name="plan_id"/>
                <field name="company_id"/>
                <filter name="active_policy" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="currently_valid" string="Currently Valid" domain="[('currently_valid', '=', True)]"/>
                <filter name="eligibility_attention" string="Eligibility Attention" domain="[('eligibility_state', '!=', 'eligible')]"/>
                <filter name="preauth_required" string="Pre-Authorization Required" domain="[('authorization_required', '=', True)]"/>
                <group>
                    <filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/>
                    <filter name="group_insurer" string="Insurer" context="{'group_by':'insurer_partner_id'}"/>
                    <filter name="group_plan" string="Plan" context="{'group_by':'plan_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_insurance_policy_list" model="ir.ui.view">
        <field name="name">clinic.insurance.policy.list</field>
        <field name="model">clinic.insurance.policy</field>
        <field name="arch" type="xml">
            <list decoration-success="currently_valid" decoration-warning="state == 'suspended'" decoration-danger="state in ('expired','cancelled')">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="insurer_partner_id"/>
                <field name="plan_id"/>
                <field name="policy_number"/>
                <field name="member_number"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="coverage_percent" readonly="state not in ('draft','verified')"/>
                <field name="eligibility_state" widget="badge"/>
                <field name="authorization_required" readonly="state not in ('draft','verified')"/>
                <field name="authorization_count"/>
                <field name="claim_count"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="currently_valid" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_insurance_policy_form" model="ir.ui.view">
        <field name="name">clinic.insurance.policy.form</field>
        <field name="model">clinic.insurance.policy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" type="object" string="Verify" class="btn-primary"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state != 'verified'"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            groups="clinic_insurance_authorization.group_clinic_insurance_manager"
                            invisible="state != 'active'"/>
                    <button name="action_mark_expired" type="object" string="Mark Expired"
                            groups="clinic_insurance_authorization.group_clinic_insurance_coordinator"
                            invisible="state in ('expired','cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="clinic_insurance_authorization.group_clinic_insurance_manager"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verified,active,suspended,expired,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_eligibility" type="object" class="oe_stat_button" icon="fa-shield">
                            <field name="eligibility_count" widget="statinfo" string="Eligibility"/>
                        </button>
                        <button name="action_view_authorizations" type="object" class="oe_stat_button" icon="fa-check-circle">
                            <field name="authorization_count" widget="statinfo" string="Authorizations"/>
                        </button>
                        <button name="action_view_claims" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="claim_count" widget="statinfo" string="Claims"/>
                        </button>
                        <button name="action_open_patient" type="object" class="oe_stat_button" icon="fa-user">
                            <div class="o_stat_info"><span class="o_stat_text">Patient</span></div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <div class="alert alert-success" role="alert" invisible="not currently_valid">
                        Policy is active and within its coverage dates.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="eligibility_state == 'eligible'">
                        Current payer eligibility evidence is not Eligible.
                    </div>

                    <group>
                        <group string="Member &amp; Policy">
                            <field name="patient_id" readonly="state not in ('draft','verified')"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="insurer_partner_id" readonly="state not in ('draft','verified')"/>
                            <field name="plan_id" readonly="state not in ('draft','verified')"/>
                            <field name="policy_number" readonly="state not in ('draft','verified')"/>
                            <field name="member_number"/>
                            <field name="group_number"/>
                            <field name="relationship_to_holder"/>
                            <field name="policy_holder_name"/>
                        </group>
                        <group string="Coverage Window">
                            <field name="company_id" groups="base.group_multi_company" readonly="state not in ('draft','verified')"/>
                            <field name="branch_id"/>
                            <field name="start_date" readonly="state not in ('draft','verified')"/>
                            <field name="end_date" readonly="state not in ('draft','verified')"/>
                            <field name="currently_valid" readonly="1"/>
                            <field name="eligibility_state" widget="badge" readonly="1"/>
                            <field name="eligibility_valid_until" readonly="1"/>
                            <field name="last_eligibility_check_id" readonly="1"/>
                        </group>
                    </group>

                    <div class="d-flex gap-2 my-3">
                        <button name="action_new_eligibility_check" type="object" string="New Eligibility Check" class="btn btn-primary"/>
                        <button name="action_new_authorization" type="object" string="New Pre-Authorization" class="btn btn-secondary"/>
                    </div>

                    <notebook>
                        <page string="Coverage Terms">
                            <group>
                                <field name="coverage_percent"/>
                                <field name="copay_percent" readonly="state not in ('draft','verified')"/>
                                <field name="deductible_amount" readonly="state not in ('draft','verified')"/>
                                <field name="annual_limit" readonly="state not in ('draft','verified')"/>
                                <field name="settled_claim_amount" readonly="1"/>
                                <field name="remaining_annual_limit" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="authorization_required"/>
                                <field name="authorization_valid_days" readonly="state not in ('draft','verified')"/>
                                <field name="eligibility_valid_days" readonly="state not in ('draft','verified')"/>
                            </group>
                        </page>
                        <page string="Verification &amp; Status">
                            <group>
                                <field name="verification_reference"/>
                                <field name="verified_at" readonly="1"/>
                                <field name="verified_by_id" readonly="1"/>
                                <field name="suspension_reason"/>
                                <field name="cancellation_reason"/>
                            </group>
                        </page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_insurance_policy" model="ir.actions.act_window">
        <field name="name">Insurance Policies</field>
        <field name="res_model">clinic.insurance.policy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_insurance_policy_search"/>
    </record>
</odoo>

