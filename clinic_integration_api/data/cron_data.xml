<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_api_dispatch_webhooks" model="ir.cron">
        <field name="name">Clinic Integration API: Dispatch Webhooks</field>
        <field name="model_id" ref="model_clinic_api_webhook_delivery"/>
        <field name="state">code</field><field name="code">model._cron_dispatch()</field>
        <field name="interval_number">1</field><field name="interval_type">minutes</field><field name="active">True</field>
    </record>
    <record id="cron_api_cleanup_idempotency" model="ir.cron">
        <field name="name">Clinic Integration API: Cleanup Idempotency</field>
        <field name="model_id" ref="model_clinic_api_idempotency"/>
        <field name="state">code</field><field name="code">model._cron_cleanup_expired()</field>
        <field name="interval_number">1</field><field name="interval_type">days</field><field name="active">True</field>
    </record>
</odoo>
