<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_api_operator" model="res.groups">
        <field name="name">Clinic Integration API Operator</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_api_manager" model="res.groups">
        <field name="name">Clinic Integration API Manager</field>
        <field name="implied_ids" eval="[(4, ref('clinic_integration_api.group_api_operator'))]"/>
    </record>

    <record id="rule_api_client_company" model="ir.rule">
        <field name="name">API Client: user companies</field>
        <field name="model_id" ref="model_clinic_api_client"/>
        <field name="groups" eval="[(4, ref('clinic_integration_api.group_api_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_api_provider_company" model="ir.rule">
        <field name="name">API Provider: user companies</field>
        <field name="model_id" ref="model_clinic_api_provider"/>
        <field name="groups" eval="[(4, ref('clinic_integration_api.group_api_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_api_request_company" model="ir.rule">
        <field name="name">API Request Log: user companies</field>
        <field name="model_id" ref="model_clinic_api_request_log"/>
        <field name="groups" eval="[(4, ref('clinic_integration_api.group_api_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_api_idempotency_company" model="ir.rule">
        <field name="name">API Idempotency: user companies</field>
        <field name="model_id" ref="model_clinic_api_idempotency"/>
        <field name="groups" eval="[(4, ref('clinic_integration_api.group_api_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_api_event_company" model="ir.rule">
        <field name="name">API Event: user companies</field>
        <field name="model_id" ref="model_clinic_api_event"/>
        <field name="groups" eval="[(4, ref('clinic_integration_api.group_api_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_api_subscription_company" model="ir.rule">
        <field name="name">API Subscription: user companies</field>
        <field name="model_id" ref="model_clinic_api_webhook_subscription"/>
        <field name="groups" eval="[(4, ref('clinic_integration_api.group_api_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
    <record id="rule_api_delivery_company" model="ir.rule">
        <field name="name">API Delivery: user companies</field>
        <field name="model_id" ref="model_clinic_api_webhook_delivery"/>
        <field name="groups" eval="[(4, ref('clinic_integration_api.group_api_operator'))]"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>
