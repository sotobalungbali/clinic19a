<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_client_search" model="ir.ui.view">
        <field name="name">clinic.api.client.search</field><field name="model">clinic.api.client</field>
        <field name="arch" type="xml"><search string="API Clients">
            <field name="name"/><field name="code"/><field name="user_id"/><field name="company_id"/><field name="scope_ids"/>
            <filter name="active_state" string="Active" domain="[('state','=','active')]"/>
            <filter name="suspended" string="Suspended" domain="[('state','=','suspended')]"/>
            <separator/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/>
        </search></field>
    </record>
    <record id="view_api_client_list" model="ir.ui.view">
        <field name="name">clinic.api.client.list</field><field name="model">clinic.api.client</field>
        <field name="arch" type="xml"><list string="API Clients" default_order="name" decoration-muted="state == 'suspended'" multi_edit="1">
            <field name="code"/><field name="name"/><field name="user_id"/><field name="company_id" groups="base.group_multi_company"/><field name="scope_ids" widget="many2many_tags" optional="show"/><field name="requests_per_minute" optional="show"/><field name="last_used_at" optional="show"/><field name="state" widget="badge"/>
        </list></field>
    </record>
    <record id="view_api_client_form" model="ir.ui.view">
        <field name="name">clinic.api.client.form</field><field name="model">clinic.api.client</field>
        <field name="arch" type="xml"><form string="API Client">
            <header>
                <button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'" groups="clinic_integration_api.group_api_manager"/>
                <button name="action_suspend" type="object" string="Suspend" invisible="state != 'active'" groups="clinic_integration_api.group_api_manager"/>
                <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'" groups="clinic_integration_api.group_api_manager"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,active,suspended"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-exchange"><field name="request_count" widget="statinfo" string="Requests"/></button>
                    <button name="action_view_idempotency" type="object" class="oe_stat_button" icon="fa-lock"><field name="idempotency_count" widget="statinfo" string="Idempotency"/></button>
                </div>
                <widget name="web_ribbon" title="Suspended" bg_color="text-bg-warning" invisible="state != 'suspended'"/>
                <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="e.g. Mobile App Production"/></h1><div><field name="code" class="oe_inline" readonly="1"/></div></div>
                <group>
                    <group string="Identity &amp; Authentication"><field name="user_id"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group>
                    <group string="Traffic Policy"><field name="requests_per_minute"/><field name="idempotency_ttl_hours"/><field name="last_used_at" readonly="1"/></group>
                </group>
                <notebook>
                    <page string="Authorization Scope"><group><field name="allowed_company_ids" widget="many2many_tags"/><field name="branch_ids" widget="many2many_tags"/><field name="scope_ids" widget="many2many_tags"/></group></page>
                    <page string="Recent Requests"><field name="request_log_ids" readonly="1"><list create="0" delete="0"><field name="requested_at"/><field name="request_id"/><field name="method"/><field name="resource"/><field name="status_code"/><field name="duration_ms"/></list></field></page>
                    <page string="Notes"><field name="notes" placeholder="Operational purpose, owner, rotation notes..."/></page>
                </notebook>
            </sheet><chatter/>
        </form></field>
    </record>
    <record id="action_api_clients" model="ir.actions.act_window"><field name="name">API Clients</field><field name="res_model">clinic.api.client</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_api_client_search"/></record>
</odoo>
