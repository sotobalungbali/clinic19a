<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_delivery_search" model="ir.ui.view"><field name="name">clinic.api.webhook.delivery.search</field><field name="model">clinic.api.webhook.delivery</field><field name="arch" type="xml"><search string="Webhook Deliveries"><field name="event_id"/><field name="subscription_id"/><field name="provider_id"/><field name="company_id"/><field name="branch_id"/><filter name="pending" string="Pending" domain="[('state','=','pending')]"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><filter name="dead" string="Dead Letter" domain="[('state','=','dead')]"/><separator/><filter name="group_provider" string="Provider" context="{'group_by':'provider_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
    <record id="view_api_delivery_list" model="ir.ui.view"><field name="name">clinic.api.webhook.delivery.list</field><field name="model">clinic.api.webhook.delivery</field><field name="arch" type="xml"><list string="Webhook Deliveries" default_order="next_attempt_at,id" decoration-danger="state == 'dead'" decoration-warning="state == 'failed'"><field name="event_id"/><field name="provider_id"/><field name="subscription_id" optional="show"/><field name="attempt_count"/><field name="status_code" optional="show"/><field name="next_attempt_at"/><field name="delivered_at" optional="show"/><field name="state" widget="badge"/><button name="action_open_event" type="object" string="Event" icon="fa-external-link"/><button name="action_retry" type="object" string="Retry" icon="fa-refresh" invisible="state not in ['failed','dead']" groups="clinic_integration_api.group_api_manager"/></list></field></record>
    <record id="view_api_delivery_form" model="ir.ui.view"><field name="name">clinic.api.webhook.delivery.form</field><field name="model">clinic.api.webhook.delivery</field><field name="arch" type="xml"><form string="Webhook Delivery"><header><button name="action_retry" type="object" string="Retry from Dead Letter" class="btn-primary" invisible="state not in ['failed','dead']" groups="clinic_integration_api.group_api_manager"/><button name="action_open_event" type="object" string="Open Event"/><field name="state" widget="statusbar" statusbar_visible="pending,processing,delivered,failed,dead"/></header><sheet><group><group><field name="event_id"/><field name="subscription_id"/><field name="provider_id"/><field name="company_id" groups="base.group_multi_company"/><field name="branch_id"/></group><group><field name="attempt_count"/><field name="next_attempt_at"/><field name="delivered_at"/><field name="status_code"/><field name="provider_reference"/></group></group><group string="Failure Evidence" groups="clinic_integration_api.group_api_manager"><field name="error_message"/><field name="response_excerpt"/></group></sheet></form></field></record>
    <record id="action_api_deliveries" model="ir.actions.act_window"><field name="name">Webhook Deliveries</field><field name="res_model">clinic.api.webhook.delivery</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_api_delivery_search"/></record>
</odoo>
