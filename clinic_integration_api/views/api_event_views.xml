<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_event_search" model="ir.ui.view"><field name="name">clinic.api.event.search</field><field name="model">clinic.api.event</field><field name="arch" type="xml"><search string="Integration Events"><field name="name"/><field name="event_type_id"/><field name="model_name"/><field name="company_id"/><field name="branch_id"/><filter name="queued" string="Queued" domain="[('state','=','queued')]"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><separator/><filter name="group_type" string="Event Type" context="{'group_by':'event_type_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></search></field></record>
    <record id="view_api_event_list" model="ir.ui.view"><field name="name">clinic.api.event.list</field><field name="model">clinic.api.event</field><field name="arch" type="xml"><list string="Integration Events" default_order="create_date desc" decoration-danger="state == 'failed'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="event_type_id"/><field name="model_name"/><field name="res_id"/><field name="branch_id" optional="show"/><field name="delivery_count" optional="show"/><field name="available_at"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_api_event_form" model="ir.ui.view"><field name="name">clinic.api.event.form</field><field name="model">clinic.api.event</field><field name="arch" type="xml"><form string="Integration Event"><header><button name="action_queue" type="object" string="Queue" class="btn-primary" invisible="state not in ['draft','failed']" groups="clinic_integration_api.group_api_manager"/><button name="action_retry" type="object" string="Retry Failed Deliveries" invisible="state not in ['failed','done']" groups="clinic_integration_api.group_api_manager"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ['done','cancelled']" groups="clinic_integration_api.group_api_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,queued,processing,done,failed,cancelled"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_deliveries" type="object" class="oe_stat_button" icon="fa-paper-plane"><field name="delivery_count" widget="statinfo" string="Deliveries"/></button></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="event_type_id"/><field name="model_name"/><field name="res_id"/><field name="available_at"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="branch_id"/><field name="attempt_count" readonly="1"/><field name="error_message" readonly="1" groups="clinic_integration_api.group_api_manager"/></group></group><notebook><page string="Delivery History"><field name="delivery_ids" readonly="1"><list create="0" delete="0"><field name="provider_id"/><field name="state" widget="badge"/><field name="attempt_count"/><field name="status_code"/><field name="next_attempt_at"/><button name="action_open_event" type="object" string="Event" icon="fa-external-link"/><button name="action_retry" type="object" string="Retry" icon="fa-refresh" invisible="state not in ['failed','dead']" groups="clinic_integration_api.group_api_manager"/></list></field></page><page string="Payload" groups="clinic_integration_api.group_api_manager"><field name="payload_json" widget="text"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_api_events" model="ir.actions.act_window"><field name="name">Integration Events</field><field name="res_model">clinic.api.event</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_api_event_search"/></record>
</odoo>
