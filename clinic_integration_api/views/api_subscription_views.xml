<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_subscription_search" model="ir.ui.view"><field name="name">clinic.api.webhook.subscription.search</field><field name="model">clinic.api.webhook.subscription</field><field name="arch" type="xml"><search string="Webhook Subscriptions"><field name="name"/><field name="provider_id"/><field name="event_type_ids"/><field name="company_id"/><field name="branch_id"/><filter name="active_state" string="Active" domain="[('state','=','active')]"/><separator/><filter name="group_provider" string="Provider" context="{'group_by':'provider_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
    <record id="view_api_subscription_list" model="ir.ui.view"><field name="name">clinic.api.webhook.subscription.list</field><field name="model">clinic.api.webhook.subscription</field><field name="arch" type="xml"><list string="Webhook Subscriptions" default_order="company_id,provider_id,name" decoration-muted="state == 'suspended'"><field name="name"/><field name="provider_id"/><field name="event_type_ids" widget="many2many_tags"/><field name="endpoint_path"/><field name="max_attempts" optional="show"/><field name="delivery_count" optional="show"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_api_subscription_form" model="ir.ui.view"><field name="name">clinic.api.webhook.subscription.form</field><field name="model">clinic.api.webhook.subscription</field><field name="arch" type="xml"><form string="Webhook Subscription"><header><button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'" groups="clinic_integration_api.group_api_manager"/><button name="action_suspend" type="object" string="Suspend" invisible="state != 'active'" groups="clinic_integration_api.group_api_manager"/><button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'" groups="clinic_integration_api.group_api_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,active,suspended"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_deliveries" type="object" class="oe_stat_button" icon="fa-paper-plane"><field name="delivery_count" widget="statinfo" string="Deliveries"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="provider_id"/><field name="company_id" readonly="1" groups="base.group_multi_company"/><field name="branch_id" readonly="1"/></group><group><field name="endpoint_path"/><field name="signing_enabled"/><field name="max_attempts"/><field name="backoff_seconds"/><field name="active"/></group></group><notebook><page string="Events"><field name="event_type_ids" widget="many2many_tags"/></page><page string="Delivery History"><field name="delivery_ids" readonly="1"><list create="0" delete="0"><field name="event_id"/><field name="state" widget="badge"/><field name="attempt_count"/><field name="status_code"/><field name="next_attempt_at"/><button name="action_open_event" type="object" string="Open Event" icon="fa-external-link"/><button name="action_retry" type="object" string="Retry" icon="fa-refresh" invisible="state not in ['failed','dead']" groups="clinic_integration_api.group_api_manager"/></list></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_api_subscriptions" model="ir.actions.act_window"><field name="name">Webhook Subscriptions</field><field name="res_model">clinic.api.webhook.subscription</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_api_subscription_search"/></record>
</odoo>
