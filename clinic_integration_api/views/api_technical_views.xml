<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_api_scope_search" model="ir.ui.view"><field name="name">clinic.api.scope.search</field><field name="model">clinic.api.scope</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><filter name="active" string="Active" domain="[('active','=',True)]"/></search></field></record>
    <record id="view_api_scope_list" model="ir.ui.view"><field name="name">clinic.api.scope.list</field><field name="model">clinic.api.scope</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="active"/></list></field></record>
    <record id="view_api_scope_form" model="ir.ui.view"><field name="name">clinic.api.scope.form</field><field name="model">clinic.api.scope</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="sequence"/><field name="active"/><field name="description"/></group></sheet></form></field></record>
    <record id="action_api_scopes" model="ir.actions.act_window"><field name="name">API Scopes</field><field name="res_model">clinic.api.scope</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_api_scope_search"/></record>

    <record id="view_api_event_type_search" model="ir.ui.view"><field name="name">clinic.api.event.type.search</field><field name="model">clinic.api.event.type</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><filter name="active" string="Active" domain="[('active','=',True)]"/></search></field></record>
    <record id="view_api_event_type_list" model="ir.ui.view"><field name="name">clinic.api.event.type.list</field><field name="model">clinic.api.event.type</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="active"/></list></field></record>
    <record id="view_api_event_type_form" model="ir.ui.view"><field name="name">clinic.api.event.type.form</field><field name="model">clinic.api.event.type</field><field name="arch" type="xml"><form><sheet><group><field name="code"/><field name="name"/><field name="active"/><field name="description"/></group></sheet></form></field></record>
    <record id="action_api_event_types" model="ir.actions.act_window"><field name="name">Event Types</field><field name="res_model">clinic.api.event.type</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_api_event_type_search"/></record>

    <record id="view_api_request_search" model="ir.ui.view"><field name="name">clinic.api.request.log.search</field><field name="model">clinic.api.request.log</field><field name="arch" type="xml"><search><field name="request_id"/><field name="client_id"/><field name="resource"/><field name="company_id"/><filter name="errors" string="Errors" domain="[('status_code','&gt;=',400)]"/><separator/><filter name="group_client" string="Client" context="{'group_by':'client_id'}"/><filter name="group_resource" string="Resource" context="{'group_by':'resource'}"/><filter name="group_status" string="Status Code" context="{'group_by':'status_code'}"/></search></field></record>
    <record id="view_api_request_list" model="ir.ui.view"><field name="name">clinic.api.request.log.list</field><field name="model">clinic.api.request.log</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" default_order="requested_at desc" decoration-danger="status_code &gt;= 500" decoration-warning="status_code &gt;= 400 and status_code &lt; 500"><field name="requested_at"/><field name="request_id"/><field name="client_id"/><field name="method"/><field name="resource"/><field name="status_code"/><field name="duration_ms"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_api_request_form" model="ir.ui.view"><field name="name">clinic.api.request.log.form</field><field name="model">clinic.api.request.log</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><group><field name="requested_at"/><field name="request_id"/><field name="client_id"/><field name="user_id"/><field name="company_id"/></group><group><field name="method"/><field name="route"/><field name="resource"/><field name="status_code"/><field name="duration_ms"/></group></group><group string="Restricted Diagnostics" groups="clinic_integration_api.group_api_manager"><field name="remote_addr"/><field name="error_code"/><field name="error_message"/></group></sheet></form></field></record>
    <record id="action_api_requests" model="ir.actions.act_window"><field name="name">Request Logs</field><field name="res_model">clinic.api.request.log</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_api_request_search"/></record>

    <record id="view_api_idempotency_search" model="ir.ui.view"><field name="name">clinic.api.idempotency.search</field><field name="model">clinic.api.idempotency</field><field name="arch" type="xml"><search><field name="idem_key"/><field name="client_id"/><field name="resource"/><field name="company_id"/><filter name="processing" string="Processing" domain="[('state','=','processing')]"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><separator/><filter name="group_client" string="Client" context="{'group_by':'client_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
    <record id="view_api_idempotency_list" model="ir.ui.view"><field name="name">clinic.api.idempotency.list</field><field name="model">clinic.api.idempotency</field><field name="arch" type="xml"><list default_order="create_date desc" decoration-danger="state == 'failed'"><field name="client_id"/><field name="idem_key"/><field name="resource"/><field name="state" widget="badge"/><field name="response_code"/><field name="expires_at"/></list></field></record>
    <record id="view_api_idempotency_form" model="ir.ui.view"><field name="name">clinic.api.idempotency.form</field><field name="model">clinic.api.idempotency</field><field name="arch" type="xml"><form><sheet><group><group><field name="client_id"/><field name="company_id"/><field name="idem_key"/><field name="resource"/><field name="state"/></group><group><field name="request_hash"/><field name="response_code"/><field name="expires_at"/></group></group><group groups="clinic_integration_api.group_api_manager"><field name="error_message"/><field name="response_json" widget="text"/></group></sheet></form></field></record>
    <record id="action_api_idempotency" model="ir.actions.act_window"><field name="name">Idempotency</field><field name="res_model">clinic.api.idempotency</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_api_idempotency_search"/></record>
</odoo>
