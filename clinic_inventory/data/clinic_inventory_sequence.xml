<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence codes are already called by the existing business models. -->
    <record id="seq_clinic_treatment_product_usage" model="ir.sequence">
        <field name="name">Clinic Treatment Product Usage</field>
        <field name="code">clinic.treatment.product.usage</field>
        <field name="prefix">CPU/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_clinic_inventory_adjustment" model="ir.sequence">
        <field name="name">Clinic Inventory Adjustment</field>
        <field name="code">clinic.inventory.adjustment</field>
        <field name="prefix">CIA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>




