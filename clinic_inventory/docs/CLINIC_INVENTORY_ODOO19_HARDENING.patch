+                <field name="product_id"/>
+                <field name="lot_id"/>
+            </search>
+        </field>
+    </record>
+
+    <record id="view_clinic_treatment_product_usage_line_list" model="ir.ui.view">
+        <field name="name">clinic.treatment.product.usage.line.list</field>
+        <field name="model">clinic.treatment.product.usage.line</field>
+        <field name="arch" type="xml">
+            <list string="Treatment Product Usage Lines">
+                <field name="usage_id"/>
+                <field name="sequence"/>
+                <field name="product_id"/>
+                <field name="product_uom"/>
+                <field name="product_uom_qty"/>
+                <field name="lot_id"/>
+                <field name="qty_onhand_at_source"/>
+                <button name="action_open_usage" type="object" icon="fa-external-link" title="Open Usage"/>
+            </list>
+        </field>
+    </record>
+
+    <record id="view_clinic_treatment_product_usage_line_form" model="ir.ui.view">
+        <field name="name">clinic.treatment.product.usage.line.form</field>
+        <field name="model">clinic.treatment.product.usage.line</field>
+        <field name="arch" type="xml">
+            <form string="Treatment Product Usage Line">
+                <sheet>
+                    <div class="oe_button_box" name="button_box">
+                        <button name="action_open_usage" type="object" class="oe_stat_button" icon="fa-external-link">
+                            <div class="o_stat_info"><span class="o_stat_text">Usage</span></div>
+                        </button>
+                    </div>
+                    <group>
+                        <field name="usage_id"/>
+                        <field name="sequence"/>
+                        <field name="product_id"/>
+                        <field name="product_uom"/>
+                        <field name="product_uom_qty"/>
+                        <field name="lot_id"/>
+                        <field name="qty_onhand_at_source" readonly="1"/>
+                        <field name="note"/>
+                    </group>
+                </sheet>
+            </form>
+        </field>
+    </record>
+
+    <record id="action_clinic_treatment_product_usage_line" model="ir.actions.act_window">
+        <field name="name">Treatment Product Usage Lines</field>
+        <field name="res_model">clinic.treatment.product.usage.line</field>
+        <field name="view_mode">list,form</field>
+        <field name="search_view_id" ref="view_clinic_treatment_product_usage_line_search"/>
+    </record>
+</odoo>




