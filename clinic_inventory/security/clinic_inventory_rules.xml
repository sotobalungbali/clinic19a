<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ORM security is authoritative. UI visibility is never a substitute. -->
    <record id="rule_clinic_doctor_allowed_product_company" model="ir.rule">
        <field name="name">Clinic Doctor Product Rules: Allowed Companies</field>
        <field name="model_id" ref="model_clinic_doctor_allowed_product"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

