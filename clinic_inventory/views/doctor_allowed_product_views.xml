<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_doctor_allowed_product_search" model="ir.ui.view">
        <field name="name">clinic.doctor.allowed.product.search</field>
        <field name="model">clinic.doctor.allowed.product</field>
        <field name="arch" type="xml">
            <search string="Doctor Product Rules">
                <field name="name"/>
                <field name="doctor_id"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <filter name="filter_active" string="Active" domain="[('is_active','=',True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('archived','=',True)]"/>
                <filter name="filter_allow" string="Allow" domain="[('action','=','allow')]"/>
                <filter name="filter_deny" string="Deny" domain="[('action','=','deny')]"/>
                <group>
                    <filter name="group_doctor" string="Doctor" context="{'group_by':'doctor_id'}"/>
                    <filter name="group_action" string="Action" context="{'group_by':'action'}"/>
                    <filter name="group_type" string="Rule Type" context="{'group_by':'rule_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_clinic_doctor_allowed_product_list" model="ir.ui.view">
        <field name="name">clinic.doctor.allowed.product.list</field>
        <field name="model">clinic.doctor.allowed.product</field>
        <field name="arch" type="xml">
            <list string="Doctor Product Rules"
                  decoration-muted="archived"
                  decoration-danger="action == 'deny'"
                  decoration-success="action == 'allow'">
                <field name="priority"/>
                <field name="doctor_id"/>
                <field name="rule_type"/>
                <field name="product_id" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="action" widget="badge"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="is_active"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_doctor_allowed_product_form" model="ir.ui.view">
        <field name="name">clinic.doctor.allowed.product.form</field>
        <field name="model">clinic.doctor.allowed.product</field>
        <field name="arch" type="xml">
            <form string="Doctor Product Rule">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_allowed_products" type="object" class="oe_stat_button"
                                icon="fa-cubes">
                            <div class="o_stat_info"><span class="o_stat_text">Allowed Products</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Rule">
                            <field name="doctor_id"/>
                            <field name="rule_type"/>
                            <field name="product_id" invisible="rule_type != 'product'"/>
                            <field name="category_id" invisible="rule_type != 'category'"/>
                            <field name="action"/>
                            <field name="priority"/>
                        </group>
                        <group string="Validity">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="archived"/>
                            <field name="is_active" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_clinic_doctor_allowed_product" model="ir.actions.act_window">
        <field name="name">Doctor Product Rules</field>
        <field name="res_model">clinic.doctor.allowed.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_doctor_allowed_product_search"/>
    </record>
</odoo>




