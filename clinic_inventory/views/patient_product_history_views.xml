<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_patient_product_history_search" model="ir.ui.view">
        <field name="name">clinic.patient.product.history.search</field>
        <field name="model">clinic.patient.product.history</field>
        <field name="arch" type="xml">
            <search string="Patient Product History">
                <field name="patient_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="doctor_id"/>
                <field name="warehouse_id"/>
                <field name="responsible_id"/>
                <filter name="filter_out" string="Consumed / Out" domain="[('direction','=','out')]"/>
                <filter name="filter_in" string="Returned / In" domain="[('direction','=','in')]"/>
                <group>
                    <filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by':'product_id'}"/>
                    <filter name="group_doctor" string="Doctor" context="{'group_by':'doctor_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by':'date_use:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_clinic_patient_product_history_list" model="ir.ui.view">
        <field name="name">clinic.patient.product.history.list</field>
        <field name="model">clinic.patient.product.history</field>
        <field name="arch" type="xml">
            <list string="Patient Product History">
                <field name="date_use"/>
                <field name="patient_id"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="qty"/>
                <field name="uom_id"/>
                <field name="direction" widget="badge"/>
                <field name="purpose"/>
                <field name="doctor_id" optional="show"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_patient_product_history_form" model="ir.ui.view">
        <field name="name">clinic.patient.product.history.form</field>
        <field name="model">clinic.patient.product.history</field>
        <field name="arch" type="xml">
            <form string="Patient Product History">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object" class="oe_stat_button"
                                icon="fa-truck" invisible="not picking_id">
                            <div class="o_stat_info"><span class="o_stat_text">Picking</span></div>
                        </button>
                        <button name="action_view_move" type="object" class="oe_stat_button"
                                icon="fa-exchange" invisible="not move_id">
                            <div class="o_stat_info"><span class="o_stat_text">Stock Move</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Patient &amp; Product">
                            <field name="date_use"/>
                            <field name="patient_id"/>
                            <field name="product_id"/>
                            <field name="product_tmpl_id" readonly="1"/>
                            <field name="lot_id"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                            <field name="direction"/>
                            <field name="signed_qty" readonly="1"/>
                            <field name="purpose"/>
                        </group>
                        <group string="Clinical &amp; Inventory Traceability">
                            <field name="doctor_id"/>
                            <field name="treatment_ref"/>
                            <field name="usage_id"/>
                            <field name="picking_id"/>
                            <field name="move_id"/>
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_clinic_patient_product_history" model="ir.actions.act_window">
        <field name="name">Patient Product History</field>
        <field name="res_model">clinic.patient.product.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_patient_product_history_search"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>




