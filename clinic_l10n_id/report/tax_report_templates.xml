<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_ppn_tax_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>ClinicOne PPN Tax Report</h2>

                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Reference:</strong> <span t-field="o.name"/><br/>
                        <strong>Period:</strong> <span t-field="o.date_from"/> - <span t-field="o.date_to"/><br/>
                        <strong>Source Scope:</strong> <span t-field="o.source_scope"/>
                    </div>
                    <div class="col-6">
                        <strong>Company:</strong> <span t-field="o.company_id"/><br/>
                        <strong>Tax Profile:</strong> <span t-field="o.profile_id"/><br/>
                        <strong>Status:</strong> <span t-field="o.state"/>
                    </div>
                </div>

                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Direction</th>
                            <th>Invoice</th>
                            <th>Partner</th>
                            <th>NPWP</th>
                            <th>Clinic Source</th>
                            <th>Tax</th>
                            <th class="text-end">DPP</th>
                            <th class="text-end">PPN</th>
                            <th>Coretax Code</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.line_ids" t-as="line">
                            <td><span t-field="line.date"/></td>
                            <td><span t-field="line.direction"/></td>
                            <td><span t-field="line.invoice_number"/></td>
                            <td><span t-field="line.partner_id"/></td>
                            <td><span t-field="line.partner_npwp"/></td>
                            <td><span t-field="line.clinic_source"/></td>
                            <td><span t-field="line.tax_id"/></td>
                            <td class="text-end"><span t-field="line.base_amount"/></td>
                            <td class="text-end"><span t-field="line.tax_amount"/></td>
                            <td><span t-field="line.transaction_code"/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row mt-4">
                    <div class="col-6"/>
                    <div class="col-6">
                        <table class="table table-sm">
                            <tr><th>PPN Output DPP</th><td class="text-end"><span t-field="o.output_base"/></td></tr>
                            <tr><th>PPN Output</th><td class="text-end"><span t-field="o.output_tax"/></td></tr>
                            <tr><th>PPN Input DPP</th><td class="text-end"><span t-field="o.input_base"/></td></tr>
                            <tr><th>PPN Input</th><td class="text-end"><span t-field="o.input_tax"/></td></tr>
                            <tr><th>Net PPN</th><td class="text-end"><span t-field="o.net_ppn"/></td></tr>
                        </table>
                    </div>
                </div>

                <div t-if="o.note" class="mt-3">
                    <strong>Notes</strong>
                    <p t-field="o.note"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_ppn_tax">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="clinic_l10n_id.report_ppn_tax_document"/>
            </t>
        </t>
    </template>
</odoo>

