<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_marketing" model="ir.module.category">
        <field name="name">ClinicOne Marketing</field>
        <field name="sequence">69</field>
    </record>

    <record id="privilege_marketing" model="res.groups.privilege">
        <field name="name">ClinicOne Marketing</field>
        <field name="category_id" ref="clinic_marketing.module_category_marketing"/>
        <field name="sequence">69</field>
    </record>

    <record id="group_marketing_user" model="res.groups">
        <field name="name">Marketing User</field>
        <field name="privilege_id" ref="clinic_marketing.privilege_marketing"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_marketing_coordinator" model="res.groups">
        <field name="name">Marketing Coordinator</field>
        <field name="privilege_id" ref="clinic_marketing.privilege_marketing"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_marketing.group_marketing_user')),
            Command.link(ref('mass_mailing.group_mass_mailing_user'))
        ]"/>
    </record>

    <record id="group_marketing_manager" model="res.groups">
        <field name="name">Marketing Manager</field>
        <field name="privilege_id" ref="clinic_marketing.privilege_marketing"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_marketing.group_marketing_coordinator')),
            Command.link(ref('mass_mailing.group_mass_mailing_campaign'))
        ]"/>
    </record>

    <record id="rule_marketing_preference_company" model="ir.rule">
        <field name="name">Marketing Preference: allowed companies</field>
        <field name="model_id" ref="model_clinic_marketing_preference"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_marketing.group_marketing_user'))]"/>
    </record>

    <record id="rule_marketing_segment_company" model="ir.rule">
        <field name="name">Marketing Segment: allowed companies</field>
        <field name="model_id" ref="model_clinic_marketing_segment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_marketing.group_marketing_user'))]"/>
    </record>

    <record id="rule_marketing_promotion_company" model="ir.rule">
        <field name="name">Marketing Promotion: allowed companies</field>
        <field name="model_id" ref="model_clinic_marketing_promotion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_marketing.group_marketing_user'))]"/>
    </record>

    <record id="rule_marketing_campaign_company" model="ir.rule">
        <field name="name">Marketing Campaign: allowed companies</field>
        <field name="model_id" ref="model_clinic_marketing_campaign"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_marketing.group_marketing_user'))]"/>
    </record>

    <record id="rule_marketing_recipient_company" model="ir.rule">
        <field name="name">Marketing Recipient: allowed companies</field>
        <field name="model_id" ref="model_clinic_marketing_recipient"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_marketing.group_marketing_user'))]"/>
    </record>

    <record id="rule_marketing_message_company" model="ir.rule">
        <field name="name">Marketing WhatsApp Message: allowed companies</field>
        <field name="model_id" ref="model_clinic_marketing_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_marketing.group_marketing_user'))]"/>
    </record>
</odoo>

