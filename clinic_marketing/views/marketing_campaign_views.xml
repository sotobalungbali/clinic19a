<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_campaign_search" model="ir.ui.view">
        <field name="name">clinic.marketing.campaign.search</field>
        <field name="model">clinic.marketing.campaign</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="segment_id"/>
                <field name="promotion_id"/>
                <field name="owner_id"/>
                <field name="company_id"/>
                <field name="branch_id"/>
                <filter name="running" string="Running" domain="[('state','=','running')]"/>
                <filter name="ready" string="Ready" domain="[('state','=','ready')]"/>
                <filter name="completed" string="Completed" domain="[('state','=','completed')]"/>
                <filter name="email" string="Email" domain="[('send_email','=',True)]"/>
                <filter name="whatsapp" string="WhatsApp" domain="[('send_whatsapp','=',True)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by':'owner_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/>
                    <filter name="group_segment" string="Segment" context="{'group_by':'segment_id'}"/>
                    <filter name="group_month" string="Planned Month" context="{'group_by':'planned_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_marketing_campaign_list" model="ir.ui.view">
        <field name="name">clinic.marketing.campaign.list</field>
        <field name="model">clinic.marketing.campaign</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'completed'"
                  decoration-info="state == 'running'"
                  decoration-warning="state == 'ready'"
                  decoration-muted="state == 'cancelled'">
                <field name="planned_at"/>
                <field name="code"/>
                <field name="name"/>
                <field name="segment_id"/>
                <field name="promotion_id"/>
                <field name="branch_id"/>
                <field name="send_email"/>
                <field name="send_whatsapp"/>
                <field name="included_count"/>
                <field name="email_recipient_count"/>
                <field name="whatsapp_recipient_count"/>
                <field name="state" widget="badge"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_open_recipients" type="object" string="Audience" icon="fa-users"/>
                <button name="action_sync_delivery" type="object" string="Sync" icon="fa-refresh"
                        groups="clinic_marketing.group_marketing_coordinator"
                        invisible="state not in ('running','completed')"/>
            </list>
        </field>
    </record>

    <record id="view_marketing_campaign_kanban" model="ir.ui.view">
        <field name="name">clinic.marketing.campaign.kanban</field>
        <field name="model">clinic.marketing.campaign</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="code"/>
                <field name="planned_at"/>
                <field name="segment_id"/>
                <field name="included_count"/>
                <field name="email_recipient_count"/>
                <field name="whatsapp_recipient_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <strong><field name="name"/></strong>
                                    <div class="text-muted"><field name="code"/></div>
                                </div>
                                <field name="state" widget="badge"/>
                            </div>
                            <div class="mt-2"><field name="segment_id"/></div>
                            <div class="small text-muted"><field name="planned_at"/></div>
                            <div class="d-flex gap-2 flex-wrap mt-3">
                                <span class="badge text-bg-secondary">Audience <field name="included_count"/></span>
                                <span class="badge text-bg-primary">Email <field name="email_recipient_count"/></span>
                                <span class="badge text-bg-success">WhatsApp <field name="whatsapp_recipient_count"/></span>
                            </div>
                            <div class="mt-3 d-flex gap-2">
                                <button name="action_open_recipients" type="object" class="btn btn-secondary btn-sm">Audience</button>
                                <button name="action_sync_delivery" type="object" class="btn btn-secondary btn-sm"
                                        groups="clinic_marketing.group_marketing_coordinator"
                                        invisible="state not in ('running','completed')">Sync</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_marketing_campaign_form" model="ir.ui.view">
        <field name="name">clinic.marketing.campaign.form</field>
        <field name="model">clinic.marketing.campaign</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prepare_audience" type="object" string="Prepare Audience" class="btn-primary"
                            groups="clinic_marketing.group_marketing_coordinator"
                            invisible="state not in ('draft','planning')"/>
                    <button name="action_mark_ready" type="object" string="Mark Ready" class="btn-primary"
                            groups="clinic_marketing.group_marketing_coordinator"
                            invisible="state != 'planning'"/>
                    <button name="action_launch" type="object" string="Launch Campaign" class="btn-primary"
                            groups="clinic_marketing.group_marketing_manager"
                            invisible="state != 'ready'"/>
                    <button name="action_sync_delivery" type="object" string="Sync Delivery"
                            groups="clinic_marketing.group_marketing_coordinator"
                            invisible="state not in ('running','completed')"/>
                    <button name="action_complete" type="object" string="Complete"
                            groups="clinic_marketing.group_marketing_manager"
                            invisible="state != 'running'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="clinic_marketing.group_marketing_manager"
                            invisible="state in ('completed','cancelled')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            groups="clinic_marketing.group_marketing_manager"
                            invisible="state not in ('cancelled','completed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planning,ready,running,completed,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_recipients" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="included_count" widget="statinfo" string="Included"/>
                        </button>
                        <button name="action_open_email_mailing" type="object" class="oe_stat_button" icon="fa-envelope"
                                invisible="not email_mailing_id">
                            <field name="email_sent_count" widget="statinfo" string="Email Sent"/>
                        </button>
                        <button name="action_open_whatsapp_messages" type="object" class="oe_stat_button" icon="fa-comments"
                                invisible="not send_whatsapp">
                            <field name="whatsapp_sent_count" widget="statinfo" string="WhatsApp Sent"/>
                        </button>
                        <button name="action_open_segment" type="object" class="oe_stat_button" icon="fa-filter">
                            <div class="o_stat_info"><span class="o_stat_text">Segment</span></div>
                        </button>
                        <button name="action_open_promotion" type="object" class="oe_stat_button" icon="fa-gift"
                                invisible="not promotion_id">
                            <div class="o_stat_info"><span class="o_stat_text">Promotion</span></div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <div><field name="code" class="oe_inline"/></div>
                    </div>

                    <div class="alert alert-info" role="alert">
                        Email delivery and tracking are delegated to Odoo Email Marketing.
                        ClinicOne controls patient segmentation, branch scope, consent, promotion provenance, and WhatsApp evidence.
                    </div>

                    <group>
                        <group string="Campaign Scope">
                            <field name="company_id" groups="base.group_multi_company" readonly="state in ('ready','running','completed')"/>
                            <field name="branch_id" readonly="state in ('ready','running','completed')"/>
                            <field name="owner_id"/>
                            <field name="segment_id" readonly="state in ('ready','running','completed')"/>
                            <field name="promotion_id" readonly="state in ('ready','running','completed')"/>
                            <field name="planned_at"/>
                            <field name="launched_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                        </group>
                        <group string="Audience">
                            <field name="recipient_count" readonly="1"/>
                            <field name="included_count" readonly="1"/>
                            <field name="excluded_count" readonly="1"/>
                            <field name="email_recipient_count" readonly="1"/>
                            <field name="whatsapp_recipient_count" readonly="1"/>
                            <field name="whatsapp_transport" readonly="1"/>
                        </group>
                    </group>

                    <div class="d-flex gap-2 my-3">
                        <button name="action_prepare_audience" type="object" string="Rebuild Audience Snapshot" class="btn btn-primary"
                                groups="clinic_marketing.group_marketing_coordinator"
                                invisible="state not in ('draft','planning')"/>
                        <button name="action_open_recipients" type="object" string="Analyze Audience" class="btn btn-secondary"/>
                        <button name="action_open_email_mailing" type="object" string="Open Odoo Email Mailing" class="btn btn-secondary"
                                invisible="not email_mailing_id"/>
                        <button name="action_open_whatsapp_messages" type="object" string="Open WhatsApp Queue" class="btn btn-secondary"
                                invisible="not send_whatsapp"/>
                    </div>

                    <notebook>
                        <page string="Channels">
                            <group>
                                <group string="Email">
                                    <field name="send_email" readonly="state in ('ready','running','completed')"/>
                                    <field name="email_subject" invisible="not send_email" readonly="state in ('ready','running','completed')"/>
                                    <field name="email_preview" invisible="not send_email"/>
                                    <field name="email_from" invisible="not send_email"/>
                                    <field name="email_mailing_id" readonly="1" invisible="not send_email"/>
                                    <field name="utm_campaign_id" readonly="1" invisible="not send_email"/>
                                </group>
                                <group string="Email Performance" invisible="not email_mailing_id">
                                    <field name="email_sent_count" readonly="1"/>
                                    <field name="email_opened_ratio" widget="percentage" readonly="1"/>
                                    <field name="email_clicked_ratio" widget="percentage" readonly="1"/>
                                    <field name="email_bounced_ratio" widget="percentage" readonly="1"/>
                                    <field name="email_replied_ratio" widget="percentage" readonly="1"/>
                                </group>
                            </group>
                            <field name="email_body_html" invisible="not send_email" readonly="state in ('ready','running','completed')"/>
                            <group string="WhatsApp">
                                <field name="send_whatsapp" readonly="state in ('ready','running','completed')"/>
                                <field name="whatsapp_body" invisible="not send_whatsapp" readonly="state in ('ready','running','completed')"/>
                                <field name="whatsapp_queued_count" readonly="1" invisible="not send_whatsapp"/>
                                <field name="whatsapp_sent_count" readonly="1" invisible="not send_whatsapp"/>
                                <field name="whatsapp_failed_count" readonly="1" invisible="not send_whatsapp"/>
                            </group>
                        </page>

                        <page string="Audience Snapshot">
                            <field name="recipient_ids" context="{'default_campaign_id': id}">
                                <list create="0" edit="0" delete="0"
                                      decoration-success="inclusion_state == 'included'"
                                      decoration-muted="inclusion_state == 'excluded'">
                                    <field name="patient_id"/>
                                    <field name="partner_id"/>
                                    <field name="inclusion_state" widget="badge"/>
                                    <field name="email_allowed"/>
                                    <field name="email_delivery_state" widget="badge"/>
                                    <field name="whatsapp_allowed"/>
                                    <field name="whatsapp_state" widget="badge"/>
                                    <field name="exclusion_reason"/>
                                    <button name="action_open_patient" type="object" string="Patient" icon="fa-user-md"/>
                                    <button name="action_open_preference" type="object" string="Consent" icon="fa-check-circle"
                                            invisible="not preference_id"/>
                                    <button name="action_open_whatsapp_messages" type="object" string="WhatsApp" icon="fa-comments"
                                            invisible="not whatsapp_allowed"/>
                                </list>
                            </field>
                        </page>

                        <page string="Objective &amp; Governance">
                            <field name="objective"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_marketing_campaign" model="ir.actions.act_window">
        <field name="name">Marketing Campaigns</field>
        <field name="res_model">clinic.marketing.campaign</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_marketing_campaign_search"/>
    </record>
</odoo>

