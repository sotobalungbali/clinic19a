<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_message_search" model="ir.ui.view">
        <field name="name">clinic.marketing.message.search</field>
        <field name="model">clinic.marketing.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="campaign_id"/>
                <field name="patient_id"/>
                <field name="partner_id"/>
                <field name="destination"/>
                <field name="company_id"/>
                <filter name="queued" string="Queued" domain="[('state','=','queued')]"/>
                <filter name="opened" string="Opened" domain="[('state','=','opened')]"/>
                <filter name="sent" string="Sent" domain="[('state','=','sent')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <group>
                    <filter name="group_campaign" string="Campaign" context="{'group_by':'campaign_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_marketing_message_list" model="ir.ui.view">
        <field name="name">clinic.marketing.message.list</field>
        <field name="model">clinic.marketing.message</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-success="state == 'sent'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'cancelled'">
                <field name="scheduled_at"/>
                <field name="campaign_id"/>
                <field name="patient_id"/>
                <field name="destination"/>
                <field name="state" widget="badge"/>
                <field name="opened_at"/>
                <field name="sent_at"/>
                <field name="provider_reference"/>
                <button name="action_open_whatsapp" type="object" string="Open WhatsApp" icon="fa-comments"
                        groups="clinic_marketing.group_marketing_coordinator"
                        invisible="state not in ('queued','opened')"/>
                <button name="action_mark_sent" type="object" string="Mark Sent" icon="fa-check"
                        groups="clinic_marketing.group_marketing_coordinator"
                        invisible="state not in ('queued','opened')"/>
                <button name="action_open_patient" type="object" string="Patient" icon="fa-user-md"/>
            </list>
        </field>
    </record>

    <record id="view_marketing_message_form" model="ir.ui.view">
        <field name="name">clinic.marketing.message.form</field>
        <field name="model">clinic.marketing.message</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_whatsapp" type="object" string="Open WhatsApp" class="btn-primary"
                            groups="clinic_marketing.group_marketing_coordinator"
                            invisible="state not in ('queued','opened')"/>
                    <button name="action_dispatch_gateway" type="object" string="Dispatch via Provider Hook"
                            groups="clinic_marketing.group_marketing_manager"
                            invisible="state not in ('queued','opened')"/>
                    <button name="action_mark_sent" type="object" string="Mark Sent"
                            groups="clinic_marketing.group_marketing_coordinator"
                            invisible="state not in ('queued','opened')"/>
                    <button name="action_mark_failed" type="object" string="Mark Failed"
                            groups="clinic_marketing.group_marketing_coordinator"
                            invisible="state not in ('queued','opened')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            groups="clinic_marketing.group_marketing_coordinator"
                            invisible="state not in ('queued','opened')"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,opened,sent,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_patient" type="object" class="oe_stat_button" icon="fa-user-md">
                            <div class="o_stat_info"><span class="o_stat_text">Patient</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="partner_id"/></h1>
                        <div class="text-muted"><field name="destination"/></div>
                    </div>
                    <div class="alert alert-info" role="alert">
                        Base Clinic Marketing owns WhatsApp communication intent and evidence.
                        Automated gateway transport is provider-neutral and may be supplied later by clinic_integration_api.
                    </div>
                    <group>
                        <group string="Campaign">
                            <field name="campaign_id"/>
                            <field name="recipient_id"/>
                            <field name="patient_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="scheduled_at"/>
                        </group>
                        <group string="Delivery Evidence">
                            <field name="opened_at"/>
                            <field name="sent_at"/>
                            <field name="provider_reference"/>
                            <field name="failure_reason"/>
                            <field name="whatsapp_url" invisible="1"/>
                        </group>
                    </group>
                    <field name="body" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_marketing_message" model="ir.actions.act_window">
        <field name="name">WhatsApp Queue</field>
        <field name="res_model">clinic.marketing.message</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_marketing_message_search"/>
    </record>
</odoo>

