<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketing_segment_search" model="ir.ui.view">
        <field name="name">clinic.marketing.segment.search</field>
        <field name="model">clinic.marketing.segment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="branch_id"/>
                <field name="patient_stage_ids"/>
                <field name="patient_tag_ids"/>
                <filter name="active_state" string="Active" domain="[('state','=','active')]"/>
                <filter name="membership_active" string="Active Membership" domain="[('membership_filter','=','active')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/>
                    <filter name="group_gender" string="Gender" context="{'group_by':'gender'}"/>
                    <filter name="group_channel" string="Required Channel" context="{'group_by':'required_channel'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_marketing_segment_list" model="ir.ui.view">
        <field name="name">clinic.marketing.segment.list</field>
        <field name="model">clinic.marketing.segment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state == 'archived'">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="gender"/>
                <field name="membership_filter"/>
                <field name="required_channel"/>
                <field name="estimated_count"/>
                <field name="campaign_count"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_preview_patients" type="object" string="Preview" icon="fa-users"/>
                <button name="action_open_campaigns" type="object" string="Campaigns" icon="fa-bullhorn"/>
            </list>
        </field>
    </record>

    <record id="view_marketing_segment_form" model="ir.ui.view">
        <field name="name">clinic.marketing.segment.form</field>
        <field name="model">clinic.marketing.segment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary"
                            groups="clinic_marketing.group_marketing_coordinator"
                            invisible="state != 'draft'"/>
                    <button name="action_archive" type="object" string="Archive"
                            groups="clinic_marketing.group_marketing_manager"
                            invisible="state != 'active'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            groups="clinic_marketing.group_marketing_manager"
                            invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_preview_patients" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="estimated_count" widget="statinfo" string="Patients"/>
                        </button>
                        <button name="action_open_campaigns" type="object" class="oe_stat_button" icon="fa-bullhorn">
                            <field name="campaign_count" widget="statinfo" string="Campaigns"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <div><field name="code" class="oe_inline"/></div>
                    </div>

                    <group>
                        <group string="Scope">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="required_channel"/>
                        </group>
                        <group string="Demographic Criteria">
                            <field name="gender"/>
                            <field name="min_age"/>
                            <field name="max_age"/>
                            <field name="patient_stage_ids" widget="many2many_tags"/>
                            <field name="patient_tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <group>
                        <group string="Membership">
                            <field name="membership_filter"/>
                            <field name="membership_plan_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Behavior / Experience">
                            <field name="completed_booking_within_days"/>
                            <field name="no_completed_booking_for_days"/>
                            <field name="feedback_filter"/>
                        </group>
                    </group>

                    <div class="d-flex gap-2 my-3">
                        <button name="action_preview_patients" type="object" string="Preview Matching Patients" class="btn btn-primary"/>
                        <button name="action_open_campaigns" type="object" string="Open Campaigns" class="btn btn-secondary"/>
                    </div>

                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_marketing_segment" model="ir.actions.act_window">
        <field name="name">Patient Segments</field>
        <field name="res_model">clinic.marketing.segment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_marketing_segment_search"/>
    </record>
</odoo>

