<?xml version='1.0' encoding='UTF-8'?>
<odoo noupdate="1">
  <record id="seq_membership_plan" model="ir.sequence">
    <field name="name">Membership Plan</field>
    <field name="code">membership.plan</field>
    <field name="prefix">MPL/%(year)s/</field>
    <field name="padding">5</field>
    <field name="company_id" eval="False"/>
  </record>
  <record id="seq_membership_contract" model="ir.sequence">
    <field name="name">Membership Contract</field>
    <field name="code">membership.contract</field>
    <field name="prefix">MEM/%(year)s/</field>
    <field name="padding">6</field>
    <field name="company_id" eval="False"/>
  </record>
  <record id="seq_membership_usage" model="ir.sequence">
    <field name="name">Membership Usage</field>
    <field name="code">membership.usage</field>
    <field name="prefix">MUS/%(year)s/</field>
    <field name="padding">6</field>
    <field name="company_id" eval="False"/>
  </record>
  <record id="seq_membership_voucher" model="ir.sequence">
    <field name="name">Membership Voucher</field>
    <field name="code">membership.voucher</field>
    <field name="prefix">MV/%(year)s/</field>
    <field name="padding">6</field>
    <field name="company_id" eval="False"/>
  </record>
  <record id="seq_membership_point" model="ir.sequence">
    <field name="name">Membership Points</field>
    <field name="code">membership.point.tx</field>
    <field name="prefix">MPT/%(year)s/</field>
    <field name="padding">7</field>
    <field name="company_id" eval="False"/>
  </record>
  <record id="seq_membership_hold" model="ir.sequence">
    <field name="name">Membership Hold</field>
    <field name="code">membership.hold</field>
    <field name="prefix">MHD/%(year)s/</field>
    <field name="padding">6</field>
    <field name="company_id" eval="False"/>
  </record>
</odoo>

