<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <!--
        Odoo 19 security hierarchy:
        ir.module.category -> res.groups.privilege -> res.groups.

        `res.groups.category_id` was removed in Odoo 19.  Do not move the
        category back onto the group records; the privilege owns the category.
    -->
  <record id="module_category_clinic_membership" model="ir.module.category">
    <field name="name">ClinicOne Membership</field>
    <field name="sequence">44</field>
  </record>
  <record id="privilege_clinic_membership" model="res.groups.privilege">
    <field name="name">ClinicOne Membership</field>
    <field name="category_id" ref="clinic_membership.module_category_clinic_membership"/>
    <field name="sequence">44</field>
  </record>
  <record id="group_clinic_membership_user" model="res.groups">
    <field name="name">Membership User</field>
    <field name="privilege_id" ref="clinic_membership.privilege_clinic_membership"/>
    <field name="sequence">10</field>
    <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
  </record>
  <record id="group_clinic_membership_manager" model="res.groups">
    <field name="name">Membership Manager</field>
    <field name="privilege_id" ref="clinic_membership.privilege_clinic_membership"/>
    <field name="sequence">20</field>
    <field name="implied_ids" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
  <!-- Multi-company record rules. UI visibility never replaces backend security. -->
  <record id="rule_membership_plan_company" model="ir.rule">
    <field name="name">Membership Plan: allowed companies</field>
    <field name="model_id" ref="model_membership_plan"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
  <record id="rule_membership_plan_benefit_company" model="ir.rule">
    <field name="name">Membership Plan Benefit: allowed companies</field>
    <field name="model_id" ref="model_membership_plan_benefit"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
  <record id="rule_membership_contract_company" model="ir.rule">
    <field name="name">Membership Contract: allowed companies</field>
    <field name="model_id" ref="model_membership_contract"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
  <record id="rule_membership_contract_benefit_company" model="ir.rule">
    <field name="name">Membership Contract Benefit: allowed companies</field>
    <field name="model_id" ref="model_membership_contract_benefit"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
  <record id="rule_membership_usage_company" model="ir.rule">
    <field name="name">Membership Usage: allowed companies</field>
    <field name="model_id" ref="model_membership_usage"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
  <record id="rule_membership_voucher_company" model="ir.rule">
    <field name="name">Membership Voucher: allowed companies</field>
    <field name="model_id" ref="model_membership_voucher"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
  <record id="rule_membership_point_tx_company" model="ir.rule">
    <field name="name">Membership Point Transaction: allowed companies</field>
    <field name="model_id" ref="model_membership_point_tx"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
  <record id="rule_membership_hold_company" model="ir.rule">
    <field name="name">Membership Hold: allowed companies</field>
    <field name="model_id" ref="model_membership_hold"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
  <record id="rule_membership_integration_event_company" model="ir.rule">
    <field name="name">Membership Integration Event: allowed companies</field>
    <field name="model_id" ref="model_membership_integration_event"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[Command.link(ref('clinic_membership.group_clinic_membership_user'))]"/>
  </record>
</odoo>


