<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_membership_hold_search" model="ir.ui.view">
    <field name="name">membership.hold.search</field>
    <field name="model">membership.hold</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="contract_id"/>
        <field name="partner_id"/>
        <filter string="Pending Approval" name="pending" domain="[('state','=','submitted')]"/>
        <filter string="Applied" name="applied" domain="[('state','=','applied')]"/>
        <group>
          <filter string="State" context="{'group_by':'state'}" name="group_state"/>
          <filter string="Plan" context="{'group_by':'plan_id'}" name="group_plan_id"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_membership_hold_list" model="ir.ui.view">
    <field name="name">membership.hold.list</field>
    <field name="model">membership.hold</field>
    <field name="arch" type="xml">
      <list decoration-warning="state == 'submitted'" decoration-success="state == 'applied'" decoration-muted="state in ('cancelled','reverted','rejected')">
        <field name="name"/>
        <field name="contract_id"/>
        <field name="partner_id"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="days"/>
        <field name="state" widget="badge"/>
        <field name="requested_by"/>
      </list>
    </field>
  </record>
  <record id="view_membership_hold_form" model="ir.ui.view">
    <field name="name">membership.hold.form</field>
    <field name="model">membership.hold</field>
    <field name="arch" type="xml">
      <form string="Membership Hold">
        <header>
          <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'" groups="clinic_membership.group_clinic_membership_manager"/>
          <button name="action_apply" type="object" string="Apply Hold" invisible="state != 'approved'"/>
          <button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'" groups="clinic_membership.group_clinic_membership_manager"/>
          <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','submitted','approved')"/>
          <button name="action_revert" type="object" string="Revert" invisible="state != 'applied'" groups="clinic_membership.group_clinic_membership_manager"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,applied,rejected,cancelled,reverted"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_contract" type="object" class="oe_stat_button" icon="fa-id-card">
              <div class="o_stat_info">
                <span class="o_stat_text">Contract</span>
              </div>
            </button>
          </div>
          <div class="oe_title">
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="contract_id"/>
              <field name="partner_id" readonly="1"/>
              <field name="plan_id" readonly="1"/>
              <field name="date_from"/>
              <field name="date_to"/>
              <field name="days" readonly="1"/>
              <field name="reason"/>
            </group>
            <group string="Policy Snapshot">
              <field name="policy_allow_hold" readonly="1"/>
              <field name="policy_max_days" readonly="1"/>
              <field name="contract_state_saved" readonly="1"/>
              <field name="contract_end_before" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Approval Audit">
              <group>
                <field name="requested_by"/>
                <field name="submitted_by"/>
                <field name="approved_by"/>
                <field name="rejected_by"/>
                <field name="cancelled_by"/>
                <field name="reverted_by"/>
              </group>
            </page>
            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_membership_holds" model="ir.actions.act_window">
    <field name="name">Membership Holds</field>
    <field name="res_model">membership.hold</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
</odoo>


