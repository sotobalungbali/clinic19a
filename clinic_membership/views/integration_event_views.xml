<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_membership_event_search" model="ir.ui.view">
    <field name="name">membership.integration.event.search</field>
    <field name="model">membership.integration.event</field>
    <field name="arch" type="xml">
      <search>
        <field name="event_code"/>
        <field name="contract_id"/>
        <field name="source_model"/>
        <field name="source_reference"/>
        <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
        <filter string="Failed" name="failed" domain="[('state','=','failed')]"/>
        <group>
          <filter string="Event" context="{'group_by':'event_code'}" name="group_event_code"/>
          <filter string="State" context="{'group_by':'state'}" name="group_state"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_membership_event_list" model="ir.ui.view">
    <field name="name">membership.integration.event.list</field>
    <field name="model">membership.integration.event</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'processed'" decoration-danger="state == 'failed'" decoration-muted="state == 'ignored'">
        <field name="name"/>
        <field name="event_code"/>
        <field name="contract_id"/>
        <field name="source_model"/>
        <field name="source_reference"/>
        <field name="attempts"/>
        <field name="state" widget="badge"/>
        <field name="last_attempt_on"/>
      </list>
    </field>
  </record>
  <record id="view_membership_event_form" model="ir.ui.view">
    <field name="name">membership.integration.event.form</field>
    <field name="model">membership.integration.event</field>
    <field name="arch" type="xml">
      <form string="Membership Integration Event">
        <header>
          <button name="action_process" type="object" string="Process" class="btn-primary" invisible="state not in ('pending','failed')"/>
          <button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/>
          <button name="action_ignore" type="object" string="Ignore" invisible="state in ('processed','ignored')"/>
          <button name="action_view_source" type="object" string="Open Source"/>
          <field name="state" widget="statusbar" statusbar_visible="pending,processed,failed,ignored"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="event_code"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="name"/>
              <field name="contract_id"/>
              <field name="source_model"/>
              <field name="source_res_id"/>
              <field name="source_reference"/>
            </group>
            <group>
              <field name="attempts"/>
              <field name="last_attempt_on"/>
              <field name="processed_on"/>
            </group>
          </group>
          <notebook>
            <page string="Payload">
              <field name="payload_json" widget="text"/>
            </page>
            <page string="Last Error">
              <field name="last_error"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_membership_events" model="ir.actions.act_window">
    <field name="name">Membership Integration Events</field>
    <field name="res_model">membership.integration.event</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
</odoo>

