<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_membership_point_tx_search" model="ir.ui.view">
    <field name="name">membership.point.tx.search</field>
    <field name="model">membership.point.tx</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="contract_id"/>
        <field name="partner_id"/>
        <field name="tx_type"/>
        <filter string="Validated" name="validated" domain="[('state','=','validated')]"/>
        <group>
          <filter string="Type" context="{'group_by':'tx_type'}" name="group_tx_type"/>
          <filter string="Contract" context="{'group_by':'contract_id'}" name="group_contract_id"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_membership_point_tx_list" model="ir.ui.view">
    <field name="name">membership.point.tx.list</field>
    <field name="model">membership.point.tx</field>
    <field name="arch" type="xml">
      <list decoration-success="points &gt; 0 and state == 'validated'" decoration-danger="points &lt; 0 and state == 'validated'" decoration-muted="state == 'cancelled'">
        <field name="name"/>
        <field name="date"/>
        <field name="partner_id"/>
        <field name="contract_id"/>
        <field name="tx_type" widget="badge"/>
        <field name="points" sum="Net Points"/>
        <field name="running_balance"/>
        <field name="expiry_date"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>
  <record id="view_membership_point_tx_form" model="ir.ui.view">
    <field name="name">membership.point.tx.form</field>
    <field name="model">membership.point.tx</field>
    <field name="arch" type="xml">
      <form string="Loyalty Point Transaction">
        <header>
          <button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_cancel" type="object" string="Cancel" invisible="state != 'validated'"/>
          <button name="action_reverse" type="object" string="Reverse" invisible="state != 'validated' or reversed_of_id"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,validated,cancelled"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_contract" type="object" class="oe_stat_button" icon="fa-id-card">
              <div class="o_stat_info">
                <span class="o_stat_text">Contract</span>
              </div>
            </button>
          </div>
          <div class="oe_title">
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="contract_id"/>
              <field name="partner_id" readonly="1"/>
              <field name="tx_type"/>
              <field name="date"/>
              <field name="points"/>
              <field name="running_balance" readonly="1"/>
              <field name="money_value"/>
              <field name="expiry_date"/>
            </group>
            <group>
              <field name="validated_by" readonly="1"/>
              <field name="validated_on" readonly="1"/>
              <field name="reversed_of_id" readonly="1"/>
              <field name="expired_source_id" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Source">
              <group>
                <field name="usage_id"/>
                <field name="booking_id"/>
                <field name="encounter_id"/>
                <field name="treatment_session_id"/>
                <field name="package_usage_id"/>
                <field name="emar_administration_id"/>
                <field name="sale_order_id"/>
                <field name="move_id"/>
              </group>
            </page>
            <page string="Notes">
              <field name="note"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_membership_points" model="ir.actions.act_window">
    <field name="name">Loyalty Point Ledger</field>
    <field name="res_model">membership.point.tx</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
</odoo>


