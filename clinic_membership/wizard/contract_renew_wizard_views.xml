<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_membership_contract_renew_wizard" model="ir.ui.view">
    <field name="name">membership.contract.renew.wizard.form</field>
    <field name="model">membership.contract.renew.wizard</field>
    <field name="arch" type="xml">
      <form string="Renew Membership">
        <sheet>
          <group>
            <field name="contract_id"/>
            <field name="company_id" invisible="1"/>
            <field name="renewal_plan_id"/>
            <field name="start_date"/>
            <field name="auto_create_invoice"/>
            <field name="notes"/>
          </group>
        </sheet>
        <footer>
          <button name="action_renew" type="object" string="Renew Membership" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>


