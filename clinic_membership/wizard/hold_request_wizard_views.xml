<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_membership_hold_request_wizard" model="ir.ui.view">
    <field name="name">membership.hold.request.wizard.form</field>
    <field name="model">membership.hold.request.wizard</field>
    <field name="arch" type="xml">
      <form string="Request Membership Hold">
        <sheet>
          <group>
            <field name="contract_id"/>
            <field name="date_from"/>
            <field name="date_to"/>
            <field name="reason"/>
          </group>
        </sheet>
        <footer>
          <button name="action_create_request" type="object" string="Submit Hold Request" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>


