<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="view_membership_point_adjust_wizard" model="ir.ui.view">
    <field name="name">membership.point.adjust.wizard.form</field>
    <field name="model">membership.point.adjust.wizard</field>
    <field name="arch" type="xml">
      <form string="Adjust Loyalty Points">
        <sheet>
          <group>
            <field name="contract_id"/>
            <field name="points"/>
            <field name="reason"/>
          </group>
        </sheet>
        <footer>
          <button name="action_adjust" type="object" string="Apply Adjustment" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>

