        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_voucher_company" model="ir.rule">
        <field name="name">Package Vouchers: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_voucher"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_voucher_batch_company" model="ir.rule">
        <field name="name">Voucher Batches: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_voucher_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_event_company" model="ir.rule">
        <field name="name">Package Integration Events: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_integration_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_package.group_clinic_package_manager'))]"/>
    </record>
</odoo>
