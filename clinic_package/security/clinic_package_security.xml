<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_clinic_package_user" model="res.groups">
        <field name="name">Clinic Package User</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_clinic_package_manager" model="res.groups">
        <field name="name">Clinic Package Manager</field>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('clinic_package.group_clinic_package_user'))
        ]"/>
    </record>

    <!-- Multi-company protection: UI visibility never substitutes for record rules. -->
    <record id="rule_package_tag_company" model="ir.rule">
        <field name="name">Package Tags: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_tag"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_company" model="ir.rule">
        <field name="name">Treatment Packages: allowed companies</field>
        <field name="model_id" ref="model_clinic_package"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_line_company" model="ir.rule">
        <field name="name">Package Components: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_pricing_company" model="ir.rule">
        <field name="name">Package Pricing: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_pricing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
