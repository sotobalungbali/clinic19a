        <field name="model_id" ref="model_clinic_package_pricing_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_policy_company" model="ir.rule">
        <field name="name">Package Policies: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_benefit_company" model="ir.rule">
        <field name="name">Package Benefits: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_benefit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_allocation_company" model="ir.rule">
        <field name="name">Package Allocations: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_allocation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="rule_package_allocation_line_company" model="ir.rule">
        <field name="name">Allocation Benefits: allowed companies</field>
        <field name="model_id" ref="model_clinic_package_allocation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
