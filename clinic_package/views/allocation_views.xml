<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_package_allocation_search" model="ir.ui.view"><field name="name">clinic.package.allocation.search</field><field name="model">clinic.package.allocation</field><field name="arch" type="xml"><search string="Search Package Allocations"><field name="name"/><field name="patient_id"/><field name="partner_id"/><field name="package_id"/><field name="doctor_id"/><field name="branch_id"/><filter name="active" string="Active" domain="[('state','=','active')]"/><filter name="paused" string="Paused" domain="[('state','=','paused')]"/><filter name="expired" string="Expired" domain="[('is_expired','=',True)]"/><separator/><filter name="group_package" string="Package" context="{'group_by':'package_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/></search></field></record>
    <record id="view_clinic_package_allocation_list" model="ir.ui.view"><field name="name">clinic.package.allocation.list</field><field name="model">clinic.package.allocation</field><field name="arch" type="xml"><list decoration-success="state == 'active'" decoration-warning="state == 'paused'" decoration-danger="is_expired" decoration-muted="state in ('closed','cancelled','refunded')"><field name="name"/><field name="patient_id"/><field name="package_id"/><field name="doctor_id" optional="show"/><field name="start_date"/><field name="valid_to_effective"/><field name="remaining_percent" widget="progressbar"/><field name="remaining_value" sum="Remaining Value"/><field name="state" widget="badge"/><field name="branch_id" optional="hide"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
    <record id="view_clinic_package_allocation_form" model="ir.ui.view"><field name="name">clinic.package.allocation.form</field><field name="model">clinic.package.allocation</field><field name="arch" type="xml"><form string="Package Allocation">
        <header><button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/><button name="action_pause" type="object" string="Pause" invisible="state != 'active'"/><button name="action_resume" type="object" string="Resume" class="btn-primary" invisible="state != 'paused'"/><button name="action_close" type="object" string="Close" invisible="state not in ('active','paused','expired')"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','active','paused')"/><button name="action_mark_refunded" type="object" string="Mark Refunded" invisible="state not in ('active','paused','expired','closed')" groups="clinic_package.group_clinic_package_manager"/><button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'" groups="clinic_package.group_clinic_package_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,active,paused,expired,closed,cancelled,refunded"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button name="action_view_usages" type="object" class="oe_stat_button" icon="fa-history"><field name="usage_count" widget="statinfo" string="Redemptions"/></button><button name="action_view_emar_usages" type="object" class="oe_stat_button" icon="fa-medkit" invisible="not emar_usage_count"><field name="emar_usage_count" widget="statinfo" string="eMAR Linked"/></button><button name="action_view_care_plan" type="object" class="oe_stat_button" icon="fa-heartbeat" invisible="not care_plan_id"><div class="o_stat_info"><span class="o_stat_text">Care Plan</span></div></button></div>
        <widget name="web_ribbon" text="EXPIRED" bg_color="text-bg-danger" invisible="not is_expired"/>
        <div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1><div class="o_row"><field name="patient_id" class="oe_inline"/><span class="text-muted"> / </span><field name="package_id" class="oe_inline"/></div></div>
        <group><group string="Patient &amp; Ownership"><field name="patient_id"/><field name="partner_id"/><field name="doctor_id"/><field name="branch_id"/><field name="sold_by_user_id" readonly="1"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Commercial Snapshot"><field name="qty"/><field name="list_price_unit" readonly="1"/><field name="price_total" readonly="1"/><field name="discount_amount" readonly="1"/><field name="discount_pct" readonly="1"/><field name="remaining_value" readonly="1"/><field name="remaining_percent" widget="progressbar" readonly="1"/></group></group>
        <div class="oe_button_box" name="body_action_box"><button name="action_open_redeem_wizard" type="object" string="Redeem Benefit" icon="fa-check" class="btn btn-primary" invisible="state not in ('active','paused')"/><button name="action_open_transfer_wizard" type="object" string="Transfer Package" icon="fa-exchange" invisible="state not in ('active','paused')"/><button name="action_create_care_plan" type="object" string="Create Care Plan" icon="fa-heartbeat" invisible="care_plan_id or state == 'cancelled'"/></div>
        <notebook><page string="Benefit Balance"><field name="line_ids" readonly="state != 'draft'"><list decoration-danger="is_depleted"><field name="sequence" widget="handle"/><field name="line_type"/><field name="name"/><field name="treatment_id" optional="show"/><field name="product_id" optional="show"/><field name="qty_total"/><field name="qty_redeemed" readonly="1"/><field name="remaining_qty" readonly="1"/><field name="credit_amount_total"/><field name="remaining_credit" readonly="1"/><field name="usage_count"/><field name="is_depleted" widget="boolean_toggle" readonly="1"/><button name="action_redeem" type="object" string="Redeem" icon="fa-check"/><button name="action_create_booking" type="object" string="Schedule" icon="fa-calendar" invisible="line_type != 'treatment' or not treatment_id"/></list></field></page>
        <page string="Validity &amp; Pause"><group><field name="start_date"/><field name="valid_from"/><field name="valid_to"/><field name="valid_to_effective" readonly="1"/><field name="paused_since" readonly="1"/><field name="pause_days_accum" readonly="1"/><field name="pause_count" readonly="1"/><field name="last_resumed_on" readonly="1"/></group></page>
        <page string="Transfer &amp; Origin"><group><field name="transfer_count" readonly="1"/><field name="last_transfer_on" readonly="1"/><field name="transfer_fee_due" readonly="1"/><field name="care_plan_id"/><field name="booking_id"/><field name="source_voucher_id"/><field name="sale_order_id"/><field name="invoice_id"/></group></page>
        <page string="Notes"><field name="note"/><field name="internal_note" groups="clinic_package.group_clinic_package_manager"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_clinic_package_allocation" model="ir.actions.act_window"><field name="name">Patient Package Allocations</field><field name="res_model">clinic.package.allocation</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_package_allocation_search"/></record>
</odoo>
