<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_package_event_search" model="ir.ui.view"><field name="name">clinic.package.integration.event.search</field><field name="model">clinic.package.integration.event</field><field name="arch" type="xml"><search><field name="name"/><field name="event_code"/><field name="source_model"/><filter name="pending" string="Pending" domain="[('state','=','pending')]"/><filter name="failed" string="Failed" domain="[('state','=','failed')]"/><filter name="done" string="Done" domain="[('state','=','done')]"/><filter name="group_event" string="Event" context="{'group_by':'event_code'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
    <record id="view_clinic_package_event_list" model="ir.ui.view"><field name="name">clinic.package.integration.event.list</field><field name="model">clinic.package.integration.event</field><field name="arch" type="xml"><list decoration-warning="state == 'pending'" decoration-danger="state == 'failed'" decoration-success="state == 'done'"><field name="name"/><field name="event_code"/><field name="source_model"/><field name="source_res_id"/><field name="attempt_count"/><field name="max_attempts"/><field name="last_attempt_at"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_clinic_package_event_form" model="ir.ui.view"><field name="name">clinic.package.integration.event.form</field><field name="model">clinic.package.integration.event</field><field name="arch" type="xml"><form string="Package Integration Event"><header><button name="action_mark_processing" type="object" string="Start Processing" class="btn-primary" invisible="state not in ('pending','failed')"/><button name="action_mark_done" type="object" string="Mark Done" class="btn-primary" invisible="state not in ('pending','processing','failed')"/><button name="action_mark_failed" type="object" string="Mark Failed" invisible="state == 'cancelled'"/><button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/><button name="action_cancel" type="object" string="Cancel" invisible="state == 'done' or state == 'cancelled'"/><field name="state" widget="statusbar" statusbar_visible="pending,processing,done,failed,cancelled"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_source" type="object" class="oe_stat_button" icon="fa-external-link"><div class="o_stat_info"><span class="o_stat_text">Source Record</span></div></button></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1><div class="o_row"><field name="event_code"/><span class="text-muted"> — </span><field name="source_model"/><field name="source_res_id"/></div></div><group><group><field name="attempt_count" readonly="1"/><field name="max_attempts"/><field name="last_attempt_at" readonly="1"/><field name="processed_at" readonly="1"/></group><group><field name="company_id" groups="base.group_multi_company"/><field name="last_error" readonly="1"/></group></group><notebook><page string="Payload"><field name="payload_json" widget="text"/></page><page string="Notes"><field name="note"/></page></notebook></sheet></form></field></record>
    <record id="action_clinic_package_event" model="ir.actions.act_window"><field name="name">Integration Events</field><field name="res_model">clinic.package.integration.event</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_package_event_search"/></record>
</odoo>
