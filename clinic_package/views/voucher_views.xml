<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_package_voucher_search" model="ir.ui.view">
        <field name="name">clinic.package.voucher.search</field><field name="model">clinic.package.voucher</field>
        <field name="arch" type="xml"><search string="Search Package Vouchers">
            <field name="name"/><field name="code"/><field name="package_id"/><field name="patient_id"/><field name="partner_id"/><field name="batch_id"/>
            <filter name="issued" string="Issued" domain="[('state','=','issued')]"/><filter name="redeemed" string="Redeemed" domain="[('state','=','redeemed')]"/><filter name="expired" string="Expired" domain="[('state','=','expired')]"/>
            <separator/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_package" string="Package" context="{'group_by':'package_id'}"/><filter name="group_batch" string="Batch" context="{'group_by':'batch_id'}"/>
        </search></field>
    </record>
    <record id="view_clinic_package_voucher_list" model="ir.ui.view"><field name="name">clinic.package.voucher.list</field><field name="model">clinic.package.voucher</field><field name="arch" type="xml"><list decoration-success="state == 'issued'" decoration-info="state == 'redeemed'" decoration-danger="state == 'expired'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="code"/><field name="package_id"/><field name="patient_id" optional="show"/><field name="channel"/><field name="branch_id" optional="hide"/><field name="valid_to"/><field name="state" widget="badge"/><field name="batch_id" optional="hide"/><field name="company_id" groups="base.group_multi_company" optional="hide"/></list></field></record>
    <record id="view_clinic_package_voucher_form" model="ir.ui.view"><field name="name">clinic.package.voucher.form</field><field name="model">clinic.package.voucher</field><field name="arch" type="xml"><form string="Package Voucher"><header><button name="action_issue" type="object" string="Issue" class="btn-primary" invisible="state != 'draft'"/><button name="action_redeem" type="object" string="Redeem" class="btn-primary" invisible="state != 'issued' or not patient_id"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','issued')"/><field name="state" widget="statusbar" statusbar_visible="draft,issued,redeemed,expired,cancelled"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_allocation" type="object" class="oe_stat_button" icon="fa-id-card" invisible="not redeemed_allocation_id"><div class="o_stat_info"><span class="o_stat_text">Allocation</span></div></button></div><widget name="web_ribbon" text="BEARER" bg_color="text-bg-info" invisible="not is_bearer or state == 'redeemed'"/><div class="oe_title"><label for="code"/><h1><field name="code" readonly="1"/></h1><div class="o_row"><field name="name" readonly="1"/><span class="text-muted"> — </span><field name="package_id"/></div></div><group><group string="Recipient"><field name="patient_id"/><field name="partner_id"/><field name="is_bearer" readonly="1"/><field name="channel"/><field name="branch_id"/><field name="enforce_branch"/></group><group string="Validity"><field name="issue_date" readonly="1"/><field name="valid_from"/><field name="valid_to"/><field name="is_expired" readonly="1"/><field name="allow_redeem_when_package_paused" groups="clinic_package.group_clinic_package_manager"/><field name="company_id" groups="base.group_multi_company"/></group></group><notebook><page string="Origin &amp; Redemption"><group><field name="batch_id"/><field name="sale_order_id"/><field name="invoice_id"/><field name="redeemed_allocation_id" readonly="1"/><field name="redeemed_on" readonly="1"/><field name="redeemed_by_user_id" readonly="1"/></group></page><page string="Notes"><field name="note"/><field name="internal_note" groups="clinic_package.group_clinic_package_manager"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_clinic_package_voucher" model="ir.actions.act_window"><field name="name">Package Vouchers</field><field name="res_model">clinic.package.voucher</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_package_voucher_search"/></record>

    <record id="view_clinic_package_voucher_batch_search" model="ir.ui.view"><field name="name">clinic.package.voucher.batch.search</field><field name="model">clinic.package.voucher.batch</field><field name="arch" type="xml"><search><field name="name"/><field name="package_id"/><field name="channel"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="issued" string="Issued" domain="[('state','=','issued')]"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field></record>
    <record id="view_clinic_package_voucher_batch_list" model="ir.ui.view"><field name="name">clinic.package.voucher.batch.list</field><field name="model">clinic.package.voucher.batch</field><field name="arch" type="xml"><list><field name="name"/><field name="package_id"/><field name="quantity"/><field name="voucher_count"/><field name="channel"/><field name="branch_id"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_clinic_package_voucher_batch_form" model="ir.ui.view"><field name="name">clinic.package.voucher.batch.form</field><field name="model">clinic.package.voucher.batch</field><field name="arch" type="xml"><form string="Voucher Batch"><header><button name="action_generate" type="object" string="Generate Vouchers" class="btn-primary" invisible="state != 'draft'"/><button name="action_issue_all" type="object" string="Issue All" class="btn-primary" invisible="state not in ('draft','generated')"/><field name="state" widget="statusbar" statusbar_visible="draft,generated,issued,cancelled"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_vouchers" type="object" class="oe_stat_button" icon="fa-ticket"><field name="voucher_count" widget="statinfo" string="Vouchers"/></button></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="package_id"/><field name="quantity"/><field name="channel"/><field name="branch_id"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Default Recipient / Validity"><field name="patient_id"/><field name="partner_id"/><field name="valid_from"/><field name="valid_to"/></group></group><notebook><page string="Generated Vouchers"><field name="voucher_ids" readonly="1"><list><field name="name"/><field name="code"/><field name="patient_id"/><field name="valid_to"/><field name="state" widget="badge"/><button name="action_view_allocation" type="object" string="Allocation" icon="fa-id-card" invisible="not redeemed_allocation_id"/></list></field></page><page string="Notes"><field name="note"/></page></notebook></sheet></form></field></record>
    <record id="action_clinic_package_voucher_batch" model="ir.actions.act_window"><field name="name">Voucher Batches</field><field name="res_model">clinic.package.voucher.batch</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_package_voucher_batch_search"/></record>
</odoo>
