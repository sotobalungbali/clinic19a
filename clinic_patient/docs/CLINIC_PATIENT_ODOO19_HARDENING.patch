+<?xml version="1.0" encoding="utf-8"?>
+<odoo>
+    <!--
+        Company isolation is enforced at ORM level.
+        UI visibility is never used as a substitute for record security.
+    -->
+    <record id="rule_clinic_patient_company" model="ir.rule">
+        <field name="name">Clinic Patient: company access</field>
+        <field name="model_id" ref="model_clinic_patient"/>
+        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
+        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
+    </record>
+
