<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================================
         Allergen Category
         ========================================================= -->
    <record id="view_clinic_allergen_category_search" model="ir.ui.view">
        <field name="name">clinic.allergen.category.search</field>
        <field name="model">clinic.allergen.category</field>
        <field name="arch" type="xml">
            <search string="Allergen Categories">
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_allergen_category_list" model="ir.ui.view">
        <field name="name">clinic.allergen.category.list</field>
        <field name="model">clinic.allergen.category</field>
        <field name="arch" type="xml">
            <list string="Allergen Categories" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_allergen_category_form" model="ir.ui.view">
        <field name="name">clinic.allergen.category.form</field>
        <field name="model">clinic.allergen.category</field>
        <field name="arch" type="xml">
            <form string="Allergen Category">
                <sheet><group><field name="name"/><field name="code"/><field name="sequence"/><field name="active"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_clinic_allergen_category" model="ir.actions.act_window">
        <field name="name">Allergen Categories</field>
        <field name="res_model">clinic.allergen.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_allergen_category_search"/>
    </record>

    <!-- =========================================================
         Allergen
         ========================================================= -->
    <record id="view_clinic_allergen_search" model="ir.ui.view">
        <field name="name">clinic.allergen.search</field>
        <field name="model">clinic.allergen</field>
        <field name="arch" type="xml">
            <search string="Allergens">
                <field name="name"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_allergen_list" model="ir.ui.view">
        <field name="name">clinic.allergen.list</field>
        <field name="model">clinic.allergen</field>
        <field name="arch" type="xml">
            <list string="Allergens" decoration-muted="not active">
                <field name="name"/>
                <field name="category_id"/>
                <field name="commonness" optional="show"/>
                <field name="product_id" optional="hide"/>
                <field name="barcode_symbology" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_allergen_form" model="ir.ui.view">
        <field name="name">clinic.allergen.form</field>
        <field name="model">clinic.allergen</field>
        <field name="arch" type="xml">
            <form string="Allergen">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="commonness"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="barcode_symbology"/>
                        </group>
                    </group>
                    <group string="Synonyms"><field name="synonyms" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_clinic_allergen" model="ir.actions.act_window">
        <field name="name">Allergens</field>
        <field name="res_model">clinic.allergen</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_allergen_search"/>
    </record>

    <!-- =========================================================
         Allergy Reaction Type
         ========================================================= -->
    <record id="view_clinic_allergy_reaction_type_search" model="ir.ui.view">
        <field name="name">clinic.allergy.reaction.type.search</field>
        <field name="model">clinic.allergy.reaction.type</field>
        <field name="arch" type="xml">
            <search string="Reaction Types">
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_allergy_reaction_type_list" model="ir.ui.view">
        <field name="name">clinic.allergy.reaction.type.list</field>
        <field name="model">clinic.allergy.reaction.type</field>
        <field name="arch" type="xml">
            <list string="Reaction Types" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_allergy_reaction_type_form" model="ir.ui.view">
        <field name="name">clinic.allergy.reaction.type.form</field>
        <field name="model">clinic.allergy.reaction.type</field>
        <field name="arch" type="xml">
            <form string="Reaction Type">
                <sheet><group><field name="name"/><field name="code"/><field name="sequence"/><field name="active"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_clinic_allergy_reaction_type" model="ir.actions.act_window">
        <field name="name">Reaction Types</field>
        <field name="res_model">clinic.allergy.reaction.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_allergy_reaction_type_search"/>
    </record>

    <!-- =========================================================
         Patient Allergy
         ========================================================= -->
    <record id="view_clinic_patient_allergy_search" model="ir.ui.view">
        <field name="name">clinic.patient.allergy.search</field>
        <field name="model">clinic.patient.allergy</field>
        <field name="arch" type="xml">
            <search string="Patient Allergies">
                <field name="patient_id"/>
                <field name="allergen_id"/>
                <field name="allergen_name"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <filter name="active_status" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="critical" string="Critical" domain="[('is_critical', '=', True)]"/>
                <filter name="confirmed" string="Confirmed" domain="[('verification_status', '=', 'confirmed')]"/>
                <filter name="resolved" string="Resolved" domain="[('status', '=', 'resolved')]"/>
                <separator/>
                <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_patient_allergy_list" model="ir.ui.view">
        <field name="name">clinic.patient.allergy.list</field>
        <field name="model">clinic.patient.allergy</field>
        <field name="arch" type="xml">
            <list string="Patient Allergies"
                  decoration-danger="is_critical"
                  decoration-muted="status == 'resolved'">
                <field name="patient_id"/>
                <field name="allergen_id"/>
                <field name="allergen_name" optional="hide"/>
                <field name="category_id" optional="show"/>
                <field name="severity"/>
                <field name="criticality"/>
                <field name="status"/>
                <field name="verification_status" optional="show"/>
                <field name="recorded_date"/>
                <field name="is_critical" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_mark_resolved" type="object" string="Resolve" icon="fa-check"
                        invisible="status == 'resolved'"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_patient_allergy_form" model="ir.ui.view">
        <field name="name">clinic.patient.allergy.form</field>
        <field name="model">clinic.patient.allergy</field>
        <field name="arch" type="xml">
            <form string="Patient Allergy">
                <header>
                    <button name="action_mark_resolved" type="object" string="Mark Resolved"
                            class="btn-primary" invisible="status == 'resolved'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachments" type="object" class="oe_stat_button"
                                icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" text="Critical" bg_color="text-bg-danger"
                            invisible="not is_critical"/>
                    <div class="oe_title"><label for="patient_id"/><h1><field name="patient_id"/></h1></div>
                    <group>
                        <group string="Allergen">
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="allergen_id"/>
                            <field name="allergen_name"/>
                            <field name="category_id"/>
                            <field name="product_id"/>
                        </group>
                        <group string="Clinical Assessment">
                            <field name="verification_status"/>
                            <field name="severity"/>
                            <field name="criticality"/>
                            <field name="worst_reaction" readonly="1"/>
                            <field name="source"/>
                        </group>
                    </group>
                    <group>
                        <group string="Timeline">
                            <field name="recorded_date"/>
                            <field name="recorded_by"/>
                            <field name="onset_date"/>
                            <field name="last_occurrence_date"/>
                        </group>
                        <group string="Summary">
                            <field name="reaction_summary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reactions">
                            <field name="reaction_ids" context="{'default_allergy_id': id}">
                                <list>
                                    <field name="reaction_type_id"/>
                                    <field name="reaction_text" optional="hide"/>
                                    <field name="severity"/>
                                    <field name="onset_datetime"/>
                                    <field name="outcome"/>
                                    <button name="action_open_attachments" type="object"
                                            string="Attachments" icon="fa-paperclip"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes" nolabel="1"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_clinic_patient_allergy" model="ir.actions.act_window">
        <field name="name">Patient Allergies</field>
        <field name="res_model">clinic.patient.allergy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_patient_allergy_search"/>
    </record>

    <!-- =========================================================
         Allergy Reaction
         ========================================================= -->
    <record id="view_clinic_patient_allergy_reaction_search" model="ir.ui.view">
        <field name="name">clinic.patient.allergy.reaction.search</field>
        <field name="model">clinic.patient.allergy.reaction</field>
        <field name="arch" type="xml">
            <search string="Allergy Reactions">
                <field name="patient_id"/>
                <field name="allergy_id"/>
                <field name="reaction_type_id"/>
                <field name="reaction_text"/>
                <filter name="severe" string="Severe" domain="[('severity', 'in', ['severe', 'life_threatening'])]"/>
                <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_patient_allergy_reaction_list" model="ir.ui.view">
        <field name="name">clinic.patient.allergy.reaction.list</field>
        <field name="model">clinic.patient.allergy.reaction</field>
        <field name="arch" type="xml">
            <list string="Allergy Reactions" decoration-danger="severity in ('severe', 'life_threatening')">
                <field name="patient_id"/>
                <field name="allergy_id"/>
                <field name="reaction_type_id"/>
                <field name="reaction_text" optional="hide"/>
                <field name="severity"/>
                <field name="onset_datetime"/>
                <field name="outcome"/>
                <field name="recorded_by" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_patient_allergy_reaction_form" model="ir.ui.view">
        <field name="name">clinic.patient.allergy.reaction.form</field>
        <field name="model">clinic.patient.allergy.reaction</field>
        <field name="arch" type="xml">
            <form string="Allergy Reaction">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachments" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="allergy_id"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="reaction_type_id"/>
                            <field name="reaction_text"/>
                            <field name="severity"/>
                        </group>
                        <group>
                            <field name="onset_datetime"/>
                            <field name="exposure_route"/>
                            <field name="exposure_dose"/>
                            <field name="outcome"/>
                            <field name="recorded_date"/>
                            <field name="recorded_by"/>
                        </group>
                    </group>
                    <group string="Description"><field name="description" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_clinic_patient_allergy_reaction" model="ir.actions.act_window">
        <field name="name">Allergy Reactions</field>
        <field name="res_model">clinic.patient.allergy.reaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_patient_allergy_reaction_search"/>
    </record>
</odoo>
