<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================================================
         Condition Category
         ========================================================= -->
    <record id="view_clinic_condition_category_search" model="ir.ui.view">
        <field name="name">clinic.condition.category.search</field>
        <field name="model">clinic.condition.category</field>
        <field name="arch" type="xml">
            <search string="Condition Categories">
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_condition_category_list" model="ir.ui.view">
        <field name="name">clinic.condition.category.list</field>
        <field name="model">clinic.condition.category</field>
        <field name="arch" type="xml">
            <list string="Condition Categories" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_condition_category_form" model="ir.ui.view">
        <field name="name">clinic.condition.category.form</field>
        <field name="model">clinic.condition.category</field>
        <field name="arch" type="xml">
            <form string="Condition Category">
                <sheet><group><field name="name"/><field name="code"/><field name="sequence"/><field name="active"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_clinic_condition_category" model="ir.actions.act_window">
        <field name="name">Condition Categories</field>
        <field name="res_model">clinic.condition.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_condition_category_search"/>
    </record>

    <!-- =========================================================
         Condition Dictionary
         ========================================================= -->
    <record id="view_clinic_condition_search" model="ir.ui.view">
        <field name="name">clinic.condition.search</field>
        <field name="model">clinic.condition</field>
        <field name="arch" type="xml">
            <search string="Conditions">
                <field name="name"/>
                <field name="category_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="chronic" string="Chronic" domain="[('chronic', '=', True)]"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_condition_list" model="ir.ui.view">
        <field name="name">clinic.condition.list</field>
        <field name="model">clinic.condition</field>
        <field name="arch" type="xml">
            <list string="Conditions" decoration-muted="not active">
                <field name="name"/>
                <field name="category_id"/>
                <field name="chronic"/>
                <field name="default_severity"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_condition_form" model="ir.ui.view">
        <field name="name">clinic.condition.form</field>
        <field name="model">clinic.condition</field>
        <field name="arch" type="xml">
            <form string="Condition">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="chronic"/>
                            <field name="default_severity"/>
                            <field name="active"/>
                        </group>
                        <group string="Synonyms">
                            <field name="synonyms" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Codes">
                            <field name="code_ids" context="{'default_condition_id': id}">
                                <list editable="bottom">
                                    <field name="system"/>
                                    <field name="code"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_clinic_condition" model="ir.actions.act_window">
        <field name="name">Conditions</field>
        <field name="res_model">clinic.condition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_condition_search"/>
    </record>

    <!-- =========================================================
         Condition Code
         ========================================================= -->
    <record id="view_clinic_condition_code_search" model="ir.ui.view">
        <field name="name">clinic.condition.code.search</field>
        <field name="model">clinic.condition.code</field>
        <field name="arch" type="xml">
            <search string="Condition Codes">
                <field name="code"/>
                <field name="description"/>
                <field name="condition_id"/>
                <field name="system"/>
                <filter name="group_system" string="System" context="{'group_by': 'system'}"/>
                <filter name="group_condition" string="Condition" context="{'group_by': 'condition_id'}"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_condition_code_list" model="ir.ui.view">
        <field name="name">clinic.condition.code.list</field>
        <field name="model">clinic.condition.code</field>
        <field name="arch" type="xml">
            <list string="Condition Codes">
                <field name="system"/>
                <field name="code"/>
                <field name="description"/>
                <field name="condition_id"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_condition_code_form" model="ir.ui.view">
        <field name="name">clinic.condition.code.form</field>
        <field name="model">clinic.condition.code</field>
        <field name="arch" type="xml">
            <form string="Condition Code">
                <sheet>
                    <group>
                        <field name="condition_id"/>
                        <field name="system"/>
                        <field name="code"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_clinic_condition_code" model="ir.actions.act_window">
        <field name="name">Condition Codes</field>
        <field name="res_model">clinic.condition.code</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_condition_code_search"/>
    </record>

    <!-- =========================================================
         Patient Condition
         ========================================================= -->
    <record id="view_clinic_patient_condition_search" model="ir.ui.view">
        <field name="name">clinic.patient.condition.search</field>
        <field name="model">clinic.patient.condition</field>
        <field name="arch" type="xml">
            <search string="Patient Conditions">
                <field name="patient_id"/>
                <field name="condition_id"/>
                <field name="condition_name"/>
                <field name="code_value"/>
                <field name="category_id"/>
                <filter name="active_status" string="Active" domain="[('status', 'in', ['active', 'recurrence', 'remission'])]"/>
                <filter name="chronic" string="Chronic" domain="[('is_chronic', '=', True)]"/>
                <filter name="confirmed" string="Confirmed" domain="[('verification_status', '=', 'confirmed')]"/>
                <filter name="resolved" string="Resolved" domain="[('status', '=', 'resolved')]"/>
                <filter name="severe" string="Severe" domain="[('severity', 'in', ['severe', 'life_threatening'])]"/>
                <separator/>
                <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_patient_condition_list" model="ir.ui.view">
        <field name="name">clinic.patient.condition.list</field>
        <field name="model">clinic.patient.condition</field>
        <field name="arch" type="xml">
            <list string="Patient Conditions"
                  decoration-muted="status == 'resolved'"
                  decoration-danger="severity in ('severe', 'life_threatening')">
                <field name="patient_id"/>
                <field name="condition_id"/>
                <field name="condition_name" optional="hide"/>
                <field name="code_value" optional="show"/>
                <field name="status"/>
                <field name="verification_status" optional="show"/>
                <field name="severity"/>
                <field name="stage" optional="hide"/>
                <field name="is_chronic"/>
                <field name="onset_date"/>
                <field name="abatement_date" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_mark_resolved" type="object" string="Resolve"
                        icon="fa-check" invisible="status == 'resolved'"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_patient_condition_form" model="ir.ui.view">
        <field name="name">clinic.patient.condition.form</field>
        <field name="model">clinic.patient.condition</field>
        <field name="arch" type="xml">
            <form string="Patient Condition">
                <header>
                    <button name="action_mark_resolved" type="object"
                            string="Mark Resolved" class="btn-primary"
                            invisible="status == 'resolved'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachments" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="patient_id"/>
                        <h1><field name="patient_id"/></h1>
                    </div>
                    <group>
                        <group string="Condition">
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="condition_id"/>
                            <field name="condition_name"/>
                            <field name="category_id"/>
                            <field name="code_id"/>
                            <field name="code_system"/>
                            <field name="code_value"/>
                        </group>
                        <group string="Clinical Status">
                            <field name="verification_status"/>
                            <field name="severity"/>
                            <field name="stage"/>
                            <field name="stage_text"/>
                            <field name="is_chronic" readonly="1"/>
                            <field name="worst_episode_severity" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Location">
                            <field name="body_site"/>
                            <field name="laterality"/>
                        </group>
                        <group string="Timeline">
                            <field name="onset_date"/>
                            <field name="abatement_date"/>
                            <field name="last_review_date"/>
                            <field name="chronic_override"/>
                            <field name="chronic_threshold_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Episodes">
                            <field name="episode_ids" context="{'default_condition_id': id}">
                                <list>
                                    <field name="episode_datetime"/>
                                    <field name="severity"/>
                                    <field name="outcome"/>
                                    <field name="description" optional="show"/>
                                    <button name="action_open_attachments" type="object"
                                            string="Attachments" icon="fa-paperclip"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes" nolabel="1"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_clinic_patient_condition" model="ir.actions.act_window">
        <field name="name">Patient Conditions</field>
        <field name="res_model">clinic.patient.condition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_patient_condition_search"/>
    </record>

    <!-- =========================================================
         Condition Episode
         ========================================================= -->
    <record id="view_clinic_patient_condition_episode_search" model="ir.ui.view">
        <field name="name">clinic.patient.condition.episode.search</field>
        <field name="model">clinic.patient.condition.episode</field>
        <field name="arch" type="xml">
            <search string="Condition Episodes">
                <field name="patient_id"/>
                <field name="condition_id"/>
                <field name="description"/>
                <filter name="severe" string="Severe" domain="[('severity', 'in', ['severe', 'life_threatening'])]"/>
                <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                <filter name="group_outcome" string="Outcome" context="{'group_by': 'outcome'}"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_patient_condition_episode_list" model="ir.ui.view">
        <field name="name">clinic.patient.condition.episode.list</field>
        <field name="model">clinic.patient.condition.episode</field>
        <field name="arch" type="xml">
            <list string="Condition Episodes" decoration-danger="severity in ('severe', 'life_threatening')">
                <field name="patient_id"/>
                <field name="condition_id"/>
                <field name="episode_datetime"/>
                <field name="severity"/>
                <field name="outcome"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_patient_condition_episode_form" model="ir.ui.view">
        <field name="name">clinic.patient.condition.episode.form</field>
        <field name="model">clinic.patient.condition.episode</field>
        <field name="arch" type="xml">
            <form string="Condition Episode">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachments" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="condition_id"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="episode_datetime"/>
                            <field name="severity"/>
                            <field name="outcome"/>
                        </group>
                    </group>
                    <group string="Description"><field name="description" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_clinic_patient_condition_episode" model="ir.actions.act_window">
        <field name="name">Condition Episodes</field>
        <field name="res_model">clinic.patient.condition.episode</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clinic_patient_condition_episode_search"/>
    </record>
</odoo>
