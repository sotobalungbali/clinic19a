<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_postcare_task" model="mail.template">
        <field name="name">ClinicOne Post-Care Follow-up Reminder</field>
        <field name="model_id" ref="model_clinic_postcare_task"/>
        <field name="subject">Post-care follow-up: {{ object.name }}</field>
        <field name="email_from">{{ user.email or '' }}</field>
        <field name="email_to">{{ object.partner_id.email or '' }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Dear <t t-out="object.patient_id.display_name"/>,</p>
                <p>This is a scheduled post-care follow-up from <t t-out="object.company_id.name"/>.</p>
                <div t-if="object.instruction_html">
                    <t t-out="object.instruction_html"/>
                </div>
                <p>
                    If you are experiencing unexpected or worsening symptoms, please contact the clinic
                    using the contact instructions provided by your care team.
                </p>
                <p>Reference: <t t-out="object.reference"/></p>
            </div>
        </field>
    </record>
</odoo>
