<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_postcare" model="ir.module.category">
        <field name="name">ClinicOne Post-Care</field>
        <field name="sequence">64</field>
    </record>

    <record id="privilege_postcare" model="res.groups.privilege">
        <field name="name">ClinicOne Post-Care</field>
        <field name="category_id" ref="clinic_post_care_followup.module_category_postcare"/>
        <field name="sequence">64</field>
    </record>

    <record id="group_postcare_user" model="res.groups">
        <field name="name">Post-Care User</field>
        <field name="privilege_id" ref="clinic_post_care_followup.privilege_postcare"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_postcare_coordinator" model="res.groups">
        <field name="name">Post-Care Coordinator</field>
        <field name="privilege_id" ref="clinic_post_care_followup.privilege_postcare"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_post_care_followup.group_postcare_user'))]"/>
    </record>

    <record id="group_postcare_clinician" model="res.groups">
        <field name="name">Post-Care Clinician</field>
        <field name="privilege_id" ref="clinic_post_care_followup.privilege_postcare"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_post_care_followup.group_postcare_coordinator'))]"/>
    </record>

    <record id="group_postcare_manager" model="res.groups">
        <field name="name">Post-Care Manager</field>
        <field name="privilege_id" ref="clinic_post_care_followup.privilege_postcare"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_post_care_followup.group_postcare_clinician'))]"/>
    </record>

    <record id="rule_postcare_protocol_company" model="ir.rule">
        <field name="name">Post-Care Protocol: allowed companies</field>
        <field name="model_id" ref="model_clinic_postcare_protocol"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_post_care_followup.group_postcare_user'))]"/>
    </record>

    <record id="rule_postcare_protocol_step_company" model="ir.rule">
        <field name="name">Post-Care Protocol Step: allowed companies</field>
        <field name="model_id" ref="model_clinic_postcare_protocol_step"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_post_care_followup.group_postcare_user'))]"/>
    </record>

    <record id="rule_postcare_plan_company" model="ir.rule">
        <field name="name">Post-Care Plan: allowed companies</field>
        <field name="model_id" ref="model_clinic_postcare_plan"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_post_care_followup.group_postcare_user'))]"/>
    </record>

    <record id="rule_postcare_task_company" model="ir.rule">
        <field name="name">Post-Care Task: allowed companies</field>
        <field name="model_id" ref="model_clinic_postcare_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_post_care_followup.group_postcare_user'))]"/>
    </record>

    <record id="rule_postcare_checkin_company" model="ir.rule">
        <field name="name">Post-Care Check-in: allowed companies</field>
        <field name="model_id" ref="model_clinic_postcare_checkin"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_post_care_followup.group_postcare_user'))]"/>
    </record>

    <record id="rule_postcare_escalation_company" model="ir.rule">
        <field name="name">Post-Care Escalation: allowed companies</field>
        <field name="model_id" ref="model_clinic_postcare_escalation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_post_care_followup.group_postcare_user'))]"/>
    </record>
</odoo>
