<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quality" model="ir.module.category">
        <field name="name">ClinicOne Quality Management</field>
        <field name="sequence">76</field>
    </record>

    <record id="privilege_quality" model="res.groups.privilege">
        <field name="name">ClinicOne Quality Management</field>
        <field name="category_id" ref="clinic_quality.module_category_quality"/>
        <field name="sequence">76</field>
    </record>

    <record id="group_quality_user" model="res.groups">
        <field name="name">Quality User</field>
        <field name="privilege_id" ref="clinic_quality.privilege_quality"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_quality_inspector" model="res.groups">
        <field name="name">Quality Inspector</field>
        <field name="privilege_id" ref="clinic_quality.privilege_quality"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_quality.group_quality_user'))
        ]"/>
    </record>

    <record id="group_quality_approver" model="res.groups">
        <field name="name">Quality Approver</field>
        <field name="privilege_id" ref="clinic_quality.privilege_quality"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_quality.group_quality_inspector'))
        ]"/>
    </record>

    <record id="group_quality_manager" model="res.groups">
        <field name="name">Quality Manager</field>
        <field name="privilege_id" ref="clinic_quality.privilege_quality"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_quality.group_quality_approver'))
        ]"/>
    </record>

    <record id="rule_quality_sop_company_branch" model="ir.rule">
        <field name="name">Quality SOP: allowed companies and applicable branches</field>
        <field name="model_id" ref="model_clinic_quality_sop"/>
        <field name="domain_force">[
            '&amp;',
            ('company_id', 'in', company_ids),
            '|',
            ('branch_ids', '=', False),
            ('branch_ids', 'in', user.clinic_quality_access_branch_ids.ids)
        ]</field>
        <field name="groups" eval="[Command.link(ref('clinic_quality.group_quality_user'))]"/>
    </record>

    <record id="rule_quality_sop_version_company_branch" model="ir.rule">
