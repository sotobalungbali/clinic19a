<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quality_template_line_search" model="ir.ui.view">
        <field name="name">clinic.quality.check.template.line.search</field>
        <field name="model">clinic.quality.check.template.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="control_code"/>
                <field name="requirement"/>
                <field name="template_id"/>
                <field name="company_id"/>
                <filter name="active_control" string="Active" domain="[('active','=',True)]"/>
                <filter name="critical_control" string="Critical" domain="[('critical','=',True)]"/>
                <filter name="evidence_required" string="Evidence Required" domain="[('evidence_required','=',True)]"/>
                <group>
                    <filter name="group_template" string="Template" context="{'group_by':'template_id'}"/>
                    <filter name="group_critical" string="Critical" context="{'group_by':'critical'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_quality_template_line_list" model="ir.ui.view">
        <field name="name">clinic.quality.check.template.line.list</field>
        <field name="model">clinic.quality.check.template.line</field>
        <field name="arch" type="xml">
            <list decoration-danger="critical"
                  decoration-muted="not active">
                <field name="sequence"/>
                <field name="template_id"/>
                <field name="control_code"/>
                <field name="requirement"/>
                <field name="evidence_required"/>
                <field name="critical"/>
                <field name="weight"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_open_template" type="object"
                        string="Template" icon="fa-external-link"/>
            </list>
        </field>
    </record>

    <record id="view_quality_template_line_form" model="ir.ui.view">
        <field name="name">clinic.quality.check.template.line.form</field>
        <field name="model">clinic.quality.check.template.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_template" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <div class="o_stat_info"><span class="o_stat_text">Template</span></div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="control_code"/></h1>
                    </div>

                    <group>
                        <group string="Control Identity">
                            <field name="template_id"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Evaluation Rules">
                            <field name="critical"/>
                            <field name="evidence_required"/>
                            <field name="weight"/>
                        </group>
                    </group>

                    <group string="Requirement">
                        <field name="requirement"/>
                        <field name="guidance"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quality_template_line" model="ir.actions.act_window">
        <field name="name">Quality Template Controls</field>
        <field name="res_model">clinic.quality.check.template.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_quality_template_line_search"/>
    </record>
</odoo>
