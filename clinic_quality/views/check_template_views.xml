<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quality_template_search" model="ir.ui.view">
        <field name="name">clinic.quality.check.template.search</field>
        <field name="model">clinic.quality.check.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="sop_id"/>
                <field name="scope_type"/>
                <field name="failure_incident_type"/>
                <field name="branch_ids"/>
                <field name="company_id"/>
                <filter name="active_template" string="Active" domain="[('state','=','active')]"/>
                <filter name="draft_template" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="retired_template" string="Retired" domain="[('state','=','retired')]"/>
                <filter name="sop_governed" string="SOP Governed" domain="[('sop_id','!=',False)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_scope" string="Scope Type" context="{'group_by':'scope_type'}"/>
                    <filter name="group_sop" string="SOP" context="{'group_by':'sop_id'}"/>
                    <filter name="group_incident_type" string="Failure Incident Type" context="{'group_by':'failure_incident_type'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_quality_template_list" model="ir.ui.view">
        <field name="name">clinic.quality.check.template.list</field>
        <field name="model">clinic.quality.check.template</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'"
                  decoration-muted="state == 'retired'">
                <field name="code"/>
                <field name="name"/>
                <field name="scope_type" widget="badge"/>
                <field name="sop_id"/>
                <field name="sop_version_id"/>
                <field name="target_score"/>
                <field name="line_count"/>
                <field name="check_count"/>
                <field name="schedule_count"/>
                <field name="failure_incident_type" widget="badge"/>
                <field name="branch_ids" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_new_check" type="object" string="New Check" icon="fa-plus"
                        groups="clinic_quality.group_quality_inspector"
                        invisible="state != 'active'"/>
                <button name="action_open_checks" type="object" string="Checks" icon="fa-check-square-o"/>
                <button name="action_open_schedules" type="object" string="Schedules" icon="fa-calendar"/>
            </list>
        </field>
    </record>

    <record id="view_quality_template_form" model="ir.ui.view">
        <field name="name">clinic.quality.check.template.form</field>
        <field name="model">clinic.quality.check.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate Template" class="btn-primary"
                            groups="clinic_quality.group_quality_manager"
                            invisible="state != 'draft'"/>
                    <button name="action_retire" type="object" string="Retire Template"
                            groups="clinic_quality.group_quality_manager"
                            invisible="state == 'retired'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,retired"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_checks" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <field name="check_count" widget="statinfo" string="Checks"/>
                        </button>
                        <button name="action_open_schedules" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="schedule_count" widget="statinfo" string="Schedules"/>
                        </button>
                        <button name="action_open_sop" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not sop_id">
                            <div class="o_stat_info"><span class="o_stat_text">SOP</span></div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                        <div class="text-muted"><field name="code" readonly="state != 'draft'"/></div>
                    </div>

                    <div class="alert alert-info" role="alert"
                         invisible="state != 'active'">
                        Active templates are governed snapshots. Retire and create a new Draft revision for structural changes.
                    </div>

                    <group>
                        <group string="Governance">
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="branch_ids" widget="many2many_tags"
                                   readonly="state != 'draft'"/>
                            <field name="scope_type" readonly="state != 'draft'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="SOP &amp; Escalation">
                            <field name="sop_id" readonly="state != 'draft'"/>
                            <field name="sop_version_id" readonly="1"/>
                            <field name="failure_incident_type" readonly="state != 'draft'"/>
                            <field name="target_score" readonly="state != 'draft'"/>
                            <field name="require_evidence_on_failure" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="Purpose &amp; References">
                        <field name="objective" readonly="state != 'draft'"/>
                        <field name="instructions" readonly="state != 'draft'"/>
                        <field name="reference" readonly="state != 'draft'"/>
                    </group>

                    <div class="d-flex gap-2 flex-wrap my-3">
                        <button name="action_new_check" type="object"
                                string="Create Quality Check" class="btn btn-primary"
                                groups="clinic_quality.group_quality_inspector"
                                invisible="state != 'active'"/>
                        <button name="action_open_checks" type="object"
                                string="Review Quality Checks" class="btn btn-secondary"/>
                        <button name="action_open_schedules" type="object"
                                string="Review Schedules" class="btn btn-secondary"/>
                    </div>

                    <notebook>
                        <page string="Compliance Controls">
                            <field name="line_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom"
                                      decoration-danger="critical">
                                    <field name="sequence" widget="handle"/>
                                    <field name="control_code"/>
                                    <field name="requirement"/>
                                    <field name="evidence_required"/>
                                    <field name="critical"/>
                                    <field name="weight"/>
                                    <field name="active"/>
                                    <button name="action_open_template" type="object"
                                            string="Template" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_quality_template" model="ir.actions.act_window">
        <field name="name">Quality Check Templates</field>
        <field name="res_model">clinic.quality.check.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_quality_template_search"/>
    </record>
</odoo>
