<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_quality_sop_ack_search" model="ir.ui.view">
        <field name="name">clinic.quality.sop.acknowledgement.search</field>
        <field name="model">clinic.quality.sop.acknowledgement</field>
        <field name="arch" type="xml">
            <search>
                <field name="sop_id"/>
                <field name="version_id"/>
                <field name="staff_id"/>
                <field name="acknowledged_by_user_id"/>
                <field name="company_id"/>
                <filter name="acknowledged" string="Acknowledged"
                        domain="[('state','=','acknowledged')]"/>
                <filter name="voided" string="Voided"
                        domain="[('state','=','voided')]"/>
                <filter name="ack_date" string="Acknowledged Date" date="acknowledged_at"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_sop" string="SOP" context="{'group_by':'sop_id'}"/>
                    <filter name="group_staff" string="Staff" context="{'group_by':'staff_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_quality_sop_ack_list" model="ir.ui.view">
        <field name="name">clinic.quality.sop.acknowledgement.list</field>
        <field name="model">clinic.quality.sop.acknowledgement</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-success="state == 'acknowledged'"
                  decoration-muted="state == 'voided'">
                <field name="acknowledged_at"/>
                <field name="sop_id"/>
                <field name="version_id"/>
                <field name="staff_id"/>
                <field name="acknowledged_by_user_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_open_sop" type="object" string="SOP" icon="fa-book"/>
                <button name="action_open_version" type="object" string="Version" icon="fa-file-text-o"/>
                <button name="action_open_staff" type="object" string="Staff" icon="fa-user"/>
            </list>
        </field>
    </record>

    <record id="view_quality_sop_ack_form" model="ir.ui.view">
        <field name="name">clinic.quality.sop.acknowledgement.form</field>
        <field name="model">clinic.quality.sop.acknowledgement</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_void" type="object" string="Void Acknowledgement"
                            groups="clinic_quality.group_quality_manager"
                            invisible="state == 'voided'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="acknowledged,voided"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sop" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <div class="o_stat_info"><span class="o_stat_text">SOP</span></div>
                        </button>
                        <button name="action_open_version" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info"><span class="o_stat_text">Version</span></div>
                        </button>
                        <button name="action_open_staff" type="object"
                                class="oe_stat_button" icon="fa-user">
                            <div class="o_stat_info"><span class="o_stat_text">Staff</span></div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="staff_id" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Acknowledgement Evidence">
                            <field name="sop_id" readonly="1"/>
                            <field name="version_id" readonly="1"/>
                            <field name="acknowledged_at" readonly="1"/>
                            <field name="acknowledged_by_user_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Staff Note">
                            <field name="note" readonly="1"/>
                        </group>
                    </group>

                    <group string="Void Evidence" invisible="state != 'voided'">
                        <field name="void_reason" readonly="1"/>
                        <field name="voided_at" readonly="1"/>
                        <field name="voided_by_id" readonly="1"/>
                    </group>

                    <group string="Void Preparation" invisible="state == 'voided'"
                           groups="clinic_quality.group_quality_manager">
                        <field name="void_reason"
                               placeholder="Required before voiding an acknowledgement..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_quality_sop_ack" model="ir.actions.act_window">
        <field name="name">SOP Acknowledgements</field>
        <field name="res_model">clinic.quality.sop.acknowledgement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_quality_sop_ack_search"/>
    </record>
</odoo>
