<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_clinic_queue" model="ir.sequence">
        <field name="name">Clinic Queue</field>
        <field name="code">clinic.queue</field>
        <field name="prefix">Q/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_clinic_queue_token" model="ir.sequence">
        <field name="name">Clinic Queue Token Reference</field>
        <field name="code">clinic.queue.token</field>
        <field name="prefix">QT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_clinic_room_assignment" model="ir.sequence">
        <field name="name">Clinic Room Assignment</field>
        <field name="code">clinic.room.assignment</field>
        <field name="prefix">RA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_clinic_queue_event" model="ir.sequence">
        <field name="name">Clinic Queue Event</field>
        <field name="code">clinic.queue.event</field>
        <field name="prefix">QE/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_clinic_queue_visit" model="ir.sequence">
        <field name="name">Clinic Queue Visit</field>
        <field name="code">clinic.queue.visit</field>
        <field name="prefix">QV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_clinic_queue_ticket" model="ir.sequence">
        <field name="name">Clinic Queue Ticket</field>
        <field name="code">clinic.queue.ticket</field>
        <field name="prefix">TKT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_clinic_doctor_code_queue" model="ir.sequence">
        <field name="name">Clinic Doctor Code</field>
        <field name="code">clinic.doctor.code</field>
        <field name="prefix">D-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
