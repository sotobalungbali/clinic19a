<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_queue_event_search" model="ir.ui.view">
        <field name="name">clinic.queue.event.search</field>
        <field name="model">clinic.queue.event</field>
        <field name="arch" type="xml">
            <search string="Search Queue Events">
                <field name="name"/>
                <field name="queue_id"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="category"/>
                <field name="event_type"/>
                <field name="severity"/>
                <field name="event_datetime"/>
                <filter name="warning_error" string="Warnings / Errors"
                        domain="[('severity','in',['warning','error'])]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by':'category'}"/>
                    <filter name="group_event_type" string="Event Type" context="{'group_by':'event_type'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by':'severity'}"/>
                    <filter name="group_day" string="Day" context="{'group_by':'event_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_clinic_queue_event_list" model="ir.ui.view">
        <field name="name">clinic.queue.event.list</field>
        <field name="model">clinic.queue.event</field>
        <field name="arch" type="xml">
            <list string="Queue Events" create="false"
                  decoration-danger="severity == 'error'" decoration-warning="severity == 'warning'">
                <field name="event_datetime"/>
                <field name="name"/>
                <field name="queue_id"/>
                <field name="patient_id"/>
                <field name="category"/>
                <field name="event_type"/>
                <field name="severity"/>
                <field name="summary"/>
                <field name="actor_user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_clinic_queue_event_form" model="ir.ui.view">
        <field name="name">clinic.queue.event.form</field>
        <field name="model">clinic.queue.event</field>
        <field name="arch" type="xml">
            <form string="Queue Event" create="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_queue" type="object" class="oe_stat_button"
                                icon="fa-list" invisible="not queue_id">
                            <div class="o_stat_info"><span class="o_stat_text">Queue</span></div>
                        </button>
                        <button name="action_view_room_assignment" type="object" class="oe_stat_button"
                                icon="fa-hospital-o" invisible="not room_assignment_id">
                            <div class="o_stat_info"><span class="o_stat_text">Room Assignment</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Event">
                            <field name="event_datetime"/>
                            <field name="category"/>
                            <field name="event_type"/>
                            <field name="severity"/>
                            <field name="summary"/>
                        </group>
                        <group string="Context">
                            <field name="queue_id"/>
                            <field name="token_id"/>
                            <field name="room_id"/>
                            <field name="room_assignment_id"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transition">
                            <group>
                                <field name="old_stage_id"/>
                                <field name="new_stage_id"/>
                                <field name="old_state"/>
                                <field name="new_state"/>
                            </group>
                        </page>
                        <page string="Metrics">
                            <group>
                                <field name="waiting_duration_min_at_event"/>
                                <field name="service_duration_min_at_event"/>
                                <field name="total_duration_min_at_event"/>
                            </group>
                        </page>
                        <page string="Technical Context">
                            <group>
                                <field name="actor_user_id"/>
                                <field name="actor_employee_id"/>
                                <field name="source_model"/>
                                <field name="source_res_id"/>
                                <field name="res_model_id"/>
                                <field name="ip_address"/>
                                <field name="display_channel"/>
                                <field name="kiosk_ref"/>
                            </group>
                            <field name="payload_json"/>
                        </page>
                        <page string="Details"><field name="details"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_clinic_queue_event" model="ir.actions.act_window">
        <field name="name">Queue Events</field>
        <field name="res_model">clinic.queue.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
