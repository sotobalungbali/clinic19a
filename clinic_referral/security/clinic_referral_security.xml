<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_referral" model="ir.module.category">
        <field name="name">ClinicOne Referral Management</field>
        <field name="sequence">80</field>
    </record>

    <record id="privilege_referral" model="res.groups.privilege">
        <field name="name">ClinicOne Referral Management</field>
        <field name="category_id" ref="clinic_referral.module_category_referral"/>
        <field name="sequence">80</field>
    </record>

    <record id="group_referral_user" model="res.groups">
        <field name="name">Referral User</field>
        <field name="privilege_id" ref="clinic_referral.privilege_referral"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_referral_manager" model="res.groups">
        <field name="name">Referral Manager</field>
        <field name="privilege_id" ref="clinic_referral.privilege_referral"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_referral.group_referral_user'))]"/>
    </record>

    <!-- Regular users are company + branch scoped. Managers inherit the user
         group, but Odoo combines group rules with OR, so the manager company
         rule below intentionally broadens branch scope within allowed companies. -->
    <record id="rule_referral_user_scope" model="ir.rule">
        <field name="name">Referral User: company and allowed branches</field>
        <field name="model_id" ref="model_clinic_referral"/>
        <field name="groups" eval="[Command.link(ref('clinic_referral.group_referral_user'))]"/>
        <field name="domain_force">[
            '&amp;',
            ('company_id', 'in', company_ids),
            '|',
            ('branch_id', '=', False),
            ('branch_id', 'in', user.allowed_branch_ids.ids)
        ]</field>
    </record>

    <record id="rule_referral_manager_scope" model="ir.rule">
        <field name="name">Referral Manager: company scope</field>
        <field name="model_id" ref="model_clinic_referral"/>
        <field name="groups" eval="[Command.link(ref('clinic_referral.group_referral_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_referral_program_user_scope" model="ir.rule">
        <field name="name">Referral Program User: company and applicable branches</field>
        <field name="model_id" ref="model_clinic_referral_program"/>
        <field name="groups" eval="[Command.link(ref('clinic_referral.group_referral_user'))]"/>
        <field name="domain_force">[
            '&amp;',
            ('company_id', 'in', company_ids),
            '|',
            ('allowed_branch_ids', '=', False),
            ('allowed_branch_ids', 'in', user.allowed_branch_ids.ids)
        ]</field>
    </record>

    <record id="rule_referral_program_manager_scope" model="ir.rule">
        <field name="name">Referral Program Manager: company scope</field>
        <field name="model_id" ref="model_clinic_referral_program"/>
        <field name="groups" eval="[Command.link(ref('clinic_referral.group_referral_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_referral_source_user_scope" model="ir.rule">
        <field name="name">Referral Source User: company and branch scope</field>
        <field name="model_id" ref="model_clinic_referral_source"/>
        <field name="groups" eval="[Command.link(ref('clinic_referral.group_referral_user'))]"/>
        <field name="domain_force">[
            '&amp;',
            ('company_id', 'in', company_ids),
            '|',
            ('branch_id', '=', False),
            ('branch_id', 'in', user.allowed_branch_ids.ids)
        ]</field>
    </record>

    <record id="rule_referral_source_manager_scope" model="ir.rule">
        <field name="name">Referral Source Manager: company scope</field>
        <field name="model_id" ref="model_clinic_referral_source"/>
        <field name="groups" eval="[Command.link(ref('clinic_referral.group_referral_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

