<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_clinic_report_run_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2><span t-field="o.definition_id.name"/></h2>
                <p>
                    <strong>Run:</strong> <span t-field="o.name"/>
                    &#160; | &#160;
                    <strong>Family:</strong> <span t-field="o.family"/>
                    &#160; | &#160;
                    <strong>Status:</strong> <span t-field="o.state"/>
                </p>

                <table class="table table-sm table-bordered mb-4">
                    <tbody>
                        <tr>
                            <td><strong>Company</strong></td>
                            <td><span t-field="o.company_id"/></td>
                            <td><strong>Branch</strong></td>
                            <td>
                                <span t-if="o.branch_id" t-field="o.branch_id"/>
                                <span t-else="">All Branches / Company Scope</span>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Date From</strong></td>
                            <td><span t-field="o.date_from"/></td>
                            <td><strong>Date To</strong></td>
                            <td><span t-field="o.date_to"/></td>
                        </tr>
                        <tr>
                            <td><strong>Generated</strong></td>
                            <td><span t-field="o.generated_at"/></td>
                            <td><strong>Generated By</strong></td>
                            <td><span t-field="o.generated_by_id"/></td>
                        </tr>
                    </tbody>
                </table>

                <h4>KPI Metrics</h4>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Metric</th>
                            <th>Type</th>
                            <th class="text-end">Value</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.metric_ids.sorted('sequence')" t-as="metric">
                            <td><span t-field="metric.name"/></td>
                            <td><span t-field="metric.metric_type"/></td>
                            <td class="text-end"><span t-field="metric.display_value"/></td>
                            <td><span t-field="metric.note"/></td>
                        </tr>
                    </tbody>
                </table>

                <t t-if="o.include_details and o.detail_ids">
                    <h4 class="mt-4">Traceable Details</h4>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Reference</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Patient</th>
                                <th class="text-end">Amount</th>
                                <th class="text-end">Qty</th>
                                <th class="text-end">Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.detail_ids[:100]" t-as="detail">
                                <td><span t-field="detail.event_date"/></td>
                                <td><span t-field="detail.reference"/></td>
                                <td><span t-field="detail.label"/></td>
                                <td><span t-field="detail.state_label"/></td>
                                <td>
                                    <span t-if="detail.patient_id" t-field="detail.patient_id"/>
                                    <span t-elif="detail.partner_id" t-field="detail.partner_id"/>
                                </td>
                                <td class="text-end"><span t-field="detail.amount"/></td>
                                <td class="text-end"><span t-field="detail.quantity"/></td>
                                <td class="text-end"><span t-field="detail.duration_minutes"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <p t-if="len(o.detail_ids) &gt; 100" class="text-muted">
                        PDF shows the first 100 detail rows. Use CSV export for the complete detail snapshot.
                    </p>
                </t>

                <div t-if="o.methodology_snapshot" class="mt-4">
                    <h4>Methodology</h4>
                    <div t-field="o.methodology_snapshot"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_clinic_report_run">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="clinic_reports.report_clinic_report_run_document"/>
            </t>
        </t>
    </template>
</odoo>

