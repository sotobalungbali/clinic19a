<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_reports" model="ir.module.category">
        <field name="name">ClinicOne Reports</field>
        <field name="sequence">66</field>
    </record>

    <record id="privilege_reports" model="res.groups.privilege">
        <field name="name">ClinicOne Reports</field>
        <field name="category_id" ref="clinic_reports.module_category_reports"/>
        <field name="sequence">66</field>
    </record>

    <record id="group_reports_user" model="res.groups">
        <field name="name">Reports User</field>
        <field name="privilege_id" ref="clinic_reports.privilege_reports"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_reports_analyst" model="res.groups">
        <field name="name">Reports Analyst</field>
        <field name="privilege_id" ref="clinic_reports.privilege_reports"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_reports.group_reports_user'))]"/>
    </record>

    <record id="group_reports_manager" model="res.groups">
        <field name="name">Reports Manager</field>
        <field name="privilege_id" ref="clinic_reports.privilege_reports"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_reports.group_reports_analyst'))]"/>
    </record>

    <record id="rule_report_run_company" model="ir.rule">
        <field name="name">Report Run: allowed companies</field>
        <field name="model_id" ref="model_clinic_report_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_reports.group_reports_user'))]"/>
    </record>

    <record id="rule_report_metric_company" model="ir.rule">
        <field name="name">Report Metric: allowed companies</field>
        <field name="model_id" ref="model_clinic_report_metric"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_reports.group_reports_user'))]"/>
    </record>

    <record id="rule_report_detail_company" model="ir.rule">
        <field name="name">Report Detail: allowed companies</field>
        <field name="model_id" ref="model_clinic_report_detail"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_reports.group_reports_user'))]"/>
    </record>

    <record id="rule_report_schedule_company" model="ir.rule">
        <field name="name">Report Schedule: allowed companies</field>
        <field name="model_id" ref="model_clinic_report_schedule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_reports.group_reports_user'))]"/>
    </record>
</odoo>
