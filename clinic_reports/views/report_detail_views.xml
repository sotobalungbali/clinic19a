<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_detail_search" model="ir.ui.view">
        <field name="name">clinic.report.detail.search</field>
        <field name="model">clinic.report.detail</field>
        <field name="arch" type="xml">
            <search>
                <field name="run_id"/>
                <field name="definition_id"/>
                <field name="reference"/>
                <field name="label"/>
                <field name="state_label"/>
                <field name="partner_id"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="staff_id"/>
                <field name="treatment_id"/>
                <field name="room_id"/>
                <field name="source_model"/>
                <field name="company_id"/>
                <field name="branch_id"/>
                <group>
                    <filter name="group_run" string="Report Run" context="{'group_by':'run_id'}"/>
                    <filter name="group_definition" string="Report" context="{'group_by':'definition_id'}"/>
                    <filter name="group_label" string="Detail Type" context="{'group_by':'label'}"/>
                    <filter name="group_state" string="Source Status" context="{'group_by':'state_label'}"/>
                    <filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/>
                    <filter name="group_doctor" string="Doctor" context="{'group_by':'doctor_id'}"/>
                    <filter name="group_staff" string="Staff" context="{'group_by':'staff_id'}"/>
                    <filter name="group_treatment" string="Treatment" context="{'group_by':'treatment_id'}"/>
                    <filter name="group_room" string="Room" context="{'group_by':'room_id'}"/>
                    <filter name="group_day" string="Event Day" context="{'group_by':'event_date:day'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_report_detail_list" model="ir.ui.view">
        <field name="name">clinic.report.detail.list</field>
        <field name="model">clinic.report.detail</field>
        <field name="arch" type="xml">
            <list>
                <field name="event_date"/>
                <field name="run_id"/>
                <field name="reference"/>
                <field name="label"/>
                <field name="state_label"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="staff_id"/>
                <field name="treatment_id"/>
                <field name="room_id"/>
                <field name="amount"/>
                <field name="quantity"/>
                <field name="duration_minutes"/>
                <field name="rating"/>
                <field name="source_model" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_open_source" type="object" string="Source" icon="fa-external-link"
                        invisible="not source_model or not source_res_id"/>
                <button name="action_open_run" type="object" string="Run" icon="fa-history"/>
            </list>
        </field>
    </record>

    <record id="view_report_detail_form" model="ir.ui.view">
        <field name="name">clinic.report.detail.form</field>
        <field name="model">clinic.report.detail</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_source" type="object" class="oe_stat_button" icon="fa-external-link"
                                invisible="not source_model or not source_res_id">
                            <div class="o_stat_info"><span class="o_stat_text">Source Record</span></div>
                        </button>
                        <button name="action_open_run" type="object" class="oe_stat_button" icon="fa-history">
                            <div class="o_stat_info"><span class="o_stat_text">Report Run</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="label"/>
                        <h1><field name="label"/></h1>
                        <div><field name="reference"/></div>
                    </div>
                    <group>
                        <group string="Source Snapshot">
                            <field name="event_date"/>
                            <field name="state_label"/>
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="source_display_name"/>
                            <field name="run_id"/>
                            <field name="definition_id"/>
                        </group>
                        <group string="Dimensions">
                            <field name="partner_id"/>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="staff_id"/>
                            <field name="treatment_id"/>
                            <field name="room_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                        </group>
                    </group>
                    <group string="Measures">
                        <field name="amount"/>
                        <field name="quantity"/>
                        <field name="duration_minutes"/>
                        <field name="rating"/>
                    </group>
                    <field name="note"/>
                    <div class="d-flex gap-2">
                        <button name="action_open_source" type="object" string="Open Source Record" class="btn-primary"
                                invisible="not source_model or not source_res_id"/>
                        <button name="action_open_run" type="object" string="Open Report Run" class="btn-secondary"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_report_detail_pivot" model="ir.ui.view">
        <field name="name">clinic.report.detail.pivot</field>
        <field name="model">clinic.report.detail</field>
        <field name="arch" type="xml">
            <pivot string="Report Detail Analysis">
                <field name="definition_id" type="row"/>
                <field name="label" type="row"/>
                <field name="state_label" type="col"/>
                <field name="amount" type="measure"/>
                <field name="quantity" type="measure"/>
                <field name="duration_minutes" type="measure"/>
                <field name="rating" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_report_detail_graph" model="ir.ui.view">
        <field name="name">clinic.report.detail.graph</field>
        <field name="model">clinic.report.detail</field>
        <field name="arch" type="xml">
            <graph string="Report Detail Trend" type="bar">
                <field name="event_date" interval="month"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_report_detail" model="ir.actions.act_window">
        <field name="name">Report Details</field>
        <field name="res_model">clinic.report.detail</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_report_detail_search"/>
    </record>
</odoo>

