<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_schedule_search" model="ir.ui.view">
        <field name="name">clinic.report.schedule.search</field>
        <field name="model">clinic.report.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="definition_id"/>
                <field name="family"/>
                <field name="report_key"/>
                <field name="owner_user_id"/>
                <field name="company_id"/>
                <field name="branch_id"/>
                <filter name="active_schedule" string="Active" domain="[('state','=','active')]"/>
                <filter name="paused" string="Paused" domain="[('state','=','paused')]"/>
                <group>
                    <filter name="group_definition" string="Report" context="{'group_by':'definition_id'}"/>
                    <filter name="group_cadence" string="Cadence" context="{'group_by':'cadence'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by':'owner_user_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by':'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_report_schedule_list" model="ir.ui.view">
        <field name="name">clinic.report.schedule.list</field>
        <field name="model">clinic.report.schedule</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'active'" decoration-muted="state == 'paused'">
                <field name="name"/>
                <field name="definition_id"/>
                <field name="family" widget="badge"/>
                <field name="cadence" widget="badge"/>
                <field name="window_days"/>
                <field name="owner_user_id"/>
                <field name="next_run_at"/>
                <field name="last_run_at"/>
                <field name="run_count"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_run_now" type="object" string="Run Now" icon="fa-play"
                        groups="clinic_reports.group_reports_manager"/>
                <button name="action_pause" type="object" string="Pause" icon="fa-pause"
                        groups="clinic_reports.group_reports_manager"
                        invisible="state != 'active'"/>
                <button name="action_resume" type="object" string="Resume" icon="fa-play-circle"
                        groups="clinic_reports.group_reports_manager"
                        invisible="state != 'paused'"/>
            </list>
        </field>
    </record>

    <record id="view_report_schedule_form" model="ir.ui.view">
        <field name="name">clinic.report.schedule.form</field>
        <field name="model">clinic.report.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_now" type="object" string="Run Now" class="btn-primary"
                            groups="clinic_reports.group_reports_manager"/>
                    <button name="action_resume" type="object" string="Resume" class="btn-primary"
                            groups="clinic_reports.group_reports_manager"
                            invisible="state != 'paused'"/>
                    <button name="action_pause" type="object" string="Pause"
                            groups="clinic_reports.group_reports_manager"
                            invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,paused"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_runs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="run_count" widget="statinfo" string="Runs"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Schedule Scope">
                            <field name="definition_id"/>
                            <field name="family" readonly="1"/>
                            <field name="report_key" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="owner_user_id"/>
                        </group>
                        <group string="Recurrence">
                            <field name="cadence"/>
                            <field name="window_days"/>
                            <field name="next_run_at"/>
                            <field name="include_details"/>
                            <field name="detail_limit"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <div class="d-flex gap-2 my-3">
                        <button name="action_run_now" type="object" string="Generate Now" class="btn btn-primary"
                                groups="clinic_reports.group_reports_manager"/>
                        <button name="action_view_runs" type="object" string="Review Generated Runs" class="btn btn-secondary"/>
                    </div>

                    <group string="Last Execution">
                        <field name="last_run_at" readonly="1"/>
                        <field name="last_run_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_report_schedule" model="ir.actions.act_window">
        <field name="name">Report Schedules</field>
        <field name="res_model">clinic.report.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_report_schedule_search"/>
    </record>
</odoo>

