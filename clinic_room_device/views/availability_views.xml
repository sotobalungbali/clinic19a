<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_room_availability_search" model="ir.ui.view">
        <field name="name">clinic.room.availability.search</field>
        <field name="model">clinic.room.availability</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="room_id"/><field name="shift"/><field name="state"/><field name="start"/><filter name="templates" string="Templates" domain="[('is_template','=',True)]"/><filter name="active_slots" string="Active" domain="[('state','=','active')]"/><group><filter name="group_room" string="Room" context="{'group_by':'room_id'}"/><filter name="group_shift" string="Shift" context="{'group_by':'shift'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></group></search>
        </field>
    </record>

    <record id="view_clinic_room_availability_list" model="ir.ui.view">
        <field name="name">clinic.room.availability.list</field>
        <field name="model">clinic.room.availability</field>
        <field name="arch" type="xml">
            <list><field name="room_id"/><field name="name"/><field name="start"/><field name="stop"/><field name="shift"/><field name="state"/><field name="is_template"/><field name="recurrence"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>

    <record id="view_clinic_room_availability_form" model="ir.ui.view">
        <field name="name">clinic.room.availability.form</field>
        <field name="model">clinic.room.availability</field>
        <field name="arch" type="xml">
            <form string="Room Availability"><header><button name="action_set_active" type="object" string="Activate" class="btn-primary" invisible="state == 'active'"/><button name="action_set_draft" type="object" string="Draft" invisible="state == 'draft'"/><button name="action_set_archived" type="object" string="Archive" invisible="state == 'archived'"/><button name="action_generate_from_template" type="object" string="Generate Slots" invisible="not is_template"/><field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/></header><sheet><div class="oe_title"><h1><field name="label" readonly="1"/></h1><field name="name"/></div><group><group><field name="room_id"/><field name="start"/><field name="stop"/><field name="shift"/><field name="capacity_hint"/></group><group><field name="is_template"/><field name="recurrence"/><field name="interval"/><field name="byweekday"/><field name="bysetpos"/><field name="until"/><field name="company_id" groups="base.group_multi_company"/></group></group></sheet><chatter/></form>
        </field>
    </record>

    <record id="view_clinic_room_availability_calendar" model="ir.ui.view">
        <field name="name">clinic.room.availability.calendar</field>
        <field name="model">clinic.room.availability</field>
        <field name="arch" type="xml">
            <calendar string="Room Availability" date_start="start" date_stop="stop" color="room_id"><field name="room_id"/><field name="shift"/><field name="state"/></calendar>
        </field>
    </record>

    <record id="action_clinic_room_availability" model="ir.actions.act_window"><field name="name">Room Availability</field><field name="res_model">clinic.room.availability</field><field name="view_mode">list,calendar,form</field></record>
</odoo>
