<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_device_search" model="ir.ui.view">
        <field name="name">clinic.device.search</field>
        <field name="model">clinic.device</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="code"/><field name="serial_no"/><field name="category_id"/><field name="status"/><field name="location_id"/><filter name="ready" string="Ready" domain="[('status','=','available')]"/><filter name="maintenance" string="Maintenance" domain="[('status','=','maintenance')]"/><group><filter name="group_by_status" string="Status" context="{'group_by':'status'}"/><filter name="group_category" string="Category" context="{'group_by':'category_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search>
        </field>
    </record>

    <record id="view_clinic_device_list" model="ir.ui.view">
        <field name="name">clinic.device.list</field>
        <field name="model">clinic.device</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="serial_no"/><field name="category_id"/><field name="status"/><field name="location_id"/><field name="next_maintenance_date"/><field name="calibration_due_date"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>

    <record id="view_clinic_device_form" model="ir.ui.view">
        <field name="name">clinic.device.form</field>
        <field name="model">clinic.device</field>
        <field name="arch" type="xml">
            <form string="Clinic Device">
                <header>
                    <button name="set_available" type="object" string="Available" class="btn-primary" invisible="status == 'available'"/>
                    <button name="set_reserved" type="object" string="Reserve" invisible="status == 'retired'"/>
                    <button name="set_in_use" type="object" string="In Use" invisible="status == 'retired'"/>
                    <button name="set_maintenance" type="object" string="Maintenance" invisible="status == 'retired'"/>
                    <button name="set_offline" type="object" string="Offline" invisible="status == 'retired'"/>
                    <button name="set_retired" type="object" string="Retire" invisible="status == 'retired'"/>
                    <field name="status" widget="statusbar" statusbar_visible="available,reserved,in_use,maintenance,offline,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-map-marker"><field name="assignment_count" widget="statinfo" string="Assignments"/></button>
                        <button name="action_view_movements" type="object" class="oe_stat_button" icon="fa-exchange"><field name="movement_count" widget="statinfo" string="Movements"/></button>
                        <button name="action_open_stock_moves" type="object" class="oe_stat_button" icon="fa-cubes"><span class="o_stat_text">Stock Moves</span></button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/><div class="oe_title"><h1><field name="name"/></h1><field name="code"/><field name="serial_no"/></div>
                    <group><group><field name="category_id"/><field name="product_id"/><field name="lot_id"/><field name="manufacturer"/><field name="model"/></group><group><field name="current_room_id" readonly="1"/><field name="location_id"/><field name="maintenance_team_id"/><field name="vendor_id"/><field name="company_id" groups="base.group_multi_company"/></group></group>
                    <notebook>
                        <page string="Maintenance"><group><field name="last_maintenance_date"/><field name="maintenance_interval_days"/><field name="next_maintenance_date" readonly="1"/><field name="calibration_date_last"/><field name="calibration_interval_days"/><field name="calibration_due_date" readonly="1"/></group></page>
                        <page string="Commercial"><group><field name="purchase_date"/><field name="purchase_price"/><field name="currency_id"/><field name="warranty_months"/><field name="warranty_end_date" readonly="1"/></group></page>
                        <page string="Qualified Doctors"><field name="qualified_doctor_ids" widget="many2many_tags"/></page>
                        <page string="Assignments"><field name="assignment_ids"><list><field name="room_id"/><field name="state"/><field name="start"/><field name="end"/><button name="action_open_room" type="object" string="Room" icon="fa-external-link"/></list></field></page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>

    <record id="view_clinic_device_category_search" model="ir.ui.view">
        <field name="name">clinic.device.category.search</field>
        <field name="model">clinic.device.category</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="code"/><field name="usage_kind"/><field name="readiness_hint"/><group><filter name="group_usage" string="Usage" context="{'group_by':'usage_kind'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}"/></group></search>
        </field>
    </record>

    <record id="view_clinic_device_category_list" model="ir.ui.view">
        <field name="name">clinic.device.category.list</field>
        <field name="model">clinic.device.category</field>
        <field name="arch" type="xml">
            <list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="usage_kind"/><field name="readiness_hint"/><field name="training_required"/><field name="requires_certification"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>

    <record id="view_clinic_device_category_form" model="ir.ui.view">
        <field name="name">clinic.device.category.form</field>
        <field name="model">clinic.device.category</field>
        <field name="arch" type="xml">
            <form string="Device Category"><sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_devices" type="object" class="oe_stat_button" icon="fa-medkit"><field name="device_count" widget="statinfo" string="Devices"/></button>
                    <button name="action_view_due_maintenance" type="object" class="oe_stat_button" icon="fa-wrench"><field name="due_maintenance_count" widget="statinfo" string="Due Maintenance"/></button>
                    <button name="action_view_due_calibration" type="object" class="oe_stat_button" icon="fa-check-square-o"><field name="due_calibration_count" widget="statinfo" string="Due Calibration"/></button>
                </div>
                <field name="image_1920" widget="image" class="oe_avatar"/><div class="oe_title"><h1><field name="name"/></h1><field name="code"/></div>
                <group><group><field name="usage_kind"/><field name="readiness_hint"/><field name="maintenance_team_id"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="default_maintenance_interval_days"/><field name="default_calibration_interval_days"/><field name="default_warranty_months"/><field name="active"/></group></group>
                <notebook><page string="Compliance"><field name="requires_certification"/><field name="certification_notes"/><field name="safety_tags"/></page><page string="Products"><field name="product_category_ids" widget="many2many_tags"/><field name="recommended_product_ids" widget="many2many_tags"/></page><page string="Vendors &amp; Training"><field name="preferred_vendor_ids" widget="many2many_tags"/><field name="training_required"/><field name="training_description"/></page><page string="Notes"><field name="notes"/></page></notebook>
            </sheet><chatter/></form>
        </field>
    </record>

    <record id="action_clinic_device" model="ir.actions.act_window"><field name="name">Devices</field><field name="res_model">clinic.device</field><field name="view_mode">list,form</field></record>
    <record id="action_clinic_device_category" model="ir.actions.act_window"><field name="name">Device Categories</field><field name="res_model">clinic.device.category</field><field name="view_mode">list,form</field></record>
</odoo>
