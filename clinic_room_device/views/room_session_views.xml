<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_room_session_search" model="ir.ui.view">
        <field name="name">clinic.room.session.search</field>
        <field name="model">clinic.room.session</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="room_id"/><field name="patient_id"/><field name="doctor_id"/><field name="state"/><field name="start_datetime"/><filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/><group><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_room" string="Room" context="{'group_by':'room_id'}"/><filter name="group_doctor" string="Doctor" context="{'group_by':'doctor_id'}"/></group></search>
        </field>
    </record>

    <record id="view_clinic_room_session_list" model="ir.ui.view">
        <field name="name">clinic.room.session.list</field>
        <field name="model">clinic.room.session</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="room_id"/><field name="patient_id"/><field name="doctor_id"/><field name="start_datetime"/><field name="end_datetime"/><field name="duration_minutes"/><field name="state"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>

    <record id="view_clinic_room_session_form" model="ir.ui.view">
        <field name="name">clinic.room.session.form</field>
        <field name="model">clinic.room.session</field>
        <field name="arch" type="xml">
            <form string="Room Session"><header><button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/><button name="action_start" type="object" string="Start" invisible="state not in ('draft','scheduled')"/><button name="action_finish" type="object" string="Finish" invisible="state != 'in_progress'"/><button name="action_no_show" type="object" string="No Show" invisible="state != 'scheduled'"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('done','cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,done,no_show,cancelled"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_room" type="object" class="oe_stat_button" icon="fa-building"><span class="o_stat_text">Room</span></button><button name="action_open_devices" type="object" class="oe_stat_button" icon="fa-medkit"><field name="device_count" widget="statinfo" string="Devices"/></button></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="room_id"/><field name="booking_policy" readonly="1"/><field name="patient_id"/><field name="doctor_id"/><field name="employee_ids" widget="many2many_tags"/></group><group><field name="start_datetime"/><field name="end_datetime"/><field name="duration_minutes" readonly="1"/><field name="queue_token"/><field name="company_id" groups="base.group_multi_company"/></group></group><notebook><page string="Devices"><field name="device_ids" widget="many2many_tags"/></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form>
        </field>
    </record>

    <record id="view_clinic_room_session_calendar" model="ir.ui.view">
        <field name="name">clinic.room.session.calendar</field>
        <field name="model">clinic.room.session</field>
        <field name="arch" type="xml">
            <calendar string="Room Sessions" date_start="start_datetime" date_stop="end_datetime" color="room_id"><field name="room_id"/><field name="patient_id"/><field name="doctor_id"/><field name="state"/></calendar>
        </field>
    </record>

    <record id="action_clinic_room_session" model="ir.actions.act_window"><field name="name">Room Sessions</field><field name="res_model">clinic.room.session</field><field name="view_mode">list,calendar,form</field></record>
</odoo>
