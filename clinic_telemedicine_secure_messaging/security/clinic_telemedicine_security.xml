<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_telemedicine" model="ir.module.category">
        <field name="name">ClinicOne Telemedicine</field>
        <field name="sequence">70</field>
    </record>

    <record id="privilege_telemedicine" model="res.groups.privilege">
        <field name="name">ClinicOne Telemedicine</field>
        <field name="category_id" ref="clinic_telemedicine_secure_messaging.module_category_telemedicine"/>
        <field name="sequence">70</field>
    </record>

    <record id="group_telemedicine_user" model="res.groups">
        <field name="name">Telemedicine User</field>
        <field name="privilege_id" ref="clinic_telemedicine_secure_messaging.privilege_telemedicine"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_telemedicine_clinician" model="res.groups">
        <field name="name">Telemedicine Clinician</field>
        <field name="privilege_id" ref="clinic_telemedicine_secure_messaging.privilege_telemedicine"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_telemedicine_secure_messaging.group_telemedicine_user'))
        ]"/>
    </record>

    <record id="group_telemedicine_manager" model="res.groups">
        <field name="name">Telemedicine Manager</field>
        <field name="privilege_id" ref="clinic_telemedicine_secure_messaging.privilege_telemedicine"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_telemedicine_secure_messaging.group_telemedicine_clinician'))
        ]"/>
    </record>

    <record id="rule_telemedicine_session_company" model="ir.rule">
        <field name="name">Telemedicine Session: allowed companies</field>
        <field name="model_id" ref="model_clinic_telemedicine_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_telemedicine_secure_messaging.group_telemedicine_user'))]"/>
    </record>

    <record id="rule_telemedicine_thread_company" model="ir.rule">
        <field name="name">Telemedicine Thread: allowed companies</field>
        <field name="model_id" ref="model_clinic_telemedicine_thread"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_telemedicine_secure_messaging.group_telemedicine_user'))]"/>
    </record>

    <record id="rule_telemedicine_message_company" model="ir.rule">
        <field name="name">Telemedicine Message: allowed companies</field>
        <field name="model_id" ref="model_clinic_telemedicine_message"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_telemedicine_secure_messaging.group_telemedicine_user'))]"/>
    </record>

    <record id="rule_telemedicine_attachment_company" model="ir.rule">
        <field name="name">Telemedicine Attachment: allowed companies</field>
        <field name="model_id" ref="model_clinic_telemedicine_attachment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_telemedicine_secure_messaging.group_telemedicine_user'))]"/>
    </record>
</odoo>

