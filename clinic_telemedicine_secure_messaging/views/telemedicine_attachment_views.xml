<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telemedicine_attachment_search" model="ir.ui.view">
        <field name="name">clinic.telemedicine.attachment.search</field>
        <field name="model">clinic.telemedicine.attachment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="thread_id"/>
                <field name="message_id"/>
                <field name="patient_id"/>
                <field name="mimetype"/>
                <field name="uploader_kind"/>
                <field name="company_id"/>
                <filter name="patient_upload" string="Patient Uploads" domain="[('uploader_kind','=','patient')]"/>
                <filter name="clinic_upload" string="Clinic Uploads" domain="[('uploader_kind','=','clinic')]"/>
                <filter name="pdf" string="PDF" domain="[('mimetype','=','application/pdf')]"/>
                <filter name="image" string="Images" domain="[('mimetype','in',('image/jpeg','image/png'))]"/>
                <group>
                    <filter name="group_thread" string="Thread" context="{'group_by':'thread_id'}"/>
                    <filter name="group_uploader" string="Uploader Type" context="{'group_by':'uploader_kind'}"/>
                    <filter name="group_mimetype" string="MIME Type" context="{'group_by':'mimetype'}"/>
                    <filter name="group_day" string="Upload Day" context="{'group_by':'uploaded_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_telemedicine_attachment_list" model="ir.ui.view">
        <field name="name">clinic.telemedicine.attachment.list</field>
        <field name="model">clinic.telemedicine.attachment</field>
        <field name="arch" type="xml">
            <list edit="0" delete="0">
                <field name="uploaded_at"/>
                <field name="name"/>
                <field name="thread_id"/>
                <field name="patient_id"/>
                <field name="mimetype"/>
                <field name="size_bytes"/>
                <field name="uploader_kind" widget="badge"/>
                <field name="uploaded_by_partner_id"/>
                <field name="sha256" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_download" type="object" string="Download" icon="fa-download"/>
                <button name="action_open_message" type="object" string="Message" icon="fa-comment"/>
                <button name="action_open_thread" type="object" string="Thread" icon="fa-comments"/>
            </list>
        </field>
    </record>

    <record id="view_telemedicine_attachment_form" model="ir.ui.view">
        <field name="name">clinic.telemedicine.attachment.form</field>
        <field name="model">clinic.telemedicine.attachment</field>
        <field name="arch" type="xml">
            <form edit="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="not id">
                        <button name="action_download" type="object" class="oe_stat_button" icon="fa-download">
                            <div class="o_stat_info"><span class="o_stat_text">Download</span></div>
                        </button>
                        <button name="action_open_thread" type="object" class="oe_stat_button" icon="fa-comments">
                            <div class="o_stat_info"><span class="o_stat_text">Thread</span></div>
                        </button>
                        <button name="action_open_message" type="object" class="oe_stat_button" icon="fa-comment">
                            <div class="o_stat_info"><span class="o_stat_text">Message</span></div>
                        </button>
                        <button name="action_open_patient" type="object" class="oe_stat_button" icon="fa-user">
                            <div class="o_stat_info"><span class="o_stat_text">Patient</span></div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="id"/></h1>
                    </div>

                    <div class="alert alert-info" role="alert">
                        Only PDF, JPEG, and PNG are accepted. Files are immutable after upload and are served through a controlled authorization route with no-cache headers.
                    </div>

                    <group>
                        <group string="Conversation">
                            <field name="thread_id" readonly="id"/>
                            <field name="message_id" readonly="id"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="File Evidence">
                            <field name="mimetype" readonly="1"/>
                            <field name="size_bytes" readonly="1"/>
                            <field name="sha256" readonly="1"/>
                            <field name="uploader_kind" readonly="1"/>
                            <field name="uploaded_by_user_id" readonly="1"/>
                            <field name="uploaded_at" readonly="1"/>
                        </group>
                    </group>

                    <field name="datas" filename="name" readonly="id"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telemedicine_attachment" model="ir.actions.act_window">
        <field name="name">Secure Shared Files</field>
        <field name="res_model">clinic.telemedicine.attachment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_telemedicine_attachment_search"/>
    </record>
</odoo>

