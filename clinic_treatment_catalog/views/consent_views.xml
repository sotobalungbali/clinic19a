<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_consent_template_search" model="ir.ui.view"><field name="name">clinic.consent.template.search</field><field name="model">clinic.consent.template</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="scope"/><field name="category"/><field name="treatment_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/></search></field></record>
    <record id="view_consent_template_list" model="ir.ui.view"><field name="name">clinic.consent.template.list</field><field name="model">clinic.consent.template</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="scope"/><field name="category"/><field name="treatment_id"/><field name="latest_version_id"/><field name="active"/></list></field></record>
    <record id="view_consent_template_form" model="ir.ui.view"><field name="name">clinic.consent.template.form</field><field name="model">clinic.consent.template</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1><field name="code"/></div><group><group><field name="scope"/><field name="category"/><field name="treatment_id"/><field name="validity_days"/></group><group><field name="requires_guardian"/><field name="requires_witness"/><field name="allow_reuse"/><field name="active"/></group></group><notebook><page string="Default Acknowledgements"><field name="default_item_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="label"/><field name="required"/><field name="default_value"/></list></field></page><page string="Versions"><field name="version_ids"><list><field name="version"/><field name="title"/><field name="effective_from"/><field name="effective_to"/><field name="state"/></list></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet></form></field></record>
    <record id="action_consent_template" model="ir.actions.act_window"><field name="name">Consent Templates</field><field name="res_model">clinic.consent.template</field><field name="view_mode">list,form</field></record>

    <record id="view_consent_template_item_search" model="ir.ui.view"><field name="name">clinic.consent.template.item.search</field><field name="model">clinic.consent.template.item</field><field name="arch" type="xml"><search><field name="template_id"/><field name="label"/><filter name="required" string="Required" domain="[('required','=',True)]"/></search></field></record>
    <record id="view_consent_template_item_list" model="ir.ui.view"><field name="name">clinic.consent.template.item.list</field><field name="model">clinic.consent.template.item</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="template_id"/><field name="label"/><field name="required"/><field name="default_value"/></list></field></record>
    <record id="view_consent_template_item_form" model="ir.ui.view"><field name="name">clinic.consent.template.item.form</field><field name="model">clinic.consent.template.item</field><field name="arch" type="xml"><form><sheet><group><field name="template_id"/><field name="sequence"/><field name="label"/><field name="required"/><field name="default_value"/><field name="notes"/></group></sheet></form></field></record>
    <record id="action_consent_template_item" model="ir.actions.act_window"><field name="name">Consent Template Items</field><field name="res_model">clinic.consent.template.item</field><field name="view_mode">list,form</field></record>

    <record id="view_consent_version_search" model="ir.ui.view"><field name="name">clinic.consent.template.version.search</field><field name="model">clinic.consent.template.version</field><field name="arch" type="xml"><search><field name="template_id"/><field name="title"/><field name="state"/><filter name="published" string="Published" domain="[('state','=','published')]"/><filter name="group_template" string="Template" context="{'group_by':'template_id'}"/></search></field></record>
    <record id="view_consent_version_list" model="ir.ui.view"><field name="name">clinic.consent.template.version.list</field><field name="model">clinic.consent.template.version</field><field name="arch" type="xml"><list><field name="template_id"/><field name="version"/><field name="title"/><field name="effective_from"/><field name="effective_to"/><field name="state"/></list></field></record>
    <record id="view_consent_version_form" model="ir.ui.view"><field name="name">clinic.consent.template.version.form</field><field name="model">clinic.consent.template.version</field><field name="arch" type="xml"><form><header><field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/></header><sheet><div class="oe_title"><h1><field name="title" placeholder="Consent version title"/></h1></div><group><field name="template_id"/><field name="version"/><field name="effective_from"/><field name="effective_to"/></group><notebook><page string="Consent Text"><field name="body_html"/></page><page string="Changelog"><field name="changelog"/></page></notebook></sheet></form></field></record>
    <record id="action_consent_version" model="ir.actions.act_window"><field name="name">Consent Versions</field><field name="res_model">clinic.consent.template.version</field><field name="view_mode">list,form</field></record>

    <record id="view_consent_request_search" model="ir.ui.view"><field name="name">clinic.consent.request.search</field><field name="model">clinic.consent.request</field><field name="arch" type="xml"><search><field name="reference"/><field name="patient_id"/><field name="template_id"/><field name="scope"/><field name="state"/><field name="branch_id"/><field name="company_id"/><filter name="signed" string="Signed" domain="[('state','=','signed')]"/><filter name="valid" string="Valid" domain="[('is_valid','=',True)]"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_template" string="Template" context="{'group_by':'template_id'}"/></search></field></record>
    <record id="view_consent_request_list" model="ir.ui.view"><field name="name">clinic.consent.request.list</field><field name="model">clinic.consent.request</field><field name="arch" type="xml"><list><field name="reference"/><field name="patient_id"/><field name="template_id"/><field name="scope"/><field name="state"/><field name="is_valid"/><field name="signed_at"/><field name="expires_at"/><field name="branch_id"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
    <record id="view_consent_request_form" model="ir.ui.view"><field name="name">clinic.consent.request.form</field><field name="model">clinic.consent.request</field><field name="arch" type="xml"><form>
        <header>
            <button name="action_request" type="object" string="Request" class="btn-primary" invisible="state not in ['draft','cancelled','expired']"/>
            <button name="action_mark_signed" type="object" string="Mark Signed" class="btn-primary" invisible="state not in ['requested','draft']"/>
            <button name="action_revoke" type="object" string="Revoke" invisible="state != 'signed'"/>
            <button name="action_expire" type="object" string="Expire" invisible="state != 'signed'"/>
            <button name="action_cancel" type="object" string="Cancel" invisible="state == 'signed'"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,requested,signed,revoked,expired,cancelled"/>
        </header>
        <sheet><div class="oe_title"><h1><field name="display_name" readonly="1"/></h1><field name="reference" readonly="1"/></div>
            <group><group string="Consent"><field name="patient_id"/><field name="template_id"/><field name="version_id"/><field name="title"/><field name="scope" readonly="1"/></group><group string="Context"><field name="branch_id"/><field name="staff_assignment_id"/><field name="created_by_id"/><field name="requested_by_id"/><field name="witness_staff_id"/><field name="company_id" groups="base.group_multi_company"/></group></group>
            <notebook><page string="Consent Content"><field name="content_html"/></page><page string="Acknowledgements"><field name="item_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="label"/><field name="required"/><field name="value"/><field name="notes"/></list></field></page><page string="Signatures"><group><field name="guardian_required"/><field name="guardian_name" invisible="not guardian_required"/><field name="guardian_relation" invisible="not guardian_required"/><field name="guardian_id_no" invisible="not guardian_required"/><field name="patient_signature"/><field name="guardian_signature" invisible="not guardian_required"/><field name="witness_signature"/></group></page><page string="E-Sign"><group><field name="e_sign_provider"/><field name="e_sign_status"/><field name="e_sign_reference"/><field name="e_sign_url"/><field name="e_sign_last_sync" readonly="1"/><field name="has_e_signature" readonly="1"/></group></page><page string="Validity"><group><field name="signed_at"/><field name="expires_at"/><field name="revoked_at"/><field name="revoke_reason"/><field name="is_valid" readonly="1"/><field name="validity_days" readonly="1"/></group></page><page string="Billing &amp; Files"><group><field name="invoice_id"/><field name="pdf_attachment_id"/><field name="attachment_count" readonly="1"/></group></page><page string="Notes"><field name="notes"/></page></notebook>
        </sheet><chatter/>
    </form></field></record>
    <record id="action_consent_request" model="ir.actions.act_window"><field name="name">Consent Requests</field><field name="res_model">clinic.consent.request</field><field name="view_mode">list,form</field></record>

    <record id="view_consent_request_item_search" model="ir.ui.view"><field name="name">clinic.consent.request.item.search</field><field name="model">clinic.consent.request.item</field><field name="arch" type="xml"><search><field name="request_id"/><field name="label"/><field name="value"/><filter name="required" string="Required" domain="[('required','=',True)]"/></search></field></record>
    <record id="view_consent_request_item_list" model="ir.ui.view"><field name="name">clinic.consent.request.item.list</field><field name="model">clinic.consent.request.item</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="request_id"/><field name="label"/><field name="required"/><field name="value"/></list></field></record>
    <record id="view_consent_request_item_form" model="ir.ui.view"><field name="name">clinic.consent.request.item.form</field><field name="model">clinic.consent.request.item</field><field name="arch" type="xml"><form><sheet><group><field name="request_id"/><field name="sequence"/><field name="label"/><field name="required"/><field name="value"/><field name="notes"/></group></sheet></form></field></record>
    <record id="action_consent_request_item" model="ir.actions.act_window"><field name="name">Consent Request Items</field><field name="res_model">clinic.consent.request.item</field><field name="view_mode">list,form</field></record>
</odoo>

