    <record id="view_treatment_attribute_value_list" model="ir.ui.view"><field name="name">clinic.treatment.attribute.value.list</field><field name="model">clinic.treatment.attribute.value</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="attribute_id"/><field name="delta_price"/><field name="delta_duration_minutes"/><field name="treatment_count"/><field name="active" optional="hide"/></list></field></record>
    <record id="view_treatment_attribute_value_form" model="ir.ui.view"><field name="name">clinic.treatment.attribute.value.form</field><field name="model">clinic.treatment.attribute.value</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_open_treatments" type="object" class="oe_stat_button" icon="fa-medkit"><field name="treatment_count" widget="statinfo" string="Treatments"/></button></div><div class="oe_title"><h1><field name="name"/></h1><field name="code" readonly="1"/></div><group><group><field name="attribute_id"/><field name="sequence"/><field name="color"/></group><group><field name="delta_price"/><field name="delta_duration_minutes"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></group></sheet><chatter/></form></field></record>
