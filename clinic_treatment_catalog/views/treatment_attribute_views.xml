<odoo>
    <record id="view_treatment_attribute_search" model="ir.ui.view"><field name="name">clinic.treatment.attribute.search</field><field name="model">clinic.treatment.attribute</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="technical_name"/><field name="value_type"/><field name="scope"/><field name="company_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/></search></field></record>
