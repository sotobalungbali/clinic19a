<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treatment_bundle_search" model="ir.ui.view"><field name="name">clinic.treatment.bundle.search</field><field name="model">clinic.treatment.bundle</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="pricing_policy"/><field name="company_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/><filter name="current" string="Currently Valid" domain="[('is_currently_valid','=',True)]"/></search></field></record>
    <record id="view_treatment_bundle_list" model="ir.ui.view"><field name="name">clinic.treatment.bundle.list</field><field name="model">clinic.treatment.bundle</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="pricing_policy"/><field name="base_price"/><field name="computed_sum_price" optional="show"/><field name="line_count"/><field name="total_sessions"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field></record>
    <record id="view_treatment_bundle_form" model="ir.ui.view"><field name="name">clinic.treatment.bundle.form</field><field name="model">clinic.treatment.bundle</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_open_treatments" type="object" class="oe_stat_button" icon="fa-medkit"><field name="treatment_count" widget="statinfo" string="Treatments"/></button></div><field name="image_1920" widget="image" class="oe_avatar"/><div class="oe_title"><h1><field name="name"/></h1><field name="code" readonly="1"/></div><group><group><field name="pricing_policy"/><field name="base_price"/><field name="minimum_price"/><field name="computed_sum_price" readonly="1"/></group><group><field name="valid_from"/><field name="valid_to"/><field name="is_currently_valid" readonly="1"/><field name="allow_online_sale"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></group><notebook><page string="Bundle Lines"><field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="line_type"/><field name="treatment_id" invisible="line_type != 'treatment'"/><field name="category_id" invisible="line_type != 'category'"/><field name="tag_ids" widget="many2many_tags" invisible="line_type != 'category'"/><field name="quantity"/><field name="price_policy"/><field name="effective_unit_price"/><field name="subtotal"/></list></field></page><page string="Service Product"><group><field name="product_tmpl_id"/><field name="product_id"/></group></page><page string="Description"><field name="description"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_treatment_bundle" model="ir.actions.act_window"><field name="name">Treatment Bundles</field><field name="res_model">clinic.treatment.bundle</field><field name="view_mode">list,form</field></record>

    <record id="view_treatment_bundle_line_search" model="ir.ui.view"><field name="name">clinic.treatment.bundle.line.search</field><field name="model">clinic.treatment.bundle.line</field><field name="arch" type="xml"><search><field name="bundle_id"/><field name="line_type"/><field name="treatment_id"/><field name="category_id"/><field name="company_id"/><filter name="group_bundle" string="Bundle" context="{'group_by':'bundle_id'}"/></search></field></record>
    <record id="view_treatment_bundle_line_list" model="ir.ui.view"><field name="name">clinic.treatment.bundle.line.list</field><field name="model">clinic.treatment.bundle.line</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="bundle_id"/><field name="line_type"/><field name="treatment_id"/><field name="category_id"/><field name="quantity"/><field name="effective_unit_price"/><field name="subtotal"/></list></field></record>
    <record id="view_treatment_bundle_line_form" model="ir.ui.view"><field name="name">clinic.treatment.bundle.line.form</field><field name="model">clinic.treatment.bundle.line</field><field name="arch" type="xml"><form><sheet><group><group><field name="bundle_id"/><field name="line_type"/><field name="treatment_id" invisible="line_type != 'treatment'"/><field name="category_id" invisible="line_type != 'category'"/><field name="tag_ids" widget="many2many_tags" invisible="line_type != 'category'"/></group><group><field name="quantity"/><field name="per_visit_limit"/><field name="allow_overage"/><field name="overage_unit_price" invisible="not allow_overage"/><field name="company_id" groups="base.group_multi_company" readonly="1"/></group></group><group string="Pricing"><field name="price_policy"/><field name="unit_price"/><field name="effective_unit_price" readonly="1"/><field name="subtotal" readonly="1"/></group><field name="notes"/></sheet></form></field></record>
    <record id="action_treatment_bundle_line" model="ir.actions.act_window"><field name="name">Bundle Lines</field><field name="res_model">clinic.treatment.bundle.line</field><field name="view_mode">list,form</field></record>
</odoo>

