<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treatment_category_search" model="ir.ui.view"><field name="name">clinic.treatment.category.search</field><field name="model">clinic.treatment.category</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="parent_id"/><field name="company_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/><filter name="group_parent" string="Parent" context="{'group_by':'parent_id'}"/></search></field></record>
    <record id="view_treatment_category_list" model="ir.ui.view"><field name="name">clinic.treatment.category.list</field><field name="model">clinic.treatment.category</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="code"/><field name="complete_name"/><field name="treatment_count"/><field name="child_count"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field></record>
    <record id="view_treatment_category_form" model="ir.ui.view"><field name="name">clinic.treatment.category.form</field><field name="model">clinic.treatment.category</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_open_treatments" type="object" class="oe_stat_button" icon="fa-medkit"><field name="treatment_count" widget="statinfo" string="Treatments"/></button></div><field name="image_1920" widget="image" class="oe_avatar"/><div class="oe_title"><h1><field name="name"/></h1><field name="code" readonly="1"/></div><group><group><field name="parent_id"/><field name="sequence"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group><group><field name="complete_name" readonly="1"/><field name="treatment_count" readonly="1"/><field name="child_count" readonly="1"/></group></group><notebook><page string="Subcategories"><field name="child_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="active"/></list></field></page><page string="Description"><field name="description"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_treatment_category" model="ir.actions.act_window"><field name="name">Treatment Categories</field><field name="res_model">clinic.treatment.category</field><field name="view_mode">list,form</field></record>

    <record id="view_treatment_tag_search" model="ir.ui.view"><field name="name">clinic.treatment.tag.search</field><field name="model">clinic.treatment.tag</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="scope"/><field name="company_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/><filter name="group_scope" string="Scope" context="{'group_by':'scope'}"/></search></field></record>
    <record id="view_treatment_tag_list" model="ir.ui.view"><field name="name">clinic.treatment.tag.list</field><field name="model">clinic.treatment.tag</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="emoji"/><field name="code"/><field name="name"/><field name="scope"/><field name="treatment_count"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field></record>
    <record id="view_treatment_tag_form" model="ir.ui.view"><field name="name">clinic.treatment.tag.form</field><field name="model">clinic.treatment.tag</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_open_treatments" type="object" class="oe_stat_button" icon="fa-medkit"><field name="treatment_count" widget="statinfo" string="Treatments"/></button></div><field name="image_1920" widget="image" class="oe_avatar"/><div class="oe_title"><h1><field name="name"/></h1><field name="code" readonly="1"/></div><group><group><field name="emoji"/><field name="scope"/><field name="sequence"/></group><group><field name="color"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></group><field name="description"/></sheet><chatter/></form></field></record>
    <record id="action_treatment_tag" model="ir.actions.act_window"><field name="name">Treatment Tags</field><field name="res_model">clinic.treatment.tag</field><field name="view_mode">list,form</field></record>
</odoo>

