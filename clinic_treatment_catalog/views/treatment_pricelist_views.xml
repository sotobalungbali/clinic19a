<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treatment_pricelist_search" model="ir.ui.view"><field name="name">clinic.treatment.pricelist.search</field><field name="model">clinic.treatment.pricelist</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="channel"/><field name="company_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/><filter name="current" string="Currently Valid" domain="[('is_currently_valid','=',True)]"/><filter name="group_channel" string="Channel" context="{'group_by':'channel'}"/></search></field></record>
    <record id="view_treatment_pricelist_list" model="ir.ui.view"><field name="name">clinic.treatment.pricelist.list</field><field name="model">clinic.treatment.pricelist</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="channel"/><field name="currency_id"/><field name="item_count"/><field name="treatment_count"/><field name="valid_from"/><field name="valid_to"/><field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/></list></field></record>
    <record id="view_treatment_pricelist_form" model="ir.ui.view"><field name="name">clinic.treatment.pricelist.form</field><field name="model">clinic.treatment.pricelist</field><field name="arch" type="xml"><form><sheet><div class="oe_button_box" name="button_box"><button name="action_open_items" type="object" class="oe_stat_button" icon="fa-list"><field name="item_count" widget="statinfo" string="Rules"/></button></div><div class="oe_title"><h1><field name="name"/></h1><field name="code" readonly="1"/></div><group><group><field name="channel"/><field name="valid_from"/><field name="valid_to"/><field name="is_currently_valid" readonly="1"/><field name="tag_ids" widget="many2many_tags"/></group><group><field name="currency_id"/><field name="rounding_policy"/><field name="tax_included"/><field name="product_pricelist_id"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></group><group string="Pricing Engines"><field name="apply_membership"/><field name="apply_promotions"/><field name="apply_surcharge"/><field name="apply_insurance"/></group><notebook><page string="Rules"><field name="item_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="scope"/><field name="treatment_id"/><field name="method"/><field name="fixed_price"/><field name="percent"/><field name="active"/></list></field></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_treatment_pricelist" model="ir.actions.act_window"><field name="name">Treatment Pricelists</field><field name="res_model">clinic.treatment.pricelist</field><field name="view_mode">list,form</field></record>

    <record id="view_treatment_pricelist_item_search" model="ir.ui.view"><field name="name">clinic.treatment.pricelist.item.search</field><field name="model">clinic.treatment.pricelist.item</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="pricelist_id"/><field name="scope"/><field name="treatment_id"/><field name="category_id"/><field name="channel"/><field name="company_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/><filter name="group_pricelist" string="Pricelist" context="{'group_by':'pricelist_id'}"/><filter name="group_scope" string="Scope" context="{'group_by':'scope'}"/></search></field></record>
    <record id="view_treatment_pricelist_item_list" model="ir.ui.view"><field name="name">clinic.treatment.pricelist.item.list</field><field name="model">clinic.treatment.pricelist.item</field><field name="arch" type="xml"><list><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="pricelist_id"/><field name="scope"/><field name="treatment_id"/><field name="method"/><field name="fixed_price"/><field name="percent"/><field name="channel"/><field name="active"/></list></field></record>
    <record id="view_treatment_pricelist_item_form" model="ir.ui.view"><field name="name">clinic.treatment.pricelist.item.form</field><field name="model">clinic.treatment.pricelist.item</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1><field name="code" readonly="1"/></div><group><group string="Scope"><field name="pricelist_id"/><field name="scope"/><field name="treatment_id" invisible="scope != 'treatment'"/><field name="category_id" invisible="scope != 'category'"/><field name="tag_ids" widget="many2many_tags"/><field name="exclude_tag_ids" widget="many2many_tags"/></group><group string="Applicability"><field name="channel"/><field name="min_qty"/><field name="max_qty"/><field name="min_amount"/><field name="valid_from"/><field name="valid_to"/><field name="active"/></group></group><notebook><page string="Price Calculation"><group><field name="base"/><field name="method"/><field name="fixed_price" invisible="method != 'fixed'"/><field name="percent" invisible="method != 'percent'"/><field name="amount_off"/><field name="surcharge"/><field name="markup_percent"/><field name="rounding_policy"/><field name="enforce_minimum_price"/></group></page><page string="Audience &amp; Timing"><group><field name="partner_category_ids" widget="many2many_tags"/><field name="weekdays_only"/><field name="weekend_only"/><field name="time_from"/><field name="time_to"/></group></page></notebook><group><field name="company_id" groups="base.group_multi_company" readonly="1"/><field name="currency_id" readonly="1"/><field name="treatment_count" readonly="1"/></group></sheet></form></field></record>
    <record id="action_treatment_pricelist_item" model="ir.actions.act_window"><field name="name">Treatment Price Rules</field><field name="res_model">clinic.treatment.pricelist.item</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_treatment_pricelist_item_search"/></record>
</odoo>

