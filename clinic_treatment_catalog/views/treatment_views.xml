<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_treatment_catalog_search" model="ir.ui.view">
        <field name="name">clinic.treatment.catalog.search</field>
        <field name="model">clinic.treatment.catalog</field>
        <field name="arch" type="xml">
            <search string="Treatments">
                <field name="code"/><field name="name"/><field name="category_id"/><field name="tag_ids"/><field name="company_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="current" string="Currently Valid" domain="[('is_currently_valid','=',True)]"/>
                <filter name="online" string="Online Booking" domain="[('allow_online_booking','=',True)]"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by':'category_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                <filter name="group_policy" string="Pricing Policy" context="{'group_by':'pricing_policy'}"/>
            </search>
        </field>
    </record>
    <record id="view_clinic_treatment_catalog_list" model="ir.ui.view">
        <field name="name">clinic.treatment.catalog.list</field><field name="model">clinic.treatment.catalog</field>
        <field name="arch" type="xml"><list string="Treatments" default_order="sequence,name">
            <field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="category_id"/><field name="duration_minutes"/>
            <field name="base_price"/><field name="minimum_price" optional="hide"/><field name="pricing_policy"/><field name="allow_online_booking" optional="hide"/>
            <field name="company_id" groups="base.group_multi_company"/><field name="active" optional="hide"/>
        </list></field>
    </record>
    <record id="view_clinic_treatment_catalog_form" model="ir.ui.view">
        <field name="name">clinic.treatment.catalog.form</field><field name="model">clinic.treatment.catalog</field>
        <field name="arch" type="xml"><form string="Treatment">
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_pricelist_items" type="object" class="oe_stat_button" icon="fa-money">
                        <field name="pricelist_item_count" widget="statinfo" string="Pricing Rules"/>
                    </button>
                </div>
                <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image':'image_1920'}"/>
                <div class="oe_title"><label for="name"/><h1><field name="name" placeholder="Treatment name"/></h1><div><field name="code" readonly="1"/></div></div>
                <group><group string="Classification"><field name="category_id"/><field name="tag_ids" widget="many2many_tags"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group>
                <group string="Scheduling"><field name="duration_value"/><field name="duration_uom"/><field name="duration_minutes" readonly="1"/><field name="allow_online_booking"/><field name="valid_from"/><field name="valid_to"/><field name="is_currently_valid" readonly="1"/></group></group>
                <notebook>
                    <page string="Pricing"><group><group><field name="pricing_policy"/><field name="base_price"/><field name="minimum_price"/></group><group><field name="surcharge_applicable"/><field name="insurance_applicable"/><field name="currency_id" readonly="1"/></group></group></page>
                    <page string="Service Product"><group><field name="product_tmpl_id"/><field name="product_id"/></group></page>
                    <page string="Description"><field name="description" placeholder="Treatment description, preparation, and service notes..."/></page>
                </notebook>
            </sheet><chatter/>
        </form></field>
    </record>
    <record id="action_treatment_tree" model="ir.actions.act_window">
        <field name="name">Treatments</field><field name="res_model">clinic.treatment.catalog</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_clinic_treatment_catalog_search"/>
    </record>

    <record id="view_clinic_treatment_public_search" model="ir.ui.view"><field name="name">clinic.treatment.search</field><field name="model">clinic.treatment</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="category_id"/><field name="company_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/></search></field></record>
    <record id="view_clinic_treatment_public_list" model="ir.ui.view"><field name="name">clinic.treatment.list</field><field name="model">clinic.treatment</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="category_id"/><field name="base_price"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></list></field></record>
    <record id="view_clinic_treatment_public_form" model="ir.ui.view"><field name="name">clinic.treatment.form</field><field name="model">clinic.treatment</field><field name="arch" type="xml"><form string="Treatment Public Facade"><sheet>
        <div class="oe_button_box" name="button_box"><button name="action_open_pricelist_items" type="object" class="oe_stat_button" icon="fa-money"><field name="pricelist_item_count" widget="statinfo" string="Pricing Rules"/></button></div>
        <div class="oe_title"><h1><field name="name"/></h1><field name="code" readonly="1"/></div>
        <group><group><field name="catalog_id"/><field name="category_id"/><field name="tag_ids" widget="many2many_tags"/></group><group><field name="base_price"/><field name="duration_minutes"/><field name="company_id" groups="base.group_multi_company"/><field name="active"/></group></group>
        <button name="action_open_catalog_record" type="object" string="Open Canonical Catalog Record" class="btn-secondary" icon="fa-external-link"/>
    </sheet></form></field></record>
    <record id="action_treatment_public" model="ir.actions.act_window"><field name="name">Public Treatment Facades</field><field name="res_model">clinic.treatment</field><field name="view_mode">list,form</field></record>
</odoo>

