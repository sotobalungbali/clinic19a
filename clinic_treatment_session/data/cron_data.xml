<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_treatment_session_reminder" model="ir.cron">
        <field name="name">Clinic Treatment Session: Send Reminders</field>
        <field name="model_id" ref="model_clinic_treatment_session"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_session_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <record id="cron_treatment_session_auto_no_show" model="ir.cron">
        <field name="name">Clinic Treatment Session: Auto No-show</field>
        <field name="model_id" ref="model_clinic_treatment_session"/>
        <field name="state">code</field>
        <field name="code">model.cron_mark_auto_no_show()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
