<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_treatment_session_reminders" model="ir.cron">
        <field name="name">Treatment Sessions: Reminder Checkpoints</field>
        <field name="model_id" ref="model_clinic_treatment_session"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_session_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_treatment_session_auto_no_show" model="ir.cron">
        <field name="name">Treatment Sessions: Auto No-show</field>
        <field name="model_id" ref="model_clinic_treatment_session"/>
        <field name="state">code</field>
        <field name="code">model.cron_mark_auto_no_show()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
