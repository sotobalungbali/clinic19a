<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_treatment_session_reminder" model="mail.template">
        <field name="name">Treatment Session Reminder</field>
        <field name="model_id" ref="model_clinic_treatment_session"/>
        <field name="subject">Treatment Session Reminder - {{ object.display_name }}</field>
        <field name="email_to">{{ object.patient_email or '' }}</field>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.patient_id.display_name or 'Patient'"/>,</p>
                <p>Your Treatment Session is scheduled for <t t-out="object.start_datetime"/>.</p>
            </div>
        </field>
    </record>
</odoo>
