<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_treatment_session" model="ir.module.category">
        <field name="name">ClinicOne Treatment Sessions</field>
        <field name="description">Treatment delivery, consumption and billing controls.</field>
        <field name="sequence">43</field>
    </record>

    <record id="privilege_treatment_session" model="res.groups.privilege">
        <field name="name">Treatment Sessions</field>
        <field name="category_id" ref="clinic_treatment_session.module_category_treatment_session"/>
        <field name="sequence">43</field>
    </record>

    <record id="group_treatment_session_user" model="res.groups">
        <field name="name">Treatment Session User</field>
        <field name="privilege_id" ref="clinic_treatment_session.privilege_treatment_session"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_treatment_session_clinician" model="res.groups">
        <field name="name">Treatment Session Clinician</field>
        <field name="privilege_id" ref="clinic_treatment_session.privilege_treatment_session"/>
        <field name="implied_ids" eval="[(4, ref('clinic_treatment_session.group_treatment_session_user'))]"/>
    </record>

    <record id="group_treatment_session_manager" model="res.groups">
        <field name="name">Treatment Session Manager</field>
        <field name="privilege_id" ref="clinic_treatment_session.privilege_treatment_session"/>
        <field name="implied_ids" eval="[(4, ref('clinic_treatment_session.group_treatment_session_clinician'))]"/>
    </record>

    <record id="rule_treatment_session_company_branch" model="ir.rule">
        <field name="name">Treatment Session: company and branch</field>
        <field name="model_id" ref="model_clinic_treatment_session"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('branch_id', '=', False), ('branch_id', 'in', user.allowed_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('clinic_treatment_session.group_treatment_session_user'))]"/>
    </record>

    <record id="rule_treatment_session_line_company_branch" model="ir.rule">
        <field name="name">Treatment Session Line: company and branch</field>
        <field name="model_id" ref="model_clinic_treatment_session_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('session_id.branch_id', '=', False), ('session_id.branch_id', 'in', user.allowed_branch_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('clinic_treatment_session.group_treatment_session_user'))]"/>
    </record>

    <record id="rule_treatment_session_stage_company" model="ir.rule">
        <field name="name">Treatment Session Stage: company</field>
        <field name="model_id" ref="model_clinic_treatment_session_stage"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('clinic_treatment_session.group_treatment_session_user'))]"/>
    </record>
</odoo>
