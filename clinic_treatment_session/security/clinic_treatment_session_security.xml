<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_treatment_session" model="ir.module.category">
        <field name="name">ClinicOne Treatment Session</field>
        <field name="sequence">82</field>
    </record>

    <record id="privilege_treatment_session" model="res.groups.privilege">
        <field name="name">ClinicOne Treatment Session</field>
        <field name="category_id" ref="clinic_treatment_session.module_category_treatment_session"/>
        <field name="sequence">82</field>
    </record>

    <record id="group_treatment_session_user" model="res.groups">
        <field name="name">Treatment Session User</field>
        <field name="privilege_id" ref="clinic_treatment_session.privilege_treatment_session"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_treatment_session_clinician" model="res.groups">
        <field name="name">Treatment Session Clinician</field>
        <field name="privilege_id" ref="clinic_treatment_session.privilege_treatment_session"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_treatment_session.group_treatment_session_user'))
        ]"/>
    </record>

    <record id="group_treatment_session_manager" model="res.groups">
        <field name="name">Treatment Session Manager</field>
        <field name="privilege_id" ref="clinic_treatment_session.privilege_treatment_session"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_treatment_session.group_treatment_session_clinician'))
        ]"/>
    </record>

    <record id="rule_treatment_session_user_scope" model="ir.rule">
        <field name="name">Treatment Session User: company and branch scope</field>
        <field name="model_id" ref="model_clinic_treatment_session"/>
        <field name="groups" eval="[Command.link(ref('clinic_treatment_session.group_treatment_session_user'))]"/>
        <field name="domain_force">[
            '&amp;',
            ('company_id', 'in', company_ids),
            '|',
            ('branch_id', '=', False),
            ('branch_id', 'in', user.allowed_branch_ids.ids)
        ]</field>
    </record>

    <record id="rule_treatment_session_manager_scope" model="ir.rule">
        <field name="name">Treatment Session Manager: company scope</field>
        <field name="model_id" ref="model_clinic_treatment_session"/>
        <field name="groups" eval="[Command.link(ref('clinic_treatment_session.group_treatment_session_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_treatment_session_line_user_scope" model="ir.rule">
        <field name="name">Treatment Session Line User: session branch scope</field>
        <field name="model_id" ref="model_clinic_treatment_session_line"/>
        <field name="groups" eval="[Command.link(ref('clinic_treatment_session.group_treatment_session_user'))]"/>
        <field name="domain_force">[
            '&amp;',
            ('company_id', 'in', company_ids),
            '|',
            ('session_id.branch_id', '=', False),
            ('session_id.branch_id', 'in', user.allowed_branch_ids.ids)
        ]</field>
    </record>

    <record id="rule_treatment_session_line_manager_scope" model="ir.rule">
        <field name="name">Treatment Session Line Manager: company scope</field>
        <field name="model_id" ref="model_clinic_treatment_session_line"/>
        <field name="groups" eval="[Command.link(ref('clinic_treatment_session.group_treatment_session_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_treatment_session_stage_user_scope" model="ir.rule">
        <field name="name">Treatment Session Stage User: company scope</field>
        <field name="model_id" ref="model_clinic_treatment_session_stage"/>
        <field name="groups" eval="[Command.link(ref('clinic_treatment_session.group_treatment_session_user'))]"/>
        <field name="domain_force">[
            '|',
            ('company_id', '=', False),
            ('company_id', 'in', company_ids)
        ]</field>
    </record>
</odoo>
