<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treatment_session_stage_search" model="ir.ui.view">
        <field name="name">clinic.treatment.session.stage.search</field>
        <field name="model">clinic.treatment.session.stage</field>
        <field name="arch" type="xml">
            <search string="Treatment Session Stages">
                <field name="name"/>
                <field name="technical_state"/>
                <field name="company_id"/>
                <filter name="default" string="Default" domain="[('is_default', '=', True)]"/>
                <group>
                    <filter name="group_state" string="Technical State" context="{'group_by': 'technical_state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_treatment_session_stage_list" model="ir.ui.view">
        <field name="name">clinic.treatment.session.stage.list</field>
        <field name="model">clinic.treatment.session.stage</field>
        <field name="arch" type="xml">
            <list string="Treatment Session Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_state"/>
                <field name="is_default"/>
                <field name="is_final"/>
                <field name="fold"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="sessions_count" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_treatment_session_stage_form" model="ir.ui.view">
        <field name="name">clinic.treatment.session.stage.form</field>
        <field name="model">clinic.treatment.session.stage</field>
        <field name="arch" type="xml">
            <form string="Treatment Session Stage">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object"
                                class="oe_stat_button" icon="fa-stethoscope">
                            <field name="sessions_count" widget="statinfo" string="Sessions"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="technical_state"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="is_default"/>
                            <field name="is_final"/>
                            <field name="fold"/>
                            <field name="active"/>
                            <field name="color"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_treatment_session_stages" model="ir.actions.act_window">
        <field name="name">Treatment Session Stages</field>
        <field name="res_model">clinic.treatment.session.stage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_treatment_session_stage_search"/>
    </record>
</odoo>
