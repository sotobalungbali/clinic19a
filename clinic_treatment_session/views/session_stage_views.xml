<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treatment_session_stage_search" model="ir.ui.view">
        <field name="name">clinic.treatment.session.stage.search</field>
        <field name="model">clinic.treatment.session.stage</field>
        <field name="arch" type="xml">
            <search string="Treatment Session Stages">
                <field name="name"/>
                <field name="technical_state"/>
                <field name="company_id"/>
                <filter name="default"
                        string="Default"
                        domain="[('is_default','=',True)]"/>
                <filter name="final"
                        string="Final"
                        domain="[('is_final','=',True)]"/>
                <separator/>
                <filter name="group_state"
                        string="Technical State"
                        context="{'group_by':'technical_state'}"/>
                <filter name="group_company"
                        string="Company"
                        context="{'group_by':'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_treatment_session_stage_list" model="ir.ui.view">
        <field name="name">clinic.treatment.session.stage.list</field>
        <field name="model">clinic.treatment.session.stage</field>
        <field name="arch" type="xml">
            <list default_order="sequence,id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="sessions_count"/>
                <field name="is_default"/>
                <field name="is_final"/>
                <field name="fold"/>
                <field name="active"/>
                <button name="action_view_sessions"
                        type="object"
                        string="Sessions"
                        icon="fa-stethoscope"/>
            </list>
        </field>
    </record>

    <record id="view_treatment_session_stage_form" model="ir.ui.view">
        <field name="name">clinic.treatment.session.stage.form</field>
        <field name="model">clinic.treatment.session.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-stethoscope">
                            <field name="sessions_count"
                                   widget="statinfo"
                                   string="Sessions"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Workflow Mapping">
                            <field name="technical_state"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_default"/>
                            <field name="is_final"/>
                            <field name="fold"/>
                            <field name="active"/>
                        </group>
                        <group string="Kanban Legend">
                            <field name="color"/>
                            <field name="legend_normal"/>
                            <field name="legend_done"/>
                            <field name="legend_blocked"/>
                        </group>
                    </group>

                    <group string="Guidance">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_treatment_session_stages" model="ir.actions.act_window">
        <field name="name">Session Stages</field>
        <field name="res_model">clinic.treatment.session.stage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_treatment_session_stage_search"/>
    </record>
</odoo>
