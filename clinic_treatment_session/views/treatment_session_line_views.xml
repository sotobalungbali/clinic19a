<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treatment_session_line_search" model="ir.ui.view">
        <field name="name">clinic.treatment.session.line.search</field>
        <field name="model">clinic.treatment.session.line</field>
        <field name="arch" type="xml">
            <search string="Treatment Session Lines">
                <field name="session_id"/>
                <field name="patient_id"/>
                <field name="clinic_doctor_id"/>
                <field name="product_id"/>
                <filter name="stock_relevant" string="Stock Relevant" domain="[('is_stock_relevant', '=', True)]"/>
                <filter name="consumed" string="Consumed" domain="[('consumption_state', '=', 'consumed')]"/>
                <filter name="billable" string="Billable" domain="[('is_billable', '=', True)]"/>
                <group>
                    <filter name="group_session" string="Session" context="{'group_by': 'session_id'}"/>
                    <filter name="group_usage" string="Usage Type" context="{'group_by': 'usage_type'}"/>
                    <filter name="group_consumption" string="Consumption" context="{'group_by': 'consumption_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_treatment_session_line_list" model="ir.ui.view">
        <field name="name">clinic.treatment.session.line.list</field>
        <field name="model">clinic.treatment.session.line</field>
        <field name="arch" type="xml">
            <list string="Treatment Session Lines">
                <field name="session_id"/>
                <field name="patient_id"/>
                <field name="usage_type"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="consumed_qty"/>
                <field name="consumption_state"/>
                <field name="is_billable"/>
                <field name="price_subtotal" sum="Subtotal"/>
                <field name="stock_move_id"/>
            </list>
        </field>
    </record>

    <record id="view_treatment_session_line_form" model="ir.ui.view">
        <field name="name">clinic.treatment.session.line.form</field>
        <field name="model">clinic.treatment.session.line</field>
        <field name="arch" type="xml">
            <form string="Treatment Session Line">
                <header>
                    <button name="action_mark_ready" type="object" string="Mark Ready"
                            class="btn-primary"
                            groups="clinic_treatment_session.group_treatment_session_clinician"
                            invisible="display_type != 'line' or consumption_state != 'planned'"/>
                    <button name="action_mark_consumed" type="object" string="Mark Consumed"
                            class="btn-primary"
                            groups="clinic_treatment_session.group_treatment_session_clinician"
                            invisible="display_type != 'line' or consumption_state == 'consumed'"/>
                    <button name="action_reset_consumption" type="object"
                            string="Reset Consumption"
                            groups="clinic_treatment_session.group_treatment_session_clinician"
                            invisible="display_type != 'line' or consumption_state == 'planned'"/>
                    <button name="action_open_stock_move" type="object"
                            string="Open Stock Move" invisible="not stock_move_id"/>
                    <field name="consumption_state" widget="statusbar"
                           statusbar_visible="planned,ready,consumed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="display_type"/>
                            <field name="usage_type"/>
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="product_uom_id"/>
                            <field name="quantity"/>
                            <field name="consumed_qty"/>
                        </group>
                        <group>
                            <field name="is_billable"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="price_subtotal" readonly="1"/>
                            <field name="price_total" readonly="1"/>
                            <field name="stock_move_id" readonly="1"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="package_line_id"/>
                        <field name="referral_id"/>
                        <field name="note_internal"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_treatment_session_lines" model="ir.actions.act_window">
        <field name="name">Treatment Session Lines</field>
        <field name="res_model">clinic.treatment.session.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_treatment_session_line_search"/>
    </record>
</odoo>
