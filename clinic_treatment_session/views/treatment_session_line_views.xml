<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treatment_session_line_search" model="ir.ui.view">
        <field name="name">clinic.treatment.session.line.search</field>
        <field name="model">clinic.treatment.session.line</field>
        <field name="arch" type="xml">
            <search string="Treatment Session Lines">
                <field name="session_id"/>
                <field name="patient_id"/>
                <field name="product_id"/>
                <field name="treatment_id"/>
                <field name="referral_id"/>
                <field name="stock_move_id"/>
                <filter name="stock_relevant"
                        string="Stock Relevant"
                        domain="[('is_stock_relevant','=',True)]"/>
                <filter name="ready"
                        string="Ready"
                        domain="[('consumption_state','=','ready')]"/>
                <filter name="consumed"
                        string="Consumed"
                        domain="[('consumption_state','=','consumed')]"/>
                <filter name="billable"
                        string="Billable"
                        domain="[('is_billable','=',True)]"/>
                <separator/>
                <filter name="group_session" string="Session" context="{'group_by':'session_id'}"/>
                <filter name="group_usage" string="Usage Type" context="{'group_by':'usage_type'}"/>
                <filter name="group_state" string="Consumption Status" context="{'group_by':'consumption_state'}"/>
                <filter name="group_product" string="Product" context="{'group_by':'product_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_treatment_session_line_list" model="ir.ui.view">
        <field name="name">clinic.treatment.session.line.list</field>
        <field name="model">clinic.treatment.session.line</field>
        <field name="arch" type="xml">
            <list default_order="session_id desc,sequence,id"
                  decoration-success="consumption_state == 'consumed'"
                  decoration-warning="consumption_state == 'ready'"
                  decoration-muted="display_type in ('section','note')">
                <field name="session_id"/>
                <field name="patient_id"/>
                <field name="usage_type"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="quantity"/>
                <field name="consumed_qty"/>
                <field name="product_uom_id"/>
                <field name="is_stock_relevant"/>
                <field name="is_billable"/>
                <field name="price_total" sum="Total"/>
                <field name="consumption_state" widget="badge"/>
                <field name="stock_move_id"/>
                <button name="action_mark_ready"
                        type="object"
                        string="Ready"
                        icon="fa-check"
                        groups="clinic_treatment_session.group_treatment_session_clinician"
                        invisible="display_type != 'line' or consumption_state != 'planned'"/>
                <button name="action_mark_consumed"
                        type="object"
                        string="Consume"
                        icon="fa-exchange"
                        groups="clinic_treatment_session.group_treatment_session_clinician"
                        invisible="display_type != 'line' or consumption_state not in ('planned','ready')"/>
                <button name="action_open_stock_move"
                        type="object"
                        string="Stock"
                        icon="fa-external-link"
                        invisible="not stock_move_id"/>
            </list>
        </field>
    </record>

    <record id="view_treatment_session_line_form" model="ir.ui.view">
        <field name="name">clinic.treatment.session.line.form</field>
        <field name="model">clinic.treatment.session.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_ready"
                            type="object"
                            string="Mark Ready"
                            class="btn-primary"
                            groups="clinic_treatment_session.group_treatment_session_clinician"
                            invisible="display_type != 'line' or consumption_state != 'planned'"/>
                    <button name="action_mark_consumed"
                            type="object"
                            string="Consume"
                            class="btn-primary"
                            groups="clinic_treatment_session.group_treatment_session_clinician"
                            invisible="display_type != 'line' or consumption_state not in ('planned','ready')"/>
                    <button name="action_reset_consumption"
                            type="object"
                            string="Reset Consumption"
                            groups="clinic_treatment_session.group_treatment_session_clinician"
                            invisible="consumption_state == 'planned'"/>
                    <field name="consumption_state"
                           widget="statusbar"
                           readonly="1"
                           statusbar_visible="planned,ready,consumed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_stock_move"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange"
                                invisible="not stock_move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Stock Move</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <group>
                        <group string="Session and Usage">
                            <field name="session_id"/>
                            <field name="display_type"/>
                            <field name="usage_type"/>
                            <field name="product_id"/>
                            <field name="product_uom_id"/>
                            <field name="quantity"/>
                            <field name="consumed_qty"/>
                        </group>
                        <group string="Billing">
                            <field name="is_billable"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_unit"/>
                            <field name="discount"/>
                            <field name="tax_ids" widget="many2many_tags"/>
                            <field name="price_subtotal" readonly="1"/>
                            <field name="price_total" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Inventory">
                            <group>
                                <field name="is_stock_relevant" readonly="1"/>
                                <field name="location_id"/>
                                <field name="location_dest_id"/>
                                <field name="stock_move_id" readonly="1"/>
                                <field name="date_consumed" readonly="1"/>
                            </group>
                        </page>
                        <page string="Coverage and Attribution">
                            <group>
                                <field name="package_line_id"/>
                                <field name="referral_id"/>
                            </group>
                        </page>
                        <page string="Internal Notes">
                            <field name="note_internal"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_treatment_session_lines" model="ir.actions.act_window">
        <field name="name">Session Lines</field>
        <field name="res_model">clinic.treatment.session.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_treatment_session_line_search"/>
    </record>
</odoo>
