<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_treatment_session_search" model="ir.ui.view">
        <field name="name">clinic.treatment.session.search</field>
        <field name="model">clinic.treatment.session</field>
        <field name="arch" type="xml">
            <search string="Treatment Sessions">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="clinic_doctor_id"/>
                <field name="doctor_id"/>
                <field name="treatment_id"/>
                <field name="booking_id"/>
                <field name="room_id"/>
                <field name="branch_id"/>
                <filter name="my_sessions" string="My Sessions" domain="[('doctor_user_id', '=', uid)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="no_show" string="No-show" domain="[('state', '=', 'no_show')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter name="overtime" string="Overtime" domain="[('is_overtime', '=', True)]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_room" string="Room" context="{'group_by': 'room_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'start_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_clinic_treatment_session_list" model="ir.ui.view">
        <field name="name">clinic.treatment.session.list</field>
        <field name="model">clinic.treatment.session</field>
        <field name="arch" type="xml">
            <list string="Treatment Sessions"
                  decoration-info="state == 'confirmed'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'done'"
                  decoration-danger="state in ('cancelled', 'no_show')">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="treatment_id" optional="show"/>
                <field name="branch_id" optional="show"/>
                <field name="room_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime" optional="show"/>
                <field name="duration_planned" optional="hide"/>
                <field name="amount_total" optional="show" sum="Total"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_treatment_session_form" model="ir.ui.view">
        <field name="name">clinic.treatment.session.form</field>
        <field name="model">clinic.treatment.session</field>
        <field name="arch" type="xml">
            <form string="Treatment Session">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary"
                            groups="clinic_treatment_session.group_treatment_session_clinician"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_done" type="object" string="Complete"
                            class="btn-primary"
                            groups="clinic_treatment_session.group_treatment_session_clinician"
                            invisible="state != 'in_progress'"/>
                    <button name="action_no_show" type="object" string="No-show"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'no_show', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            groups="clinic_treatment_session.group_treatment_session_manager"
                            invisible="state not in ('cancelled', 'no_show')"/>
                    <button name="action_create_clinic_billing" type="object"
                            string="Create Clinic Billing"
                            groups="clinic_treatment_session.group_treatment_session_manager"
                            invisible="state != 'done' or billing_invoice_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done,no_show,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_booking" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                invisible="not booking_id">
                            <span class="o_stat_text">Booking</span>
                        </button>
                        <button name="action_view_encounter" type="object"
                                class="oe_stat_button" icon="fa-stethoscope"
                                invisible="not encounter_id">
                            <span class="o_stat_text">Encounter</span>
                        </button>
                        <button name="action_view_referral" type="object"
                                class="oe_stat_button" icon="fa-share-alt"
                                invisible="not referral_id">
                            <span class="o_stat_text">Referral</span>
                        </button>
                        <button name="action_view_stock_moves" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="stock_move_count" widget="statinfo" string="Stock Moves"/>
                        </button>
                        <button name="action_view_clinic_billing" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not billing_invoice_id">
                            <span class="o_stat_text">Clinic Billing</span>
                        </button>
                        <button name="action_view_attachments" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <field name="attachment_count" widget="statinfo" string="Attachments"/>
                        </button>
                        <button name="action_view_audit_events" type="object"
                                class="oe_stat_button" icon="fa-shield">
                            <field name="audit_event_count" widget="statinfo" string="Audit Events"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Cancelled"
                            bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="No-show"
                            bg_color="text-bg-warning" invisible="state != 'no_show'"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Patient and Provider">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="patient_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="clinic_patient_id" readonly="1"/>
                            <field name="clinic_doctor_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="doctor_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="doctor_user_id" invisible="1"/>
                        </group>
                        <group string="Treatment and Scheduling">
                            <field name="treatment_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="booking_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="room_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="stage_id"/>
                            <field name="start_datetime" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="end_datetime" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="duration_planned" readonly="state not in ('draft', 'confirmed')"/>
                        </group>
                    </group>

                    <group string="Execution">
                        <group>
                            <field name="actual_start_datetime" readonly="1"/>
                            <field name="actual_end_datetime" readonly="1"/>
                            <field name="execution_duration_minutes" readonly="1"/>
                            <field name="duration_variance_minutes" readonly="1"/>
                            <field name="is_overtime" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_untaxed" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="billing_invoice_id" readonly="1"/>
                            <field name="billing_state" readonly="1"/>
                            <field name="is_fully_invoiced" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Session Lines">
                            <field name="line_ids" readonly="state in ('done', 'cancelled', 'no_show')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="display_type"/>
                                    <field name="usage_type"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="consumed_qty"/>
                                    <field name="consumption_state"/>
                                    <field name="is_billable"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="price_subtotal" readonly="1"/>
                                    <field name="stock_move_id" readonly="1" optional="hide"/>
                                    <button name="action_mark_ready" type="object"
                                            string="Ready" icon="fa-check"
                                            invisible="display_type != 'line' or consumption_state != 'planned'"/>
                                    <button name="action_mark_consumed" type="object"
                                            string="Consume" icon="fa-cubes"
                                            invisible="display_type != 'line' or consumption_state == 'consumed'"/>
                                    <button name="action_open_stock_move" type="object"
                                            string="Move" icon="fa-exchange"
                                            invisible="not stock_move_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Clinical Notes">
                            <group>
                                <field name="chief_complaint"/>
                                <field name="objective_notes"/>
                                <field name="assessment"/>
                                <field name="plan"/>
                                <field name="contraindication_flag"/>
                            </group>
                        </page>
                        <page string="Coverage and Referral">
                            <group>
                                <field name="encounter_id"/>
                                <field name="referral_id"/>
                                <field name="package_allocation_id"/>
                                <field name="package_allocation_line_id"/>
                                <field name="package_usage_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <group>
                                <field name="note_internal"/>
                                <field name="note_public"/>
                                <field name="cancellation_reason" invisible="state != 'cancelled'"/>
                                <field name="no_show_reason" invisible="state != 'no_show'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_clinic_treatment_session_kanban" model="ir.ui.view">
        <field name="name">clinic.treatment.session.kanban</field>
        <field name="model">clinic.treatment.session</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="room_id"/>
                <field name="start_datetime"/>
                <field name="state"/>
                <field name="stage_id"/>
                <templates>
                    <t t-name="card">
                        <div class="fw-bold"><field name="name"/></div>
                        <div><field name="patient_id"/></div>
                        <div class="text-muted"><field name="start_datetime"/></div>
                        <div><field name="doctor_id"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_clinic_treatment_session_calendar" model="ir.ui.view">
        <field name="name">clinic.treatment.session.calendar</field>
        <field name="model">clinic.treatment.session</field>
        <field name="arch" type="xml">
            <calendar string="Treatment Sessions"
                      date_start="start_datetime" date_stop="end_datetime"
                      color="doctor_id" mode="week">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="room_id"/>
                <field name="treatment_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_clinic_treatment_session_pivot" model="ir.ui.view">
        <field name="name">clinic.treatment.session.pivot</field>
        <field name="model">clinic.treatment.session</field>
        <field name="arch" type="xml">
            <pivot string="Treatment Session Analysis">
                <field name="start_datetime" type="row" interval="month"/>
                <field name="branch_id" type="row"/>
                <field name="doctor_id" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="duration_planned" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_clinic_treatment_session_graph" model="ir.ui.view">
        <field name="name">clinic.treatment.session.graph</field>
        <field name="model">clinic.treatment.session</field>
        <field name="arch" type="xml">
            <graph string="Treatment Sessions" type="bar">
                <field name="start_datetime" interval="month"/>
                <field name="state"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_clinic_treatment_session" model="ir.actions.act_window">
        <field name="name">Treatment Sessions</field>
        <field name="res_model">clinic.treatment.session</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_clinic_treatment_session_search"/>
    </record>

    <record id="action_treatment_session_analysis" model="ir.actions.act_window">
        <field name="name">Treatment Session Analysis</field>
        <field name="res_model">clinic.treatment.session</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_clinic_treatment_session_search"/>
    </record>
</odoo>
