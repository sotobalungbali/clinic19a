            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_clinic_vitals_intake_company" model="ir.rule">
            <field name="name">Vitals Intake: allowed companies</field>
            <field name="model_id" ref="model_clinic_vitals_intake"/>
