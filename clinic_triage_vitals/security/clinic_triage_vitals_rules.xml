<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_clinic_triage_level_company" model="ir.rule">
            <field name="name">Triage Level: allowed companies</field>
            <field name="model_id" ref="model_clinic_triage_level"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_clinic_triage_tag_company" model="ir.rule">
