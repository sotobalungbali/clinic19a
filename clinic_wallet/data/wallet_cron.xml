<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_wallet_expiry_notify" model="ir.cron">
        <field name="name">Clinic Wallet: Expiry Reminders</field>
        <field name="model_id" ref="model_clinic_wallet"/>
        <field name="state">code</field>
        <field name="code">model._cron_expiry_notify()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_wallet_rule_expiry" model="ir.cron">
        <field name="name">Clinic Wallet: Expire Usage Rules</field>
        <field name="model_id" ref="model_clinic_wallet_rule"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_expire_rules()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>



