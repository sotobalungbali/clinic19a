<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_clinic_wallet" model="ir.module.category">
        <field name="name">ClinicOne Patient Wallet</field>
        <field name="sequence">50</field>
    </record>
    <record id="privilege_clinic_wallet" model="res.groups.privilege">
        <field name="name">ClinicOne Patient Wallet</field>
        <field name="category_id" ref="clinic_wallet.module_category_clinic_wallet"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_wallet_user" model="res.groups">
        <field name="name">Wallet User</field>
        <field name="privilege_id" ref="clinic_wallet.privilege_clinic_wallet"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_wallet_accountant" model="res.groups">
        <field name="name">Wallet Accountant</field>
        <field name="privilege_id" ref="clinic_wallet.privilege_clinic_wallet"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('clinic_wallet.group_wallet_user')),
            Command.link(ref('account.group_account_user'))
        ]"/>
    </record>
    <record id="group_wallet_manager" model="res.groups">
        <field name="name">Wallet Manager</field>
        <field name="privilege_id" ref="clinic_wallet.privilege_clinic_wallet"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('clinic_wallet.group_wallet_accountant'))]"/>
    </record>

    <!-- Internal users are always restricted to their allowed companies. -->
    <record id="rule_wallet_company" model="ir.rule">
        <field name="name">Wallet: allowed companies</field>
        <field name="model_id" ref="model_clinic_wallet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_wallet.group_wallet_user'))]"/>
    </record>
    <record id="rule_wallet_transaction_company" model="ir.rule">
        <field name="name">Wallet Transaction: allowed companies</field>
        <field name="model_id" ref="model_clinic_wallet_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_wallet.group_wallet_user'))]"/>
    </record>
    <record id="rule_wallet_rule_company" model="ir.rule">
        <field name="name">Wallet Rule: allowed companies</field>
        <field name="model_id" ref="model_clinic_wallet_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_wallet.group_wallet_user'))]"/>
    </record>
    <record id="rule_wallet_approver_company" model="ir.rule">
        <field name="name">Wallet Approver: allowed companies</field>
        <field name="model_id" ref="model_clinic_wallet_portal_mgr_approver"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_wallet.group_wallet_manager'))]"/>
    </record>
    <record id="rule_wallet_request_company" model="ir.rule">
        <field name="name">Wallet Request: allowed companies</field>
        <field name="model_id" ref="model_clinic_wallet_portal_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('clinic_wallet.group_wallet_user'))]"/>
    </record>

    <!-- Portal users can only see their commercial partner's wallet data. -->
    <record id="rule_wallet_portal_own" model="ir.rule">
        <field name="name">Wallet Portal: own wallet</field>
        <field name="model_id" ref="model_clinic_wallet"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
    <record id="rule_wallet_transaction_portal_own" model="ir.rule">
        <field name="name">Wallet Transaction Portal: own transactions</field>
        <field name="model_id" ref="model_clinic_wallet_transaction"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
    <record id="rule_wallet_request_portal_own" model="ir.rule">
        <field name="name">Wallet Request Portal: own requests</field>
        <field name="model_id" ref="model_clinic_wallet_portal_request"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
    </record>
</odoo>




