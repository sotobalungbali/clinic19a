<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wallet_operation_wizard_form" model="ir.ui.view">
        <field name="name">clinic.wallet.operation.wizard.form</field>
        <field name="model">clinic.wallet.operation.wizard</field>
        <field name="arch" type="xml">
            <form string="Wallet Operation">
                <sheet>
                    <div class="oe_title"><h2><field name="operation_type" readonly="1"/></h2></div>
                    <group>
                        <group string="Wallet">
                            <field name="wallet_id"/>
                            <field name="partner_id"/>
                            <field name="available_balance"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Operation">
                            <field name="amount"/>
                            <field name="journal_id" options="{'no_create_edit': True}"/>
                            <field name="reference"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Reason / memo..."/>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Post Operation" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>




