<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wallet_rule_search" model="ir.ui.view">
        <field name="name">clinic.wallet.rule.search</field>
        <field name="model">clinic.wallet.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="wallet_id"/>
                <field name="company_id"/>
                <field name="scope"/>
                <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
                <filter name="filter_global" string="Global" domain="[('wallet_id','=',False)]"/>
                <filter name="filter_specific" string="Wallet Specific" domain="[('wallet_id','!=',False)]"/>
                <group>
                    <filter name="group_scope" string="Scope" context="{'group_by':'scope'}"/>
                    <filter name="group_wallet" string="Wallet" context="{'group_by':'wallet_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                    <filter name="group_state" string="Rule Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wallet_rule_list" model="ir.ui.view">
        <field name="name">clinic.wallet.rule.list</field>
        <field name="model">clinic.wallet.rule</field>
        <field name="arch" type="xml">
            <list string="Wallet Usage Rules" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="wallet_id" optional="show"/>
                <field name="scope"/>
                <field name="state" widget="badge"/>
                <field name="min_amount" optional="hide"/>
                <field name="max_amount" optional="show"/>
                <field name="daily_amount_limit" optional="hide"/>
                <field name="monthly_amount_limit" optional="hide"/>
                <field name="date_end" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_wallet_rule_form" model="ir.ui.view">
        <field name="name">clinic.wallet.rule.form</field>
        <field name="model">clinic.wallet.rule</field>
        <field name="arch" type="xml">
            <form string="Wallet Usage Rule">
                <header>
                    <button name="action_activate" type="object" string="Activate" class="btn-primary" groups="clinic_wallet.group_wallet_manager" invisible="active"/>
                    <button name="action_deactivate" type="object" string="Deactivate" groups="clinic_wallet.group_wallet_manager" invisible="not active"/>
                    <field name="state" widget="statusbar" statusbar_visible="upcoming,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Ownership &amp; Scope">
                            <field name="active" invisible="1"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="wallet_id" options="{'no_create_edit': True}"/>
                            <field name="scope"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Validity Window">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="weekdays"/>
                            <field name="time_start" widget="float_time"/>
                            <field name="time_end" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Eligibility">
                            <group>
                                <field name="product_category_ids" widget="many2many_tags"/>
                                <field name="product_ids" widget="many2many_tags"/>
                                <field name="membership_tier_ids" widget="many2many_tags"/>
                                <field name="partner_category_ids" widget="many2many_tags"/>
                                <field name="blacklist_partner_ids" widget="many2many_tags" groups="clinic_wallet.group_wallet_manager"/>
                            </group>
                        </page>
                        <page string="Limits &amp; Quotas">
                            <group>
                                <group string="Per Transaction">
                                    <field name="min_amount"/>
                                    <field name="max_amount"/>
                                    <field name="max_ratio_per_invoice"/>
                                </group>
                                <group string="Daily / Monthly">
                                    <field name="daily_amount_limit"/>
                                    <field name="daily_tx_limit"/>
                                    <field name="monthly_amount_limit"/>
                                    <field name="monthly_tx_limit"/>
                                </group>
                            </group>
                        </page>
                        <page string="Compliance">
                            <field name="last_violation_note" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wallet_rules" model="ir.actions.act_window">
        <field name="name">Usage Rules</field>
        <field name="res_model">clinic.wallet.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wallet_rule_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>




