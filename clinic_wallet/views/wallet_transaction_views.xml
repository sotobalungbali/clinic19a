<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wallet_transaction_search" model="ir.ui.view">
        <field name="name">clinic.wallet.transaction.search</field>
        <field name="model">clinic.wallet.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="wallet_id"/>
                <field name="partner_id"/>
                <field name="reference"/>
                <field name="move_id"/>
                <filter name="filter_posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="filter_reserved" string="Reserved" domain="[('state','=','reserved')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_canceled" string="Canceled" domain="[('state','=','canceled')]"/>
                <separator/>
                <filter name="filter_topup" string="Top-Up" domain="[('transaction_type','=','topup')]"/>
                <filter name="filter_redeem" string="Redeem" domain="[('transaction_type','=','redeem')]"/>
                <filter name="filter_refund" string="Refund" domain="[('transaction_type','=','refund')]"/>
                <filter name="filter_adjustment" string="Adjustments" domain="[('transaction_type','in',('adjust_in','adjust_out'))]"/>
                <group>
                    <filter name="group_wallet" string="Wallet" context="{'group_by':'wallet_id'}"/>
                    <filter name="group_partner" string="Patient / Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by':'transaction_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_month" string="Month" context="{'group_by':'date:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_wallet_transaction_list" model="ir.ui.view">
        <field name="name">clinic.wallet.transaction.list</field>
        <field name="model">clinic.wallet.transaction</field>
        <field name="arch" type="xml">
            <list string="Wallet Transactions" create="0" decoration-success="state == 'posted'" decoration-warning="state == 'reserved'" decoration-muted="state == 'canceled'">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="wallet_id" optional="show"/>
                <field name="transaction_type"/>
                <field name="state" widget="badge"/>
                <field name="amount" sum="Amount"/>
                <field name="amount_signed" sum="Net Movement"/>
                <field name="reference" optional="show"/>
                <field name="billing_model" optional="hide"/>
                <field name="billing_id" optional="hide"/>
                <field name="move_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_wallet_transaction_form" model="ir.ui.view">
        <field name="name">clinic.wallet.transaction.form</field>
        <field name="model">clinic.wallet.transaction</field>
        <field name="arch" type="xml">
            <form string="Wallet Transaction">
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary" groups="clinic_wallet.group_wallet_accountant" invisible="state not in ('draft','reserved')"/>
                    <button name="action_set_reserved" type="object" string="Reserve" groups="clinic_wallet.group_wallet_manager" invisible="state != 'draft' or transaction_type != 'redeem'"/>
                    <button name="action_cancel" type="object" string="Cancel" groups="clinic_wallet.group_wallet_accountant" invisible="state not in ('draft','reserved')"/>
                    <button name="action_reverse" type="object" string="Reverse" groups="clinic_wallet.group_wallet_manager" invisible="state != 'posted' or reversal_tx_id" confirm="Create and post a reversing Wallet transaction?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reserved,posted,canceled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_move" type="object" class="oe_stat_button" icon="fa-book" invisible="not move_id" string="Journal Entry"/>
                        <button name="action_view_wallet" type="object" class="oe_stat_button" icon="fa-credit-card" string="Wallet"/>
                    </div>
                    <widget name="web_ribbon" title="POSTED" bg_color="text-bg-success" invisible="state != 'posted'"/>
                    <widget name="web_ribbon" title="RESERVED" bg_color="text-bg-warning" invisible="state != 'reserved'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Transaction">
                            <field name="wallet_id" readonly="state != 'draft'" options="{'no_create_edit': True}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="transaction_type" readonly="state != 'draft'"/>
                            <field name="date" readonly="state == 'posted'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="amount_signed" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="Traceability">
                            <field name="reference" readonly="state == 'posted'"/>
                            <field name="billing_model" readonly="state == 'posted'"/>
                            <field name="billing_id" readonly="state == 'posted'"/>
                            <field name="journal_id" readonly="state == 'posted'"/>
                            <field name="move_id" readonly="1"/>
                            <field name="origin_reserved_id" readonly="1"/>
                            <field name="reversal_of_id" readonly="1"/>
                            <field name="reversal_tx_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rule Context">
                        <field name="category_id" readonly="state == 'posted'"/>
                        <field name="product_id" readonly="state == 'posted'"/>
                        <field name="is_reserved" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Memo">
                            <field name="note" readonly="state == 'posted'" placeholder="Operational memo, external reference context, or correction rationale..."/>
                        </page>
                        <page string="Audit">
                            <group>
                                <field name="create_uid" readonly="1"/>
                                <field name="create_date" readonly="1"/>
                                <field name="write_uid" readonly="1"/>
                                <field name="write_date" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_wallet_transaction_pivot" model="ir.ui.view">
        <field name="name">clinic.wallet.transaction.pivot</field>
        <field name="model">clinic.wallet.transaction</field>
        <field name="arch" type="xml">
            <pivot string="Wallet Transaction Analysis">
                <field name="date" type="row" interval="month"/>
                <field name="transaction_type" type="col"/>
                <field name="company_id" type="row"/>
                <field name="amount_signed" type="measure"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_wallet_transaction_graph" model="ir.ui.view">
        <field name="name">clinic.wallet.transaction.graph</field>
        <field name="model">clinic.wallet.transaction</field>
        <field name="arch" type="xml">
            <graph string="Wallet Movement Trend" type="bar">
                <field name="date" interval="month"/>
                <field name="transaction_type"/>
                <field name="amount_signed" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_wallet_transactions" model="ir.actions.act_window">
        <field name="name">Wallet Transactions</field>
        <field name="res_model">clinic.wallet.transaction</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_wallet_transaction_search"/>
        <field name="context">{'search_default_filter_posted': 1}</field>
    </record>
</odoo>



